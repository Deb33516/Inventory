# Supabase project connection (safe for the browser — do not put secret/service-role keys here)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service-role key — SERVER-ONLY. Never prefix with PUBLIC_. Used exclusively
# by src/lib/supabase/admin.ts for Admin API calls (staff invitations).
# Never commit a real value; set locally and in Vercel project env vars.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
