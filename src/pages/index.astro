<script>
  const root = document.getElementById("landing-root");
  const THEME_KEY = "landing-theme";

  function applyTheme(theme: "light" | "dark") {
    if (!root) return;
    if (theme === "dark") {
      root.setAttribute("data-theme", "dark");
    } else {
      root.removeAttribute("data-theme");
    }
    document.getElementById("landing-theme-toggle")?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    document.getElementById("landing-theme-light")?.classList.toggle("is-active", theme === "light");
    document.getElementById("landing-theme-dark")?.classList.toggle("is-active", theme === "dark");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let stored: string | null = null;
  try {
    stored = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (stored === "dark") applyTheme("dark");

  document.getElementById("landing-theme-toggle")?.addEventListener("click", () => {
    applyTheme(root?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });
  document.getElementById("landing-theme-light")?.addEventListener("click", () => applyTheme("light"));
  document.getElementById("landing-theme-dark")?.addEventListener("click", () => applyTheme("dark"));

  const monthlyBtn = document.getElementById("landing-period-monthly");
  const yearlyBtn = document.getElementById("landing-period-yearly");

  function setPeriod(period: "monthly" | "yearly") {
    monthlyBtn?.classList.toggle("is-active", period === "monthly");
    yearlyBtn?.classList.toggle("is-active", period === "yearly");
    document.querySelectorAll<HTMLElement>(".landing-plan__unit").forEach((el) => {
      el.textContent = period === "yearly" ? el.dataset.unitYearly ?? "" : el.dataset.unitMonthly ?? "";
    });
  }

  monthlyBtn?.addEventListener("click", () => setPeriod("monthly"));
  yearlyBtn?.addEventListener("click", () => setPeriod("yearly"));

  const frameInner = document.querySelector<HTMLElement>(".landing-frame__inner");
  if (frameInner) {
    const updateFrameScale = () => {
      const scale = frameInner.clientWidth / 1440;
      frameInner.style.setProperty("--frame-scale", String(scale));
    };
    updateFrameScale();
    window.addEventListener("resize", updateFrameScale, { passive: true });
    if (typeof ResizeObserver !== "undefined") {
      new ResizeObserver(updateFrameScale).observe(frameInner);
    }
  }

  const menuToggle = document.getElementById("landing-menu-toggle");
  const mobileMenu = document.getElementById("landing-mobile-menu");

  function toggleMobileMenu(open?: boolean) {
    if (!menuToggle || !mobileMenu) return;
    const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
    const shouldOpen = open !== undefined ? open : !isExpanded;
    menuToggle.setAttribute("aria-expanded", shouldOpen ? "true" : "false");
    if (shouldOpen) {
      mobileMenu.removeAttribute("hidden");
    } else {
      mobileMenu.setAttribute("hidden", "");
    }
  }

  menuToggle?.addEventListener("click", () => toggleMobileMenu());

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => toggleMobileMenu(false));
  });

  document.addEventListener("click", (e) => {
    if (!mobileMenu || mobileMenu.hasAttribute("hidden")) return;
    const target = e.target as HTMLElement;
    if (!mobileMenu.contains(target) && !menuToggle?.contains(target)) {
      toggleMobileMenu(false);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      toggleMobileMenu(false);
    }
  });
</script>
