---
// Literal recreation of the Claude Design canvas's Landing artboard
// (project/Landing.dc.html / LandingDark.dc.html) — the supplied design is
// the visual source of truth for this screen, not the app's existing
// DESIGN.md component system. Structure, copy, spacing and the light/dark
// toggle are ported as closely as possible from that artboard.
//
// Real vs. simplified, disclosed:
//  - Nav "Log in" / "Sign Up", hero CTAs, role-card links, footer "Log in"
//    all point at real routes (/login, /register).
//  - The hero's "product frame" in the design is a live, scaled-down
//    render of the Admin dashboard artboard (Admin.dc.html) — that screen
//    hasn't been rebuilt under this same literal-recreation pass yet, so
//    a decorative wireframe placeholder (no numbers, no invented data)
//    stands in for it until Admin is redone; the frame chrome itself
//    (border, radius, shadow, size) matches the design exactly.
//  - Pricing section reproduced exactly as supplied, including the
//    design's own unfilled "₹[price]" placeholder — per your explicit
//    instruction to include it as-is rather than invent real numbers.
//  - FAQ accordion uses native <details>/<summary> (same open/closed
//    visual result as the design's JS-driven version, simpler and more
//    robust than reimplementing per-item React-style state by hand).
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroDashboardPreview from "../components/landing/HeroDashboardPreview.astro";

const user = Astro.locals.user;

const industries = [
  { label: "Electrical", icon: "M13 2 4 14h7l-1 8 9-12h-7z" },
  { label: "Hardware", icon: "M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z" },
  { label: "Building materials", icon: "M3 5h18v14H3zM3 12h18M9 5v7M15 12v7" },
  { label: "FMCG wholesale", icon: "M3 4h2l2.4 11h11l2-8H6.2M9 20a1 1 0 1 0 2 0a1 1 0 1 0-2 0M17 20a1 1 0 1 0 2 0a1 1 0 1 0-2 0" },
  { label: "Auto parts", icon: "M5 16h14M6 16l1.5-5h9L18 16M4 16v3h3v-3M17 16v3h3v-3" },
  { label: "Pharma distribution", icon: "M10.5 20.5a4.95 4.95 0 0 1-7-7l6-6a4.95 4.95 0 0 1 7 7zM7 10l7 7" },
];

const roles = [
  {
    name: "Super admin",
    icon: "M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6zM9 12l2 2 4-4",
    desc: "Owns users, roles and system settings.",
    points: ["Users and invites", "Roles and permissions", "Audit log"],
    href: user ? "/admin" : "/login",
  },
  {
    name: "Admin",
    icon: "M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z",
    desc: "Runs the business day to day.",
    points: ["Orders and customers", "Products and stock", "Support ticket queue"],
    href: user ? "/admin" : "/login",
  },
  {
    name: "Sales staff",
    icon: "M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0",
    desc: "Looks after their own customers.",
    points: ["Contacts and orders", "Live stock check", "Order reports"],
    href: user ? "/sales" : "/login",
  },
  {
    name: "Inventory staff",
    icon: "M3 7V3h4M17 3h4v4M21 17v4h-4M7 21H3v-4M7 12h10",
    desc: "Keeps stock accurate.",
    points: ["Receiving restocks", "Adjustments and damage", "Assigned support tickets"],
    href: user ? "/inventory" : "/login",
  },
  {
    name: "Customer",
    icon: "M8 8a4 4 0 1 0 8 0a4 4 0 1 0-8 0M4 21c1-4 4-6 8-6s7 2 8 6",
    desc: "Serves themselves, any time.",
    points: ["Shop and checkout", "Order tracking", "Support tickets"],
    href: user ? "/account" : "/login",
  },
];

const kanban = [
  {
    stage: "Pending",
    orders: [
      { co: "Meera Traders", amt: "₹31,800", stock: "Back 3 Oct", status: "out" },
      { co: "Galaxy Retail", amt: "₹1.86L", stock: "In stock", status: "ok" },
    ],
  },
  {
    stage: "Processing",
    orders: [
      { co: "BuildRight", amt: "₹1.48L", stock: "In stock", status: "ok" },
      { co: "Sharma Hardware", amt: "₹64,200", stock: "12 left", status: "low" },
    ],
  },
  {
    stage: "Shipped",
    orders: [
      { co: "Meera Traders", amt: "₹86,400", stock: "Due 30 Sep", status: "ok" },
      { co: "Patel Electricals", amt: "₹1.13L", stock: "Due 1 Oct", status: "ok" },
    ],
  },
  {
    stage: "Delivered",
    orders: [
      { co: "Aarav Homes", amt: "₹74,500", stock: "Delivered", status: "ok" },
      { co: "Nova Lights", amt: "₹1.6L", stock: "Delivered", status: "ok" },
    ],
  },
];

const benefits = [
  {
    icon: "M6 11h12v10H6zM8 11V7a4 4 0 0 1 8 0v4",
    title: "Five roles, clear access",
    desc: "Super admin, admin, sales staff, inventory staff and customers each see only what their job needs.",
  },
  {
    icon: "M12 3 2 8l10 5 10-5zM2 13l10 5 10-5",
    title: "Live stock in every order",
    desc: "Sales and customers see real availability before an order is placed.",
  },
  {
    icon: "M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM11 18h2",
    title: "Made for the warehouse floor",
    desc: "Large touch targets and scanner input for receiving, adjustments and lookups.",
  },
  {
    icon: "M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6",
    title: "Stock you can trust",
    desc: "Every receipt, sale, adjustment and damage record is logged as a stock movement.",
  },
  {
    icon: "M3 4h2l2.4 11h11l2-8H6.2M9 20a1 1 0 1 0 2 0a1 1 0 1 0-2 0M17 20a1 1 0 1 0 2 0a1 1 0 1 0-2 0",
    title: "Customer self-service",
    desc: "Customers shop, check out, track their orders and raise tickets on their own.",
  },
  {
    icon: "M4 4h16v12H8l-4 4z",
    title: "Support that closes the loop",
    desc: "Tickets move from customer to admin to inventory staff and back with a clear resolution.",
  },
];

const plans = [
  {
    name: "Starter",
    desc: "For a single shop or warehouse getting organised.",
    price: "₹[price]",
    unit: "per month",
    unitYearly: "per month, billed yearly",
    popular: false,
    cta: "Start free trial",
    href: user ? "/account" : "/register",
    features: ["Up to 5 users", "Customers and orders", "Products, categories and stock", "Customer shop and portal", "Support tickets", "Email support"],
  },
  {
    name: "Growth",
    desc: "For growing distributors with a sales team and a warehouse crew.",
    price: "₹[price]",
    unit: "per month",
    unitYearly: "per month, billed yearly",
    popular: true,
    cta: "Start free trial",
    href: user ? "/account" : "/register",
    features: ["Up to 25 users", "All five roles", "Receiving, adjustments and damage records", "Stock movements history", "Sales and inventory reports", "Priority support"],
  },
  {
    name: "Enterprise",
    desc: "For larger teams that need extra control and onboarding help.",
    price: "Custom",
    unit: "talk to us",
    unitYearly: "talk to us",
    popular: false,
    cta: "Contact sales",
    href: "#faq",
    features: ["Unlimited users", "Audit log", "Two-factor sign-in for staff", "Guided data setup", "Dedicated onboarding manager", "Uptime commitment"],
  },
];

const faqs = [
  ["Can each person see only their own data?", "Yes. Sales staff see their own contacts and orders, inventory staff see stock and the tickets assigned to them, and customers only ever see their own orders and tickets."],
  ["Can my customers place orders themselves?", "Customers get their own portal with your prices: they browse the shop, check out, track orders and raise support tickets."],
  ["How do support tickets reach the warehouse?", "A customer raises a ticket, an admin replies or assigns operational issues to inventory staff, and the resolution comes back to the customer in the same ticket."],
  ["Does it keep a history of stock changes?", "Every receipt, sale, adjustment and damage record is saved as a stock movement, so on-hand numbers can always be explained."],
  ["Does it work on phones and tablets?", "The whole app is responsive. Warehouse screens are designed for tablets and handheld scanners first."],
  ["Can we add more features later?", "Yes. The app is built to grow with you; start with the essentials and expand as your team needs more."],
];

const footerCols = [
  { title: "Product", links: ["Features", "Roles", "Pricing", "FAQ"] },
  { title: "Company", links: ["About", "Careers", "Contact"] },
  { title: "Resources", links: ["Help center", "Guides", "API docs"] },
  { title: "Legal", links: ["Privacy", "Terms", "Security"] },
];

const loginHref = user ? "/account" : "/login";
const signupHref = user ? "/account" : "/register";
---

<BaseLayout title="Inventory — Sell, stock and ship from one calm workspace">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  </Fragment>

  <div class="landing" id="landing-root">
    <!-- ================= NAV (floating) ================= -->
    <header class="landing-nav">
      <a href="/" class="landing-nav__brand">
        <span class="landing-nav__logo"><span></span></span>
        <span>Inventory</span>
      </a>
      <nav aria-label="Primary" class="landing-nav__links">
        <a href="#roles">Roles</a>
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="landing-nav__spacer"></div>
      <button type="button" id="landing-theme-toggle" class="landing-nav__theme" aria-label="Switch to dark mode">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
      </button>
      <a href={loginHref} class="landing-nav__login">{user ? "My account" : "Log in"}</a>
      <a href={signupHref} class="landing-nav__signup">
        <span>{user ? "Go to dashboard" : "Sign Up"}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <button type="button" id="landing-menu-toggle" class="landing-nav__burger" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="landing-mobile-menu">
        <svg class="icon-burger" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
        <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </header>

    <!-- ================= MOBILE MENU (floating dropdown) ================= -->
    <div id="landing-mobile-menu" class="landing-mobile-menu" hidden>
      <nav class="landing-mobile-menu__links">
        <a href="#roles" class="landing-mobile-link">Roles</a>
        <a href="#features" class="landing-mobile-link">Features</a>
        <a href="#pricing" class="landing-mobile-link">Pricing</a>
        <a href="#faq" class="landing-mobile-link">FAQ</a>
      </nav>
      <div class="landing-mobile-menu__actions">
        <a href={loginHref} class="landing-mobile-menu__btn btn-secondary">{user ? "My account" : "Log in"}</a>
        <a href={signupHref} class="landing-mobile-menu__btn btn-primary">
          <span>{user ? "Go to dashboard" : "Sign Up"}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>

    <!-- ================= HERO ================= -->
    <section class="landing-hero" id="top">
      <div class="landing-hero__inner">
        <a href="#roles" class="landing-badge">
          <span class="landing-badge__dot"></span>
          <span class="landing-badge__text">Role-based dashboards for every login</span>
          <span class="landing-badge__cta">See how <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
        </a>
        <h1 class="landing-hero__title">Sell, stock and ship from one calm workspace</h1>
        <p class="landing-hero__sub">
          Inventory brings your CRM, stock and customer portal together. Every login, from owner
          to warehouse floor, sees exactly the screens it needs.
        </p>
        <div class="landing-hero__ctas">
          <a href={signupHref} class="btn-primary">{user ? "Go to dashboard" : "Start free trial"}</a>
          <a href="#features" class="btn-secondary">See the product</a>
        </div>
      </div>

      <div class="landing-frame">
        <div class="landing-frame__inner">
          <div class="landing-frame__scaler">
            <HeroDashboardPreview />
          </div>
        </div>
      </div>
    </section>

    <!-- ================= BUILT FOR ================= -->
    <section aria-label="Built for" class="landing-industries">
      <span class="landing-industries__label">Built for businesses that move physical products</span>
      <div class="landing-industries__carousel">
        <div class="landing-industries__track">
          {
            [...industries, ...industries].map((i) => (
              <span class="landing-industry-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={i.icon} />
                </svg>
                {i.label}
              </span>
            ))
          }
        </div>
        <div class="landing-industries__track" aria-hidden="true">
          {
            [...industries, ...industries].map((i) => (
              <span class="landing-industry-item">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={i.icon} />
                </svg>
                {i.label}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= ROLES ================= -->
    <section id="roles" class="landing-section">
      <div class="landing-section__head">
        <span class="landing-eyebrow">One app, five logins</span>
        <h2>Everyone sees what they need. Nothing more.</h2>
        <p>
          Permissions decide the menu. Your warehouse team never wades through sales reports, and
          your customers only ever see their own orders.
        </p>
      </div>
      <div class="landing-roles">
        {
          roles.map((r) => (
            <div class="landing-role-card">
              <span class="landing-role-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={r.icon} />
                </svg>
              </span>
              <div class="landing-role-card__body">
                <span class="landing-role-card__name">{r.name}</span>
                <span class="landing-role-card__desc">{r.desc}</span>
              </div>
              <div class="landing-role-card__points">
                {r.points.map((p) => (
                  <span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 12 5 5 9-10"></path>
                    </svg>
                    {p}
                  </span>
                ))}
              </div>
              <a href={r.href} class="landing-role-card__link">Preview dashboard →</a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= FEATURES (bento) ================= -->
    <section id="features" class="landing-section">
      <div class="landing-section__head">
        <span class="landing-eyebrow">Features</span>
        <h2>Your CRM and your warehouse, finally on speaking terms</h2>
        <p>Orders see live stock. Stock sees open orders. Nobody promises what the shelf can't deliver.</p>
      </div>

      <div class="landing-bento">
        <div class="landing-bento__row landing-bento__row--top">
          <div class="bento-card bento-card--orders">
            <div class="bento-card__visual bento-card__visual--kanban">
              <div class="bento-kanban">
                {
                  kanban.map((c) => (
                    <div class="bento-kanban__col">
                      <span class="bento-kanban__stage">{c.stage}</span>
                      {c.orders.map((d) => (
                        <div class="bento-kanban__card">
                          <div class="bento-kanban__card-head">
                            <span>{d.co}</span>
                            <span>{d.amt}</span>
                          </div>
                          <span class={`bento-kanban__badge bento-kanban__badge--${d.status}`}>{d.stock}</span>
                        </div>
                      ))}
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="bento-card__text">
              <h3>Orders that know what's on the shelf</h3>
              <p>Every order line shows live availability, so sales can promise real delivery dates instead of guesses.</p>
            </div>
          </div>
          <div class="bento-card bento-card--reorder">
            <div class="bento-card__visual bento-card__visual--reorder">
              <svg width="300" height="200" viewBox="0 0 300 200" role="img" aria-label="Stock levels for six products, two below the reorder line">
                <path d="M10 92H290" class="bento-reorder-line" stroke-width="2" stroke-dasharray="6 6"></path>
                <text x="290" y="84" text-anchor="end" class="bento-reorder-label">Reorder level</text>
                <rect x="20" y="40" width="30" height="160" rx="6" class="bento-bar"></rect>
                <rect x="66" y="64" width="30" height="136" rx="6" class="bento-bar"></rect>
                <rect x="112" y="128" width="30" height="72" rx="6" class="bento-bar bento-bar--accent"></rect>
                <rect x="158" y="56" width="30" height="144" rx="6" class="bento-bar"></rect>
                <rect x="204" y="150" width="30" height="50" rx="6" class="bento-bar bento-bar--accent"></rect>
                <rect x="250" y="72" width="30" height="128" rx="6" class="bento-bar"></rect>
                <rect x="96" y="100" width="62" height="22" rx="6" class="bento-restock-badge"></rect>
                <text x="127" y="115" text-anchor="middle" class="bento-restock-text">Restock</text>
              </svg>
            </div>
            <div class="bento-card__text">
              <h3>Reorder before you run out</h3>
              <p>Low-stock alerts become restock requests for your inventory team.</p>
            </div>
          </div>
        </div>

        <div class="landing-bento__row landing-bento__row--bottom">
          <div class="bento-card bento-card--small">
            <div class="bento-card__visual bento-card__visual--pad">
              <div class="mock-scan-input">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V3h4M17 3h4v4M21 17v4h-4M7 21H3v-4M7 12h10"></path></svg>
                Scan barcode or type SKU
              </div>
              <div class="mock-scan-row"><span class="mock-scan-dot"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg></span><span>LED panel 12W × 4</span><span class="mock-scan-bin">A-03-2</span></div>
              <div class="mock-scan-row"><span class="mock-scan-dot"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg></span><span>Steel hinge 4" × 20</span><span class="mock-scan-bin">A-02-6</span></div>
              <div class="mock-scan-row"><span class="mock-scan-dot"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg></span><span>Cable tie 200mm × 2</span><span class="mock-scan-bin">C-01-1</span></div>
            </div>
            <div class="bento-card__text bento-card__text--small">
              <h3>Scan-first warehouse</h3>
              <p>Receive restocks, record damage and look up stock with a scanner.</p>
            </div>
          </div>
          <div class="bento-card bento-card--small">
            <div class="bento-card__visual bento-card__visual--center">
              <div class="mock-ticket">
                <div class="mock-ticket__head"><span>Ticket TK-1191</span><span class="mock-pill">In Progress</span></div>
                <span class="mock-ticket__sub">Damaged items · Meera Traders · assigned to inventory staff</span>
                <div class="mock-ticket__actions"><span>Reply</span><span>Assign</span></div>
              </div>
            </div>
            <div class="bento-card__text bento-card__text--small">
              <h3>Support that reaches the warehouse</h3>
              <p>Customers raise tickets; admins reply or hand operational issues to inventory staff.</p>
            </div>
          </div>
          <div class="bento-card bento-card--small">
            <div class="bento-card__visual bento-card__visual--pad bento-card__visual--column">
              <span class="mock-track-label">SO-10482 · arriving tomorrow</span>
              <div class="mock-track-line">
                <span class="on"></span><span class="line on"></span>
                <span class="on"></span><span class="line on"></span>
                <span class="on"></span><span class="line"></span>
                <span></span>
              </div>
              <div class="mock-track-steps"><span>Placed</span><span>Prepared</span><span>Shipped</span><span>Delivered</span></div>
            </div>
            <div class="bento-card__text bento-card__text--small">
              <h3>A portal customers actually use</h3>
              <p>Shop, check out, track orders and raise support tickets without calling your team.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= BENEFITS ================= -->
    <section aria-labelledby="landing-why" class="landing-section">
      <div class="landing-section__head">
        <span class="landing-eyebrow">Why teams switch</span>
        <h2 id="landing-why">Built for the way distributors really work</h2>
        <p>Roles, live stock and customer support work together, not as bolt-ons.</p>
      </div>
      <div class="landing-benefits">
        {
          benefits.map((b) => (
            <div class="landing-benefit">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={b.icon} />
              </svg>
              <span class="landing-benefit__title">{b.title}</span>
              <span class="landing-benefit__desc">{b.desc}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= PRICING ================= -->
    <section id="pricing" class="landing-section">
      <div class="landing-section__head">
        <span class="landing-eyebrow">Pricing</span>
        <h2>Simple plans that grow with your team</h2>
        <p>Start with a small team. Add users as you grow.</p>
      </div>
      <div class="landing-period" role="group" aria-label="Billing period">
        <button type="button" id="landing-period-monthly" class="is-active">Monthly</button>
        <button type="button" id="landing-period-yearly">Yearly <span class="landing-period__save">Save [x]%</span></button>
      </div>
      <div class="landing-plans">
        {
          plans.map((p) => (
            <div class={`landing-plan ${p.popular ? "landing-plan--popular" : ""}`}>
              {p.popular && <span class="landing-plan__badge">Most popular</span>}
              <div class="landing-plan__head">
                <span class="landing-plan__name">{p.name}</span>
                <span class="landing-plan__desc">{p.desc}</span>
              </div>
              <div class="landing-plan__price">
                <span class="landing-plan__amount">{p.price}</span>
                <span class="landing-plan__unit" data-unit-monthly={p.unit} data-unit-yearly={p.unitYearly}>
                  {p.unit}
                </span>
              </div>
              <div class="landing-plan__features">
                {p.features.map((f) => (
                  <span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 12 5 5 9-10"></path>
                    </svg>
                    {f}
                  </span>
                ))}
              </div>
              <a href={p.href} class={p.popular ? "btn-primary" : "btn-muted"}>
                {p.cta}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section id="faq" class="landing-faq">
      <div class="landing-faq__head">
        <span class="landing-eyebrow">FAQ</span>
        <h2>Questions, answered</h2>
        <p>Can't find what you're looking for? Our team will walk you through a setup that matches your business.</p>
        <a href="#cta" class="btn-outline">Talk to us</a>
      </div>
      <div class="landing-faq__list">
        {
          faqs.map(([q, a]) => (
            <details class="landing-faq__item">
              <summary>
                {q}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- ================= FINAL CTA ================= -->
    <section id="cta" class="landing-cta-wrap">
      <div class="landing-cta">
        <h2>Run the whole business from one place</h2>
        <p>Add your products, invite your team and see every role's dashboard with your own data.</p>
        <div class="landing-cta__actions">
          <a href={signupHref} class="btn-primary">{user ? "Go to dashboard" : "Start free trial"}</a>
          <a href={loginHref} class="btn-secondary">{user ? "My account" : "Log in"}</a>
        </div>
      </div>
    </section>

    <!-- ================= FOOTER ================= -->
    <footer class="landing-footer">
      <div class="landing-footer__cols">
        <div class="landing-footer__brand">
          <div class="landing-nav__brand">
            <span class="landing-nav__logo"><span></span></span>
            <span>Inventory</span>
          </div>
          <p>CRM, inventory and a customer portal for businesses that sell physical products.</p>
          <div class="landing-period landing-period--sm" role="group" aria-label="Theme">
            <button type="button" id="landing-theme-light" class="is-active">Light</button>
            <button type="button" id="landing-theme-dark">Dark</button>
          </div>
        </div>
        {
          footerCols.map((c) => (
            <div class="landing-footer__col">
              <span>{c.title}</span>
              {c.links.map((l) => (
                <a href="#top">{l}</a>
              ))}
            </div>
          ))
        }
      </div>
      <div class="landing-footer__bottom">
        <span>© 2026 Inventory. All rights reserved.</span>
        <span>Made in India · ₹ INR</span>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .landing {
    --shell: #fafafa;
    --panel: #ffffff;
    --card: #ffffff;
    --fg: #0a0a0a;
    --fg2: #404040;
    --muted: #f5f5f5;
    --muted-fg: #737373;
    --border: #e5e5e5;
    --input: #e5e5e5;
    --grid: #f3f3f3;
    --primary: #171717;
    --primary-fg: #fafafa;
    --success-bg: #ecfdf3;
    --success-fg: #15803d;
    --warn-bg: #fef3e2;
    --warn-fg: #9a3412;
    --danger-bg: #feecec;
    --danger-fg: #b91c1c;
    --info-bg: #eef2ff;
    --info-fg: #3538cd;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    --accent: #2b50e0;
    --accent-soft: rgba(43, 80, 224, 0.1);
    --chart2: #d9731f;
    color-scheme: light;

    background: var(--shell);
    color: var(--fg);
    font-family: "Geist", system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
  }

  .landing[data-theme="dark"] {
    --shell: #0a0a0a;
    --panel: #0f0f0f;
    --card: #171717;
    --fg: #fafafa;
    --fg2: #d4d4d4;
    --muted: #262626;
    --muted-fg: #a3a3a3;
    --border: #262626;
    --input: #363636;
    --grid: #1c1c1c;
    --primary: #fafafa;
    --primary-fg: #171717;
    --success-bg: #0f2a1c;
    --success-fg: #4ade80;
    --warn-bg: #2e1f0e;
    --warn-fg: #fdba74;
    --danger-bg: #2d1414;
    --danger-fg: #f87171;
    --info-bg: #1e2240;
    --info-fg: #a5b4fc;
    --shadow: none;
    --accent: #6b8afb;
    --accent-soft: rgba(107, 138, 251, 0.16);
    --chart2: #e8894a;
    color-scheme: dark;
  }

  .landing[data-theme="dark"] .icon-sun,
  .landing:not([data-theme="dark"]) .icon-moon {
    display: none;
  }

  /* ---------- nav ---------- */
  .landing-nav {
    position: sticky;
    top: 16px;
    z-index: 20;
    margin: 0 auto;
    max-width: 1120px;
    box-sizing: border-box;
    padding: 0 10px 0 16px;
    height: 60px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .landing-nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--fg);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.01em;
  }
  .landing-nav__logo {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .landing-nav__logo span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #fff;
  }
  .landing-nav__links {
    display: flex;
    gap: 4px;
  }
  .landing-nav__links a {
    height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    font-size: 14px;
    text-decoration: none;
    color: var(--fg2);
  }
  .landing-nav__links a:hover {
    background: var(--muted);
  }
  .landing-nav__spacer {
    flex-grow: 1;
  }
  .landing-nav__theme {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--input);
    background: var(--card);
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .landing-nav__login {
    height: 38px;
    padding: 0 14px;
    border-radius: 9px;
    background: var(--muted);
    color: var(--fg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .landing-nav__signup {
    height: 38px;
    padding: 0 14px;
    border-radius: 9px;
    background: var(--primary);
    color: var(--primary-fg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  /* Burger toggle button */
  .landing-nav__burger {
    display: none;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--input);
    background: var(--card);
    color: var(--fg);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .landing-nav__burger .icon-close {
    display: none;
  }
  .landing-nav__burger[aria-expanded="true"] .icon-burger {
    display: none;
  }
  .landing-nav__burger[aria-expanded="true"] .icon-close {
    display: block;
  }

  /* Mobile menu dropdown */
  .landing-mobile-menu {
    display: none;
    position: fixed;
    top: 84px;
    left: 16px;
    right: 16px;
    z-index: 30;
    max-width: 440px;
    margin: 0 auto;
    padding: 16px;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: var(--card);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.16);
    flex-direction: column;
    gap: 16px;
    animation: menu-slide-down 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes menu-slide-down {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
  .landing-mobile-menu:not([hidden]) {
    display: flex;
  }
  .landing-mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .landing-mobile-link {
    height: 42px;
    padding: 0 14px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    color: var(--fg);
    transition: background-color 0.15s ease;
  }
  .landing-mobile-link:hover,
  .landing-mobile-link:active {
    background: var(--muted);
  }
  .landing-mobile-menu__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .landing-mobile-menu__btn {
    width: 100%;
    height: 44px;
  }

  @media (max-width: 768px) {
    .landing-nav__links,
    .landing-nav__login,
    .landing-nav__signup {
      display: none;
    }
    .landing-nav__burger {
      display: flex;
    }
    .landing-nav {
      max-width: calc(100% - 32px);
      margin: 0 16px;
    }
  }

  /* ---------- hero ---------- */
  .landing-hero {
    box-sizing: border-box;
    padding: 64px 24px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
  }
  .landing-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 20px;
    background: var(--panel);
    border-radius: 24px;
    max-width: 100%;
    box-sizing: border-box;
  }
  .landing-badge {
    height: 32px;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 0 5px 0 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    text-decoration: none;
    color: var(--fg2);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .landing-badge:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }
  .landing-badge__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }
  .landing-badge__text {
    flex: 0 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .landing-badge__cta {
    height: 24px;
    padding: 0 10px;
    border-radius: 999px;
    background: var(--muted);
    color: var(--fg);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .landing-hero {
      padding: 32px 12px 0;
    }
    .landing-hero__inner {
      padding: 0 8px;
      width: 100%;
    }
    .landing-badge {
      height: 30px;
      padding: 0 4px 0 8px;
      gap: 6px;
      font-size: 12px;
    }
    .landing-badge__cta {
      height: 22px;
      padding: 0 8px;
      font-size: 11px;
    }
  }
  @media (max-width: 380px) {
    .landing-badge {
      font-size: 11px;
      padding: 0 3px 0 6px;
      gap: 5px;
    }
    .landing-badge__cta {
      height: 20px;
      padding: 0 6px;
      font-size: 10px;
    }
    .landing-badge__dot {
      width: 6px;
      height: 6px;
    }
  }
  .landing-hero__title {
    margin: 28px 0 0;
    max-width: 980px;
    text-align: center;
    font-size: clamp(38px, 7vw, 76px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.045em;
  }
  .landing-hero__sub {
    margin: 24px 0 0;
    max-width: 640px;
    text-align: center;
    font-size: 19px;
    line-height: 1.55;
    color: var(--muted-fg);
  }
  .landing-hero__ctas {
    margin-top: 36px;
    margin-bottom: 40px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .btn-primary,
  .btn-secondary,
  .btn-muted,
  .btn-outline {
    height: 46px;
    padding: 0 22px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, opacity 0.2s ease;
  }
  .btn-primary {
    background: var(--primary);
    color: var(--primary-fg);
    border: 0;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  }
  .btn-secondary,
  .btn-outline {
    border: 1px solid var(--input);
    background: var(--card);
    color: var(--fg);
  }
  .btn-secondary:hover,
  .btn-outline:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
  }
  .btn-primary:active,
  .btn-secondary:active,
  .btn-outline:active {
    transform: translateY(0);
  }
  .btn-muted {
    background: var(--muted);
    color: var(--fg);
    border: 0;
  }

  .landing-frame {
    width: 100%;
    max-width: 1032px;
    box-sizing: border-box;
    padding: 12px;
    border-radius: 22px;
    border: 1px solid var(--border);
    background: var(--muted);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.12);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
    animation: hero-frame-appear 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    will-change: transform;
  }
  .landing-frame:hover {
    transform: translateY(-6px) scale(1.008);
    box-shadow: 0 42px 100px rgba(0, 0, 0, 0.18);
  }
  @keyframes hero-frame-appear {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .landing-frame__inner {
    width: 100%;
    aspect-ratio: 1440 / 1000;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--panel);
    position: relative;
  }
  .landing-frame__scaler {
    width: 1440px;
    height: 1000px;
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: top left;
    transform: scale(var(--frame-scale, 0.7));
    transition: transform 0.1s ease-out;
  }
  @media (min-width: 1032px) {
    .landing-frame__scaler {
      transform: scale(var(--frame-scale, 0.7));
    }
  }

  /* ---------- industries (infinite carousel) ---------- */
  .landing-industries {
    padding: 48px 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
  }
  .landing-industries__label {
    font-size: 15px;
    color: var(--muted-fg);
    text-align: center;
    padding: 0 24px;
  }
  .landing-industries__carousel {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 48px;
    width: 100%;
    max-width: 100%;
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }
  .landing-industries__track {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 48px;
    animation: scroll-industries 35s linear infinite;
    will-change: transform;
  }
  .landing-industries__carousel:hover .landing-industries__track {
    animation-play-state: paused;
  }
  .landing-industry-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg2);
    white-space: nowrap;
    transition: color 0.2s ease, transform 0.2s ease;
    cursor: default;
  }
  .landing-industry-item:hover {
    color: var(--fg);
    transform: scale(1.04);
  }
  .landing-industry-item svg {
    flex-shrink: 0;
  }
  @keyframes scroll-industries {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - 48px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .landing-industries__track {
      animation: none;
    }
  }

  /* ---------- shared section head ---------- */
  .landing-section {
    box-sizing: border-box;
    padding: 72px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    max-width: 1440px;
    margin: 0 auto;
  }
  .landing-section__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    max-width: 700px;
  }
  .landing-eyebrow {
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13px;
    font-weight: 500;
    display: flex;
    align-items: center;
  }
  .landing-section__head h2 {
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .landing-section__head p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted-fg);
  }

  /* ---------- roles ---------- */
  .landing-roles {
    width: 100%;
    max-width: 1120px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }
  .landing-role-card {
    flex: 1 1 200px;
    min-width: 200px;
    max-width: 100%;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--card);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  @media (max-width: 640px) {
    .landing-role-card {
      flex: 1 1 100%;
      min-width: 0;
    }
  }
