---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Button from "../../components/ui/Button.astro";
import CartSummary from "../../components/cart/CartSummary.astro";
import PublicHeader from "../../components/layout/PublicHeader.astro";
---

<BaseLayout title="Cart — Inventory">
  <PublicHeader />

  <main id="main-content" class="max-w-[720px] mx-auto px-lg py-xl">
    <h1 class="text-2xl font-bold text-ink">Your cart</h1>

    <Card class="mt-lg">
      <CartSummary />
    </Card>

    <div class="mt-lg flex items-center justify-between gap-md">
      <a href="/products" class="text-sm font-bold text-ink hover:text-primary">
        ← Continue shopping
      </a>
      <Button href="/checkout" variant="primary">Checkout</Button>
    </div>
  </main>
</BaseLayout>
