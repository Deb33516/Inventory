---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthSplitLayout from "../components/auth/AuthSplitLayout.astro";
import Input from "../components/ui/Input.astro";
import Button from "../components/ui/Button.astro";

if (Astro.locals.user) {
  return Astro.redirect("/account");
}
---

<BaseLayout title="Create an account — Inventory">
  <AuthSplitLayout formTitle="Create your account">
    <p class="text-sm font-light text-body">
      Order online, track deliveries and get support in one place.
    </p>

    <form id="register-form" class="mt-lg space-y-md">
      <Input label="Full name" name="fullName" autocomplete="name" required />
      <Input label="Email" name="email" type="email" autocomplete="email" required />
      <Input
        label="Password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength={8}
        required
      />
      <p id="form-message" class="text-sm" role="status"></p>
      <Button type="submit" variant="primary" class="w-full">Create account</Button>
    </form>

    <p class="mt-lg text-sm text-body">
      Already have an account? <a href="/login" class="text-primary font-bold">Sign in</a>
    </p>

    <div class="mt-lg p-md rounded-md bg-surface-soft text-xs text-muted leading-relaxed">
      Joining as staff? Staff accounts are created by your admin — ask them for an invite.
    </div>
  </AuthSplitLayout>
</BaseLayout>

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#register-form")!;
  const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    button.disabled = true;
    messageEl.textContent = "";
    messageEl.classList.remove("text-error", "text-success");

    const { data, error } = await actions.signUp(new FormData(form));

    button.disabled = false;

    if (error) {
      messageEl.textContent = error.message;
      messageEl.classList.add("text-error");
      return;
    }

    form.reset();
    messageEl.textContent = data.message;
    messageEl.classList.add("text-success");
  });
</script>
