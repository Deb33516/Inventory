---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import SupplierForm from "../../../components/inventory/SupplierForm.astro";
import EmptyState from "../../../components/catalog/EmptyState.astro";

const { id } = Astro.params;

const { data: supplier } = await Astro.locals.supabase
  .from("suppliers")
  .select("id, name, contact_name, email, phone, address, is_active")
  .eq("id", id)
  .maybeSingle();

if (!supplier) {
  Astro.response.status = 404;
}
---

<BaseLayout title={supplier ? `Edit ${supplier.name} — Inventory` : "Supplier not found — Inventory"}>
  <header class="h-16 flex items-center justify-between px-lg border-b border-hairline bg-canvas">
    <a href="/inventory/suppliers" class="font-bold text-ink">
      ← Suppliers
    </a>
  </header>

  <main class="max-w-[1440px] mx-auto px-lg py-xl">
    {
      supplier ? (
        <Card class="max-w-lg">
          <h1 class="text-2xl font-bold text-ink">Edit supplier</h1>
          <div class="mt-lg">
            <SupplierForm action="updateSupplier" supplier={supplier} />
          </div>
        </Card>
      ) : (
        <EmptyState title="Supplier not found" />
      )
    }
  </main>
</BaseLayout>
