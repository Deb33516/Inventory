---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import Badge from "../../../components/ui/Badge.astro";
import SupplierForm from "../../../components/inventory/SupplierForm.astro";
import EmptyState from "../../../components/catalog/EmptyState.astro";
import AppShell from "../../../components/layout/AppShell.astro";

const created = Astro.url.searchParams.get("created");
const updated = Astro.url.searchParams.get("updated");

const { data: suppliers } = await Astro.locals.supabase
  .from("suppliers")
  .select("id, name, contact_name, email, phone, is_active")
  .order("name");
---

<BaseLayout title="Suppliers — Inventory">
  <AppShell active="inventory">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-xl">
    <div>
      <h1 class="text-2xl font-bold text-ink">Suppliers</h1>

      {created && (
        <p class="mt-md text-sm text-success" role="status">
          Supplier created.
        </p>
      )}
      {updated && (
        <p class="mt-md text-sm text-success" role="status">
          Supplier updated.
        </p>
      )}

      {
        suppliers && suppliers.length > 0 ? (
          <div class="mt-lg overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-hairline text-left text-muted uppercase text-xs tracking-[0.5px]">
                  <th class="py-xs pr-md">Name</th>
                  <th class="py-xs pr-md">Contact</th>
                  <th class="py-xs pr-md">Status</th>
                  <th class="py-xs" />
                </tr>
              </thead>
              <tbody>
                {suppliers.map((s) => (
                  <tr class="border-b border-hairline">
                    <td class="py-sm pr-md text-ink font-bold">{s.name}</td>
                    <td class="py-sm pr-md text-body">{s.contact_name ?? s.email ?? s.phone ?? "—"}</td>
                    <td class="py-sm pr-md">
                      <Badge tone={s.is_active ? "success" : "neutral"}>
                        {s.is_active ? "Active" : "Inactive"}
                      </Badge>
                    </td>
                    <td class="py-sm">
                      <a href={`/inventory/suppliers/${s.id}`} class="text-primary font-bold">
                        Edit
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <EmptyState class="mt-lg" title="No suppliers yet" />
        )
      }
    </div>

    <Card class="h-fit">
      <h2 class="text-lg font-bold text-ink">New supplier</h2>
      <div class="mt-md">
        <SupplierForm action="createSupplier" />
      </div>
    </Card>
  </div>
  </AppShell>
</BaseLayout>
