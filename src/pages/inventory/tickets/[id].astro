<script>
  import { actions } from "astro:actions";

  // --- Report an issue toggle ---
  const reportToggle = document.getElementById("tk-report-toggle");
  const reportPanel = document.getElementById("tk-report-panel") as HTMLElement;
  const reportCancel = document.getElementById("tk-report-cancel");
  reportToggle?.addEventListener("click", () => {
    reportPanel.hidden = !reportPanel.hidden;
  });
  reportCancel?.addEventListener("click", () => {
    reportPanel.hidden = true;
  });

  const reportForm = document.querySelector<HTMLFormElement>("#tk-report-form");
  if (reportForm) {
    const messageEl = document.querySelector<HTMLParagraphElement>("#tk-report-message")!;
    const button = reportForm.querySelector<HTMLButtonElement>("button[type=submit]")!;
    reportForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      messageEl.textContent = "";
      const { error } = await actions.createSupportTicket(new FormData(reportForm));
      if (error) {
        button.disabled = false;
        messageEl.textContent = error.message;
        return;
      }
      window.location.href = "/inventory/tickets?reported=1";
    });
  }

  // --- Ticket update form ---
  const updateForm = document.querySelector<HTMLFormElement>("#tk-update-form");
  if (updateForm) {
    const messageEl = document.querySelector<HTMLParagraphElement>("#tk-form-message")!;
    const button = updateForm.querySelector<HTMLButtonElement>("button[type=submit]")!;
    updateForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      messageEl.textContent = "";
      const { error } = await actions.updateSupportTicket(new FormData(updateForm));
      if (error) {
        button.disabled = false;
        messageEl.textContent = error.message;
        return;
      }
      const url = new URL(window.location.href);
      url.searchParams.set("updated", "1");
      window.location.href = url.toString();
    });
  }

  // --- Real client-side subject search over the currently rendered list ---
  const searchInput = document.querySelector<HTMLInputElement>("#tk-search");
  const listScroll = document.getElementById("tk-list-scroll");
  searchInput?.addEventListener("input", () => {
    const needle = searchInput.value.trim().toLowerCase();
    const rows = listScroll?.querySelectorAll<HTMLAnchorElement>(".tk__list-row") ?? [];
    rows.forEach((row) => {
      const subject = row.dataset.subject ?? "";
      row.style.display = !needle || subject.includes(needle) ? "" : "none";
    });
  });

  // --- Theme + sidebar chrome (same pattern as every other Sales/staff screen) ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is wired up
  // centrally in NavSidebar.astro — see that file's header comment.
</script>
