---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import ProductForm from "../../../components/catalog/ProductForm.astro";
import AppShell from "../../../components/layout/AppShell.astro";

const { data: categories } = await Astro.locals.supabase
  .from("categories")
  .select("id, name")
  .order("name");

const categoryOptions = (categories ?? []).map((c) => ({ value: c.id, label: c.name }));
---

<BaseLayout title="New product — Inventory">
  <AppShell active="inventory" backHref="/inventory/products" backLabel="Products">
    <Card class="max-w-lg">
      <h1 class="text-2xl font-bold text-ink">New product</h1>
      <div class="mt-lg">
        <ProductForm action="createProduct" categories={categoryOptions} />
      </div>
    </Card>
  </AppShell>
</BaseLayout>
