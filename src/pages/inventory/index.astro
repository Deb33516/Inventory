---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import EmptyState from "../../components/catalog/EmptyState.astro";
import KpiCard from "../../components/dashboard/KpiCard.astro";
import ChartCanvas from "../../components/dashboard/ChartCanvas.astro";
import DateRangeFilter from "../../components/dashboard/DateRangeFilter.astro";
import { resolveDashboardRange } from "../../lib/dashboardRange";

const url = Astro.url;
const range = resolveDashboardRange(url.searchParams.get("range"));

const { count: totalActive } = await Astro.locals.supabase
  .from("products")
  .select("id", { count: "exact", head: true })
  .eq("is_active", true);

const { data: inventoryRows } = await Astro.locals.supabase
  .from("inventory")
  .select("quantity_on_hand, reorder_level, products!inner(is_active)")
  .eq("products.is_active", true);

const rows = inventoryRows ?? [];
const lowStockCount = rows.filter(
  (r) => r.quantity_on_hand > 0 && r.quantity_on_hand <= r.reorder_level
).length;
const outOfStockCount = rows.filter((r) => r.quantity_on_hand <= 0).length;

const [{ data: inventoryValueRow }, { data: movementSummary }, { data: topProducts }] = await Promise.all([
  Astro.locals.supabase.from("inventory_value_summary").select("inventory_value").maybeSingle(),
  Astro.locals.supabase.rpc("dashboard_inventory_movement_summary", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.rpc("dashboard_top_products", { p_from: range.from, p_to: range.to, p_limit: 5 }),
]);

const inventoryValue = Number(inventoryValueRow?.inventory_value ?? 0);
const movementRows = movementSummary ?? [];
const productRows = topProducts ?? [];

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(value);

const movementColors: Record<string, string> = {
  restock: "#22c55e",
  sale: "#1c69d4",
  adjustment: "#6b6b6b",
  damaged: "#dc2626",
  return: "#f59e0b",
};
---

<BaseLayout title="Inventory dashboard">
  <header class="h-16 flex items-center justify-between px-lg border-b border-hairline bg-canvas">
    <span class="font-bold text-ink">Inventory</span>
    <nav class="flex items-center gap-lg text-sm text-ink">
      <a href="/inventory/stock" class="hover:text-primary">Stock</a>
      <a href="/inventory/movements" class="hover:text-primary">Movements</a>
      <a href="/inventory/suppliers" class="hover:text-primary">Suppliers</a>
      <a href="/inventory/products" class="hover:text-primary">Products</a>
      <a href="/inventory/categories" class="hover:text-primary">Categories</a>
    </nav>
  </header>

  <main class="max-w-[1440px] mx-auto px-lg py-xl">
    <h1 class="text-2xl font-bold text-ink">Dashboard</h1>

    <div class="mt-lg grid grid-cols-1 md:grid-cols-4 gap-lg">
      <Card>
        <p class="text-xs uppercase tracking-[0.5px] text-muted">Active products</p>
        <p class="mt-xs text-3xl font-bold text-ink">{totalActive ?? 0}</p>
      </Card>
      <a href="/inventory/stock?status=low" class="block">
        <Card class="hover:border-ink transition-colors">
          <p class="text-xs uppercase tracking-[0.5px] text-muted">Low stock</p>
          <p class="mt-xs text-3xl font-bold text-warning">{lowStockCount}</p>
        </Card>
      </a>
      <a href="/inventory/stock?status=out" class="block">
        <Card class="hover:border-ink transition-colors">
          <p class="text-xs uppercase tracking-[0.5px] text-muted">Out of stock</p>
          <p class="mt-xs text-3xl font-bold text-error">{outOfStockCount}</p>
        </Card>
      </a>
      <Card>
        <p class="text-xs uppercase tracking-[0.5px] text-muted">Inventory value</p>
        <p class="mt-xs text-3xl font-bold text-ink">{formatCurrency(inventoryValue)}</p>
        <p class="mt-xs text-xs text-muted">at retail price · current</p>
      </Card>
    </div>

    <div class="mt-xl flex items-center justify-between flex-wrap gap-md">
      <h2 class="text-lg font-bold text-ink">Movement analytics</h2>
      <DateRangeFilter current={range.preset} url={url} pathname="/inventory" />
    </div>
    <p class="mt-xs text-xs text-muted">{range.label}</p>

    <div class="mt-md grid grid-cols-1 lg:grid-cols-2 gap-lg">
      <div>
        <h3 class="font-bold text-ink">Movements by type</h3>
        <div class="mt-sm">
          {
            movementRows.length > 0 ? (
              <ChartCanvas
                id="inventory-movements"
                type="bar"
                data={{
                  labels: movementRows.map((r) => r.movement_type),
                  datasets: [
                    {
                      label: "Units",
                      data: movementRows.map((r) => Number(r.total_quantity)),
                      backgroundColor: movementRows.map((r) => movementColors[r.movement_type] ?? "#6b6b6b"),
                    },
                  ],
                }}
                options={{ plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No inventory movements in this range" />
            )
          }
        </div>
      </div>

      <div>
        <h3 class="font-bold text-ink">Top moving products (units)</h3>
        <div class="mt-sm">
          {
            productRows.length > 0 ? (
              <ChartCanvas
                id="inventory-top-products"
                type="bar"
                data={{
                  labels: productRows.map((r) => r.name),
                  datasets: [
                    {
                      label: "Units sold",
                      data: productRows.map((r) => Number(r.units_sold)),
                      backgroundColor: "#1c69d4",
                    },
                  ],
                }}
                options={{ indexAxis: "y", plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No product sales in this range" />
            )
          }
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
