---
// Warehouse tasks dashboard for Inventory Staff
// Recreated from Staff.dc.html & StaffDark.dc.html (Staff warehouse tasks)
// Uses the shared --sd-* token shell, NavSidebar (role="inventory"), and NavTop
// with full Light and Dark mode theme support.
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavSidebar from "../../components/staff/NavSidebar.astro";
import NavTop from "../../components/staff/NavTop.astro";
import { resolveDashboardRange } from "../../lib/dashboardRange";

const userId = Astro.locals.user?.id;

// --- Real: low stock products ---
const { data: inventoryRows } = await Astro.locals.supabase
  .from("inventory")
  .select("product_id, quantity_on_hand, reorder_level, products!inner(sku, name, is_active)")
  .eq("products.is_active", true);

const rows = inventoryRows ?? [];
const lowStockCount = rows.filter((r) => r.quantity_on_hand > 0 && r.quantity_on_hand <= r.reorder_level).length;

// --- Real: my open support tickets ---
const { data: myTickets } = await Astro.locals.supabase
  .from("support_tickets")
  .select("id, subject, status, created_at")
  .eq("assigned_to", userId ?? "");
const openTickets = (myTickets ?? []).filter((t) => !["resolved", "closed"].includes(t.status));
const openTicketCount = openTickets.length;

// --- Task Queue Data ---
const queue = Astro.url.searchParams.get("queue") ?? "all";

function buildQueueUrl(next: string) {
  const params = new URLSearchParams(Astro.url.search);
  if (next === "all") params.delete("queue");
  else params.set("queue", next);
  const qs = params.toString();
  return qs ? `/inventory?${qs}` : "/inventory";
}

interface TaskRow {
  type: "restock" | "ticket";
  pillLabel: string;
  pillClass: string;
  reference: string;
  details: string;
  units: string;
  location: string;
  due: string;
  isUrgent?: boolean;
  startHref: string;
}

function productOf(row: { products: unknown }): { sku: string; name: string } {
  return row.products as unknown as { sku: string; name: string };
}

const restockRows: TaskRow[] = [...rows]
  .filter((r) => r.quantity_on_hand > 0 && r.quantity_on_hand <= r.reorder_level)
  .sort((a, b) => a.quantity_on_hand - b.quantity_on_hand)
  .map((r) => {
    const product = productOf(r);
    return {
      type: "restock",
      pillLabel: "Restock",
      pillClass: "st-pill--info",
      reference: product.sku,
      details: `${product.name} · ${r.quantity_on_hand} on hand · reorder at ${r.reorder_level}`,
      units: String(r.quantity_on_hand),
      location: "—",
      due: "—",
      isUrgent: r.quantity_on_hand <= Math.ceil(r.reorder_level / 2),
      startHref: "/inventory/receiving",
    };
  });

const ticketRows: TaskRow[] = [...openTickets]
  .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())
  .map((t) => ({
    type: "ticket",
    pillLabel: "Ticket",
    pillClass: "st-pill--muted",
    reference: "—",
    details: t.subject,
    units: "—",
    location: "—",
    due: "—",
    isUrgent: false,
    startHref: `/inventory/tickets/${t.id}`,
  }));

const queueCounts = {
  all: restockRows.length + ticketRows.length,
  receive: 0,
  restock: restockRows.length,
  damage: 0,
  adjust: 0,
  tickets: ticketRows.length,
};

const QUEUE_FILTERS: { value: keyof typeof queueCounts; label: string }[] = [
  { value: "all", label: `All ${queueCounts.all}` },
  { value: "receive", label: `Receive ${queueCounts.receive}` },
  { value: "restock", label: `Restock ${queueCounts.restock}` },
  { value: "damage", label: `Damage ${queueCounts.damage}` },
  { value: "adjust", label: `Adjust ${queueCounts.adjust}` },
  { value: "tickets", label: `Tickets ${queueCounts.tickets}` },
];

const visibleTaskRows: TaskRow[] =
  queue === "restock" ? restockRows : queue === "tickets" ? ticketRows : queue === "all" ? [...restockRows, ...ticketRows] : [];

const EMPTY_QUEUE_MESSAGE: Record<string, string> = {
  all: "No pending tasks in your queue today.",
  receive: "Incoming-shipment tracking isn't supported in this system yet.",
  restock: "No products are currently low on stock.",
  damage: "Damage-to-record tracking isn't supported in this system yet.",
  adjust: "Pending-adjustment tracking isn't supported in this system yet.",
  tickets: "No open tickets assigned to you.",
};

// --- Real: Stock Movements for the Last 7 Days ---
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const DAY_MS = 24 * 60 * 60 * 1000;
function istDayKey(iso: string) {
  return new Date(new Date(iso).getTime() + IST_OFFSET_MS).toISOString().slice(0, 10);
}

const range = resolveDashboardRange("7d");
const { data: movementRows } = await Astro.locals.supabase
  .from("inventory_movements")
  .select("id, quantity_delta, movement_type, created_at, products(name, sku)")
  .gte("created_at", range.from!)
  .lt("created_at", range.to!)
  .order("created_at", { ascending: false });

const days = Array.from({ length: 7 }, (_, i) => {
  const t = new Date(new Date(range.from!).getTime() + i * DAY_MS);
  return {
    key: istDayKey(t.toISOString()),
    label: new Intl.DateTimeFormat("en-US", { weekday: "short", timeZone: "Asia/Kolkata" }).format(t),
  };
});

const inByDay = new Map(days.map((d) => [d.key, 0]));
const outByDay = new Map(days.map((d) => [d.key, 0]));
for (const m of movementRows ?? []) {
  const key = istDayKey(m.created_at);
  if (m.quantity_delta > 0) inByDay.set(key, (inByDay.get(key) ?? 0) + m.quantity_delta);
  else if (m.quantity_delta < 0) outByDay.set(key, (outByDay.get(key) ?? 0) + Math.abs(m.quantity_delta));
}
const totalIn = [...inByDay.values()].reduce((a, b) => a + b, 0);
const totalOut = [...outByDay.values()].reduce((a, b) => a + b, 0);

// Calculate max chart scale
const maxVal = Math.max(10, ...days.map((d) => Math.max(inByDay.get(d.key) ?? 0, outByDay.get(d.key) ?? 0)));
const chartMax = Math.ceil(maxVal / 20) * 20 || 100;
const chartMid = Math.round(chartMax / 2);

// Recent activity / scans
const recentMovements = (movementRows ?? []).slice(0, 3).map((m) => {
  const prod = (m.products as unknown as { name?: string; sku?: string }) ?? {};
  return {
    name: prod.name ?? "Item movement",
    bin: prod.sku ?? "Stock",
    qty: m.quantity_delta > 0 ? `+${m.quantity_delta} in stock` : `${m.quantity_delta} removed`,
  };
});
---

<BaseLayout title="Warehouse tasks — Inventory">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  </Fragment>

  <div class="sd" id="sd-root">
    <div id="sd-sidebar-backdrop" class="sd__backdrop"></div>

    <div id="sd-sidebar" class="sd__sidebar">
      <NavSidebar active="Warehouse tasks" role="inventory" ticketBadgeCount={openTicketCount} />
    </div>

    <div class="sd__panel">
      <NavTop
        section="Dashboard"
        page="Warehouse tasks"
        searchAction="/inventory/products"
        searchPlaceholder="Find product, SKU or bin…"
      />

      <main id="main-content" class="st__main">
        <div class="st__header">
          <div class="st__header-text">
            <h1>Warehouse tasks</h1>
            <span class="st__subtitle">
              {queueCounts.all} task{queueCounts.all === 1 ? "" : "s"} today · {lowStockCount} restock{lowStockCount === 1 ? "" : "s"} low on stock
            </span>
          </div>
        </div>

        <!-- 4 KPI Cards -->
        <div class="st__kpis">
          <div class="st__kpi">
            <div class="st__kpi-top">
              <span class="st__kpi-label">Restocks to receive</span>
              <span class="st__kpi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13h5l1.5 3h5L16 13h5M5 5h14l2 8v6H3v-6z"></path></svg>
              </span>
            </div>
            <div class="st__kpi-bot">
              <span class="st__kpi-value">—</span>
              <span class="st__kpi-sub">Not tracked yet</span>
            </div>
          </div>

          <div class="st__kpi">
            <div class="st__kpi-top">
              <span class="st__kpi-label">Low stock</span>
              <span class="st__kpi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 2 20h20zM12 10v4M12 17h.01"></path></svg>
              </span>
            </div>
            <div class="st__kpi-bot">
              <span class="st__kpi-value">{lowStockCount}</span>
              <a href="/inventory/products" class="st__kpi-link">View low stock</a>
            </div>
          </div>

          <div class="st__kpi">
            <div class="st__kpi-top">
              <span class="st__kpi-label">Damage to record</span>
              <span class="st__kpi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5zM3 7.5 12 12l9-4.5M12 12v9"></path></svg>
              </span>
            </div>
            <div class="st__kpi-bot">
              <span class="st__kpi-value">—</span>
              <span class="st__kpi-sub">Not tracked yet</span>
            </div>
          </div>

          <div class="st__kpi">
            <div class="st__kpi-top">
              <span class="st__kpi-label">My open tickets</span>
              <span class="st__kpi-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z"></path></svg>
              </span>
            </div>
            <div class="st__kpi-bot">
              <span class="st__kpi-value">{openTicketCount}</span>
              {
                openTicketCount > 0 ? (
                  <a href="/inventory/tickets" class="st__kpi-link">View my tickets</a>
                ) : (
                  <span class="st__kpi-sub">No open tickets</span>
                )
              }
            </div>
          </div>
        </div>

        <!-- Two Columns Layout -->
        <div class="st__columns">
          <!-- Left Column: Task Queue -->
          <section aria-label="My task queue" class="st__queue-card">
            <div class="st__queue-head">
              <h2>My task queue</h2>
              <div role="group" aria-label="Filter tasks" class="st__filters">
                {
                  QUEUE_FILTERS.map((f) => (
                    <a
                      href={buildQueueUrl(f.value)}
                      class:list={["st__filter-btn", { "is-active": queue === f.value || (queue === "all" && f.value === "all") }]}
                    >
                      {f.label}
                    </a>
                  ))
                }
              </div>
            </div>

            <div class="st__table-scroll">
              <div class="st__table-head">
                <span>Task</span>
                <span>Reference</span>
                <span>Details</span>
                <span class="st__col-right">Units</span>
                <span>Location</span>
                <span>Due</span>
                <span></span>
              </div>

              {
                visibleTaskRows.length > 0 ? (
                  <div class="st__table-rows">
                    {visibleTaskRows.map((t) => (
                      <div class="st__table-row">
                        <span>
                          <span class:list={["st-pill", t.pillClass]}>{t.pillLabel}</span>
                        </span>
                        <span class="st__table-ref">{t.reference}</span>
                        <span class="st__table-details" title={t.details}>{t.details}</span>
                        <span class="st__col-right st__table-units">{t.units}</span>
                        <span class="st__table-loc">{t.location}</span>
                        <span class:list={["st__table-due", { "is-urgent": t.isUrgent }]}>{t.due}</span>
                        <a href={t.startHref} class="st__start-btn">Start</a>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="st__empty-queue">
                    <p>{EMPTY_QUEUE_MESSAGE[queue] ?? EMPTY_QUEUE_MESSAGE.all}</p>
                  </div>
                )
              }
            </div>
          </section>

          <!-- Right Column: Scan Box & Weekly Movement Chart -->
          <div class="st__right-col">
            <!-- Scan Box -->
            <section aria-label="Scan to look up or receive" class="st__scan-card">
              <div class="st__card-title-group">
                <h2>Scan to look up or receive</h2>
                <span class="st__card-sub">Product barcode, SKU or restock slip</span>
              </div>

              <label class="st__scan-input-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7V3h4M17 3h4v4M21 17v4h-4M7 21H3v-4M7 12h10"></path></svg>
                <input
                  type="text"
                  id="staff-lookup-input"
                  aria-label="Scan barcode or type SKU"
                  placeholder="Scan barcode or type SKU"
                />
              </label>

              <div class="st__scans-section">
                <span class="st__scans-label">Recent scans</span>
                {
                  recentMovements.length > 0 ? (
                    <div class="st__scans-list">
                      {recentMovements.map((s) => (
                        <div class="st__scan-row">
                          <span class="st__scan-dot">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                          </span>
                          <span class="st__scan-name">{s.name}</span>
                          <span class="st__scan-bin">{s.bin}</span>
                          <span class="st__scan-qty">{s.qty}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="st__scans-empty">
                      <span>No recent scans recorded today</span>
                    </div>
                  )
                }
              </div>
            </section>

            <!-- Stock Movements Chart -->
            <section aria-label="Stock movements this week" class="st__movements-card">
              <div class="st__movements-head">
                <div class="st__card-title-group">
                  <h2>Stock movements this week</h2>
                  <span class="st__card-sub">Units received vs sold · last 7 days</span>
                </div>
                <div class="st__movements-legend">
                  <span class="st__legend-item"><span class="st__dot st__dot--accent"></span>In {totalIn}</span>
                  <span class="st__legend-item"><span class="st__dot st__dot--chart2"></span>Out {totalOut}</span>
                </div>
              </div>

              <!-- Pure Responsive SVG Bar Chart matching Staff.dc.html -->
              <div class="st__chart-wrap">
                <svg width="100%" height="226" viewBox="0 0 322 226" role="img" aria-label={`Units in versus out over last 7 days: ${totalIn} received and ${totalOut} sold.`}>
                  <!-- Grid lines -->
                  <g class="st-chart__grid">
                    <path d="M30 65H322M30 127.5H322"></path>
                  </g>
                  <path d="M30 190H322" class="st-chart__axis"></path>

                  <!-- Y-Axis Labels -->
                  <g font-size="11" class="st-chart__axis-text" text-anchor="end" font-family="Geist, sans-serif">
                    <text x="22" y="69">{chartMax}</text>
                    <text x="22" y="131">{chartMid}</text>
                    <text x="22" y="194">0</text>
                  </g>

                  <!-- Bars for each day -->
                  {days.map((d, i) => {
                    const inVal = inByDay.get(d.key) ?? 0;
                    const outVal = outByDay.get(d.key) ?? 0;
                    const inH = chartMax > 0 ? Math.min(150, Math.round((inVal / chartMax) * 150)) : 0;
                    const outH = chartMax > 0 ? Math.min(150, Math.round((outVal / chartMax) * 150)) : 0;
                    const baseX = 35.8 + i * 41.7;
                    const inY = 190 - inH;
                    const outY = 190 - outH;

                    return (
                      <g>
                        {inH > 0 && (
                          <rect x={baseX} y={inY} width="14" height={inH} rx="3" class="st-chart__bar-in"></rect>
                        )}
                        {outH > 0 && (
                          <rect x={baseX + 16} y={outY} width="14" height={outH} rx="3" class="st-chart__bar-out"></rect>
                        )}
                        <text x={baseX + 15} y="210" class="st-chart__axis-text" text-anchor="middle" font-size="11" font-family="Geist, sans-serif">
                          {d.label}
                        </text>
                      </g>
                    );
                  })}
                </svg>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- Shared Design System Shell Tokens ---------- */
  .sd {
    --sd-shell: #fafafa;
    --sd-panel: #ffffff;
    --sd-card: #ffffff;
    --sd-fg: #0a0a0a;
    --sd-fg2: #404040;
    --sd-muted: #f5f5f5;
    --sd-muted-fg: #737373;
    --sd-border: #e5e5e5;
    --sd-input: #e5e5e5;
    --sd-grid: #f0f0f0;
    --sd-primary: #171717;
    --sd-primary-fg: #fafafa;
    --sd-success-bg: #ecfdf3;
    --sd-success-fg: #15803d;
    --sd-warn-bg: #fef3e2;
    --sd-warn-fg: #9a3412;
    --sd-danger-bg: #feecec;
    --sd-danger-fg: #b91c1c;
    --sd-info-bg: #eef2ff;
    --sd-info-fg: #3538cd;
    --sd-accent: #2b50e0;
    --sd-accent-soft: rgba(43, 80, 224, 0.10);
    --sd-chart2: #d9731f;
    --sd-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    color-scheme: light;

    min-height: 100vh;
    display: flex;
    background: var(--sd-shell);
    color: var(--sd-fg);
    font-family: "Geist", system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .sd[data-theme="dark"] {
    --sd-shell: #0a0a0a;
    --sd-panel: #0f0f0f;
    --sd-card: #171717;
    --sd-fg: #fafafa;
    --sd-fg2: #d4d4d4;
    --sd-muted: #262626;
    --sd-muted-fg: #a3a3a3;
    --sd-border: #262626;
    --sd-input: #363636;
    --sd-grid: #232323;
    --sd-primary: #fafafa;
    --sd-primary-fg: #171717;
    --sd-success-bg: #0f2a1c;
    --sd-success-fg: #4ade80;
    --sd-warn-bg: #2e1f0e;
    --sd-warn-fg: #fdba74;
    --sd-danger-bg: #2d1414;
    --sd-danger-fg: #f87171;
    --sd-info-bg: #1e2240;
    --sd-info-fg: #a5b4fc;
    --sd-accent: #6b8afb;
    --sd-accent-soft: rgba(107, 138, 251, 0.16);
    --sd-chart2: #e8894a;
    --sd-shadow: none;
    color-scheme: dark;
  }

  .sd__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 20;
  }
  .sd__sidebar {
    height: 100vh;
    position: sticky;
    top: 0;
  }
  @media (max-width: 1023px) {
    .sd__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 30;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .sd__sidebar.is-open {
      transform: translateX(0);
    }
    .sd__backdrop.is-open {
      display: block;
    }
  }
  .sd__panel {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin: 8px 8px 8px 0;
    background: var(--sd-panel);
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--sd-shadow);
  }
  @media (max-width: 1023px) {
    .sd__panel {
      margin: 8px;
    }
  }

  /* ---------- Main Page Layout ---------- */
  .st__main {
    flex-grow: 1;
    box-sizing: border-box;
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .st__main {
      padding: 16px;
      gap: 16px;
    }
  }

  .st__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .st__header-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .st__header h1 {
    margin: 0;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .st__subtitle {
    font-size: 14px;
    color: var(--sd-muted-fg);
  }

  /* ---------- 4 KPI Cards ---------- */
  .st__kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 1024px) {
    .st__kpis {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .st__kpis {
      grid-template-columns: 1fr;
    }
  }
  .st__kpi {
    height: 118px;
    box-sizing: border-box;
    padding: 18px;
    background: var(--sd-card);
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    box-shadow: var(--sd-shadow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .st__kpi-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .st__kpi-label {
    font-size: 13px;
    color: var(--sd-muted-fg);
  }
  .st__kpi-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--sd-muted);
    color: var(--sd-fg2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .st__kpi-bot {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .st__kpi-value {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .st__kpi-sub {
    font-size: 12px;
    color: var(--sd-muted-fg);
  }
  .st__kpi-link {
    font-size: 12px;
    color: var(--sd-accent);
    text-decoration: none;
    font-weight: 500;
  }
  .st__kpi-link:hover {
    text-decoration: underline;
  }

  /* ---------- Two Columns Layout ---------- */
  .st__columns {
    display: flex;
    gap: 16px;
    flex-grow: 1;
