<script>
  // Search action
  const input = document.querySelector<HTMLInputElement>("#staff-lookup-input");
  input?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    const value = input.value.trim();
    if (!value) return;
    window.location.href = `/inventory/products?search=${encodeURIComponent(value)}`;
  });

  // --- Theme + sidebar chrome ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
      document.documentElement.setAttribute("data-theme", "dark");
      document.body.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
      document.documentElement.removeAttribute("data-theme");
      document.body.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });
</script>
