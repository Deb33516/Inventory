---
// Matches the Claude Design canvas's Inventory Staff artboard
// (project/Staff.dc.html, board "Staff warehouse tasks", page id "staff")
// as closely as technically possible. Four design sections have no backing
// data model yet and are rendered as honest, non-fabricated empty/deferred
// states rather than invented numbers — see the inline notes below and the
// implementation report for the full real-vs-deferred breakdown.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import EmptyState from "../../components/catalog/EmptyState.astro";
import KpiCard from "../../components/dashboard/KpiCard.astro";
import ChartCanvas from "../../components/dashboard/ChartCanvas.astro";
import Badge from "../../components/ui/Badge.astro";
import FilterChip from "../../components/catalog/FilterChip.astro";
import { resolveDashboardRange } from "../../lib/dashboardRange";
import AppShell from "../../components/layout/AppShell.astro";
import { CHART_COLORS } from "../../lib/chartTheme";
import { staffSidebarNav, STAFF_ICONS } from "../../lib/staffNav";

const userId = Astro.locals.user!.id;

// --- Real: low stock (existing calc, unchanged from the prior dashboard) —
// select broadened to include product_id/sku/name too, so the exact same
// real rows can also back the "My task queue" Restock rows below (no second
// query, no new definition of "low stock"). ---
const { data: inventoryRows } = await Astro.locals.supabase
  .from("inventory")
  .select("product_id, quantity_on_hand, reorder_level, products!inner(sku, name, is_active)")
  .eq("products.is_active", true);

const rows = inventoryRows ?? [];
const lowStockCount = rows.filter((r) => r.quantity_on_hand > 0 && r.quantity_on_hand <= r.reorder_level).length;

// --- Real: my open support tickets — select broadened to include id/
// subject/created_at too, so the same real rows can also back the "My task
// queue" Ticket rows below (same filter that already computes
// openTicketCount, no second query, no new definition of "open"). ---
const { data: myTickets } = await Astro.locals.supabase
  .from("support_tickets")
  .select("id, subject, status, created_at")
  .eq("assigned_to", userId);
const openTickets = (myTickets ?? []).filter((t) => !["resolved", "closed"].includes(t.status));
const openTicketCount = openTickets.length;

// --- "My task queue" (real data only — see the section's own markup
// comment below for the full real-vs-unavailable breakdown per task type).
const queue = Astro.url.searchParams.get("queue") ?? "all";

function buildQueueUrl(next: string) {
  const params = new URLSearchParams(Astro.url.search);
  if (next === "all") params.delete("queue");
  else params.set("queue", next);
  const qs = params.toString();
  return qs ? `/inventory?${qs}` : "/inventory";
}

interface TaskRow {
  type: "restock" | "ticket";
  pillLabel: string;
  reference: string;
  details: string;
  units: string;
  location: string;
  due: string;
  startHref: string;
}

// Restock: the exact same "low stock" rows as the KPI card above (real
// products genuinely needing restocking) — Start links to the real
// Receiving screen. Reference is the real SKU; Location/Due have no real
// backing field anywhere in the schema, so both are shown as "—" rather
// than invented.
function productOf(row: { products: unknown }): { sku: string; name: string } {
  return row.products as unknown as { sku: string; name: string };
}

const restockRows: TaskRow[] = [...rows]
  .filter((r) => r.quantity_on_hand > 0 && r.quantity_on_hand <= r.reorder_level)
  .sort((a, b) => a.quantity_on_hand - b.quantity_on_hand)
  .map((r) => {
    const product = productOf(r);
    return {
      type: "restock",
      pillLabel: "Restock",
      reference: product.sku,
      details: `${product.name} · ${r.quantity_on_hand} on hand · reorder at ${r.reorder_level}`,
      units: String(r.quantity_on_hand),
      location: "—",
      due: "—",
      startHref: "/inventory/receiving",
    };
  });

// Tickets: the exact same "my open tickets" rows as the KPI card above —
// Start links to the real ticket detail page. No sequential reference-
// number field exists on support_tickets (just a uuid) — shown as "—"
// rather than inventing a "TK-####" scheme. Units/Location/Due have no
// real backing field on a ticket — all "—".
const ticketRows: TaskRow[] = [...openTickets]
  .sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime())
  .map((t) => ({
    type: "ticket",
    pillLabel: "Ticket",
    reference: "—",
    details: t.subject,
    units: "—",
    location: "—",
    due: "—",
    startHref: `/inventory/tickets/${t.id}`,
  }));

// Receive/Damage/Adjust: no incoming-shipment, pending-damage, or pending-
// adjustment entity exists anywhere in this schema (see CLAUDE.md) — these
// three categories are always real, honest zeros, never fabricated rows.
const queueCounts = {
  all: restockRows.length + ticketRows.length,
  receive: 0,
  restock: restockRows.length,
  damage: 0,
  adjust: 0,
  tickets: ticketRows.length,
};

const QUEUE_FILTERS: { value: keyof typeof queueCounts; label: string }[] = [
  { value: "all", label: "All" },
  { value: "receive", label: "Receive" },
  { value: "restock", label: "Restock" },
  { value: "damage", label: "Damage" },
  { value: "adjust", label: "Adjust" },
  { value: "tickets", label: "Tickets" },
];

const visibleTaskRows: TaskRow[] =
  queue === "restock" ? restockRows : queue === "tickets" ? ticketRows : queue === "all" ? [...restockRows, ...ticketRows] : [];

const EMPTY_QUEUE_MESSAGE: Record<string, string> = {
  all: "No task queue yet.",
  receive: "Incoming-shipment tracking isn't supported in this system yet.",
  restock: "No products are currently low on stock.",
  damage: "Damage-to-record tracking isn't supported in this system yet.",
  adjust: "Pending-adjustment tracking isn't supported in this system yet.",
  tickets: "No open tickets assigned to you.",
};

// --- Real: stock movements, last 7 days, bucketed by IST calendar day into
// in (positive quantity_delta) vs out (negative) — the design shows this
// exact shape, but the existing dashboard_inventory_movement_summary RPC
// only totals by movement_type over a range, not per day, so the raw rows
// are fetched (same RLS-covered table already used by /inventory/movements)
// and bucketed here rather than adding a new RPC/migration for this alone.
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const DAY_MS = 24 * 60 * 60 * 1000;
function istDayKey(iso: string) {
  return new Date(new Date(iso).getTime() + IST_OFFSET_MS).toISOString().slice(0, 10);
}

const range = resolveDashboardRange("7d");
const { data: movementRows } = await Astro.locals.supabase
  .from("inventory_movements")
  .select("quantity_delta, created_at")
  .gte("created_at", range.from!)
  .lt("created_at", range.to!);

const days = Array.from({ length: 7 }, (_, i) => {
  const t = new Date(new Date(range.from!).getTime() + i * DAY_MS);
  return {
    key: istDayKey(t.toISOString()),
    label: new Intl.DateTimeFormat("en-US", { weekday: "short", timeZone: "Asia/Kolkata" }).format(t),
  };
});

const inByDay = new Map(days.map((d) => [d.key, 0]));
const outByDay = new Map(days.map((d) => [d.key, 0]));
for (const m of movementRows ?? []) {
  const key = istDayKey(m.created_at);
  if (m.quantity_delta > 0) inByDay.set(key, (inByDay.get(key) ?? 0) + m.quantity_delta);
  else if (m.quantity_delta < 0) outByDay.set(key, (outByDay.get(key) ?? 0) + Math.abs(m.quantity_delta));
}
const totalIn = [...inByDay.values()].reduce((a, b) => a + b, 0);
const totalOut = [...outByDay.values()].reduce((a, b) => a + b, 0);
const hasMovementData = totalIn > 0 || totalOut > 0;
---

<BaseLayout title="Warehouse tasks — Inventory">
  <AppShell
    active="/inventory"
    sidebarNav={staffSidebarNav(openTicketCount)}
    sidebarBadge="INVENTORY"
    breadcrumb={["Dashboard", "Warehouse tasks"]}
    topbarSearch={{ placeholder: "Find product, SKU or bin…" }}
    topbarActions={[{ label: "Report an issue", href: "/inventory/tickets" }]}
    showNotifications
  >
    <Fragment slot="sidebar-widget">
      <div class="mx-xs mb-md p-md rounded-xl bg-surface-soft border border-hairline">
        <p class="text-xs text-muted">Shift</p>
        <p class="mt-xxs text-sm font-bold text-ink">Not available yet</p>
        <p class="mt-xxs text-xs text-muted">Shift scheduling isn't tracked in this system yet.</p>
      </div>
    </Fragment>

    <div class="flex items-end justify-between flex-wrap gap-md">
      <div>
        <h1 class="text-2xl font-bold text-ink">Warehouse tasks</h1>
        <p class="mt-xxs text-sm text-muted">{lowStockCount} product{lowStockCount === 1 ? "" : "s"} low on stock</p>
      </div>
    </div>

    <div class="mt-lg grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-lg">
      <KpiCard label="Restocks to receive" value="—" sublabel="Not tracked yet" icon={STAFF_ICONS.inbox} />
      <KpiCard
        label="Low stock"
        value={String(lowStockCount)}
        tone="warning"
        href="/inventory/stock?status=low"
        sublabel="View low stock"
        icon={STAFF_ICONS.alert}
      />
      <KpiCard label="Damage to record" value="—" sublabel="Not tracked yet" icon={STAFF_ICONS.box} />
      <KpiCard
        label="My open tickets"
        value={String(openTicketCount)}
        href={openTicketCount > 0 ? "/inventory/tickets" : undefined}
        sublabel={openTicketCount > 0 ? "View my tickets" : "No open tickets"}
        icon={STAFF_ICONS.support}
      />
    </div>

    <div class="mt-lg flex flex-col lg:flex-row gap-lg items-start">
      <section class="w-full lg:w-[740px] shrink-0 bg-canvas border border-hairline rounded-xl shadow-sm overflow-hidden flex flex-col">
        <div class="flex items-center justify-between flex-wrap gap-sm px-lg pt-lg pb-sm">
          <h2 class="text-sm font-bold text-ink">My task queue</h2>
          <div role="group" aria-label="Filter tasks" class="flex flex-wrap gap-xs">
            {
              QUEUE_FILTERS.map((f) => (
                <FilterChip href={buildQueueUrl(f.value)} active={queue === f.value || (queue === "all" && f.value === "all")}>
                  {`${f.label} ${queueCounts[f.value]}`}
                </FilterChip>
              ))
            }
          </div>
        </div>

        <div class="overflow-x-auto">
          <div
            class="grid gap-sm px-lg h-9 items-center bg-surface-soft border-t border-b border-hairline text-xs font-bold text-muted uppercase tracking-[0.5px]"
            style="grid-template-columns: 96px 84px 1fr 52px 72px 52px 64px; min-width: 620px;"
          >
            <span>Task</span>
            <span>Reference</span>
            <span>Details</span>
            <span class="text-right">Units</span>
            <span>Location</span>
            <span>Due</span>
            <span></span>
          </div>

          {
            visibleTaskRows.length > 0 ? (
              <div>
                {visibleTaskRows.map((t) => (
                  <div
                    class="grid gap-sm px-lg items-center border-b border-hairline text-sm"
                    style="grid-template-columns: 96px 84px 1fr 52px 72px 52px 64px; min-width: 620px; height: 54px;"
                  >
                    <span>
                      <Badge tone={t.type === "restock" ? "warning" : "neutral"}>{t.pillLabel}</Badge>
                    </span>
                    <span class="font-bold text-ink">{t.reference}</span>
                    <span class="text-body truncate">{t.details}</span>
                    <span class="text-right font-bold text-ink">{t.units}</span>
                    <span class="text-xs text-body">{t.location}</span>
                    <span class="text-xs text-body">{t.due}</span>
                    <a
                      href={t.startHref}
                      class="h-9 box-border rounded-lg border border-hairline bg-canvas text-xs font-bold text-ink flex items-center justify-center hover:border-hairline-strong"
                    >
                      Start
                    </a>
                  </div>
                ))}
              </div>
            ) : (
              <EmptyState class="m-lg" title={EMPTY_QUEUE_MESSAGE[queue] ?? EMPTY_QUEUE_MESSAGE.all} />
            )
          }
        </div>
      </section>

      <div class="flex-grow w-full flex flex-col gap-lg">
        <Card>
          <h2 class="text-sm font-bold text-ink">Scan to look up or receive</h2>
          <p class="mt-xxs text-xs text-muted">Product barcode, SKU or name</p>
          <label class="mt-md h-14 box-border px-md border-2 border-primary rounded-lg bg-surface-soft flex items-center gap-md text-muted">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 7V3h4M17 3h4v4M21 17v4h-4M7 21H3v-4M7 12h10" />
            </svg>
            <input
              id="staff-lookup-input"
              type="text"
              aria-label="Scan barcode or type SKU"
              placeholder="Scan barcode or type SKU"
              class="border-0 outline-none bg-transparent text-base flex-grow text-ink"
            />
          </label>
          <div class="mt-md">
            <p class="text-xs font-bold text-muted">Recent scans</p>
            <EmptyState class="mt-sm" title="No recent scans yet" message="Scan history isn't tracked in this system yet." />
          </div>
        </Card>

        <Card>
          <div class="flex items-start justify-between">
            <div>
              <h2 class="text-sm font-bold text-ink">Stock movements this week</h2>
              <p class="mt-xxs text-xs text-muted">Units received vs sold · last 7 days</p>
            </div>
            <div class="flex flex-col gap-xxs text-xs text-muted">
              <span class="flex items-center gap-xs"><span class="w-2 h-2 rounded-sm" style={`background:${CHART_COLORS.ink}`}></span>In {totalIn}</span>
              <span class="flex items-center gap-xs"><span class="w-2 h-2 rounded-sm" style={`background:${CHART_COLORS.mute}`}></span>Out {totalOut}</span>
            </div>
          </div>
          <div class="mt-sm">
            {
              hasMovementData ? (
                <ChartCanvas
                  id="staff-weekly-movements"
                  type="bar"
                  height={226}
                  data={{
                    labels: days.map((d) => d.label),
                    datasets: [
                      { label: "In", data: days.map((d) => inByDay.get(d.key) ?? 0), backgroundColor: CHART_COLORS.ink },
                      { label: "Out", data: days.map((d) => outByDay.get(d.key) ?? 0), backgroundColor: CHART_COLORS.mute },
                    ],
                  }}
                  options={{ plugins: { legend: { display: false } } }}
                />
              ) : (
                <EmptyState title="No movements in the last 7 days" />
              )
            }
          </div>
        </Card>
      </div>
    </div>
  </AppShell>
</BaseLayout>

<script>
  // /inventory/stock has real, working ?search= filtering today;
  // /inventory/products does not (confirmed by reading its source — it
  // only handles ?created=/?updated=), so both search entry points here
  // route to stock rather than silently doing nothing on products.
  const input = document.querySelector<HTMLInputElement>("#staff-lookup-input");
  input?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    const value = input.value.trim();
    if (!value) return;
    window.location.href = `/inventory/stock?search=${encodeURIComponent(value)}`;
  });

  const topbarSearch = document.querySelector<HTMLInputElement>('input[aria-label="Search"]');
  topbarSearch?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;
    const value = topbarSearch.value.trim();
    if (!value) return;
    window.location.href = `/inventory/stock?search=${encodeURIComponent(value)}`;
  });
</script>
