---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FilterChip from "../../../components/catalog/FilterChip.astro";
import EmptyState from "../../../components/catalog/EmptyState.astro";
import StockBadge from "../../../components/ui/StockBadge.astro";
import AppShell from "../../../components/layout/AppShell.astro";

const url = Astro.url;
const search = url.searchParams.get("search")?.trim() ?? "";
const status = url.searchParams.get("status") ?? "";

let query = Astro.locals.supabase
  .from("inventory")
  .select("product_id, quantity_on_hand, reorder_level, products!inner(sku, name, is_active)")
  .eq("products.is_active", true);

if (search) {
  query = query.ilike("products.name", `%${search}%`);
}

const { data: rows } = await query.order("product_id");

function statusOf(qty: number, reorder: number) {
  if (qty <= 0) return "out";
  if (qty <= reorder) return "low";
  return "ok";
}

const filtered = (rows ?? []).filter((r) => {
  if (!status) return true;
  return statusOf(r.quantity_on_hand, r.reorder_level) === status;
});

function buildUrl(overrides: Record<string, string | undefined>) {
  const next = new URLSearchParams(url.search);
  for (const [key, value] of Object.entries(overrides)) {
    if (value) next.set(key, value);
    else next.delete(key);
  }
  const qs = next.toString();
  return qs ? `/inventory/stock?${qs}` : "/inventory/stock";
}
---

<BaseLayout title="Stock — Inventory">
  <AppShell active="inventory">
    <h1 class="text-2xl font-bold text-ink">Stock</h1>

    <form method="get" class="mt-lg">
      <input
        type="text"
        name="search"
        value={search}
        placeholder="Search products..."
        class="w-full md:max-w-sm h-12 px-md bg-canvas text-ink border border-hairline focus:border-ink outline-none transition-colors"
      />
      {status && <input type="hidden" name="status" value={status} />}
    </form>

    <div class="mt-md flex gap-xs overflow-x-auto pb-xs">
      <FilterChip href={buildUrl({ status: undefined })} active={!status}>All</FilterChip>
      <FilterChip href={buildUrl({ status: "low" })} active={status === "low"}>Low stock</FilterChip>
      <FilterChip href={buildUrl({ status: "out" })} active={status === "out"}>Out of stock</FilterChip>
    </div>

    {
      filtered.length > 0 ? (
        <div class="mt-lg overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-hairline text-left text-muted uppercase text-xs tracking-[0.5px]">
                <th class="py-xs pr-md">SKU</th>
                <th class="py-xs pr-md">Name</th>
                <th class="py-xs pr-md">On hand</th>
                <th class="py-xs pr-md">Reorder level</th>
                <th class="py-xs pr-md">Status</th>
                <th class="py-xs" />
              </tr>
            </thead>
            <tbody>
              {filtered.map((r) => (
                <tr class="border-b border-hairline">
                  <td class="py-sm pr-md text-body">{r.products.sku}</td>
                  <td class="py-sm pr-md text-ink font-bold">{r.products.name}</td>
                  <td class="py-sm pr-md text-body">{r.quantity_on_hand}</td>
                  <td class="py-sm pr-md text-body">{r.reorder_level}</td>
                  <td class="py-sm pr-md">
                    <StockBadge quantityOnHand={r.quantity_on_hand} reorderLevel={r.reorder_level} />
                  </td>
                  <td class="py-sm">
                    <a href={`/inventory/stock/${r.product_id}`} class="text-primary font-bold">
                      Manage
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <EmptyState class="mt-lg" title="No stock matches" />
      )
    }
  </AppShell>
</BaseLayout>
