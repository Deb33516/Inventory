---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Card from "../../../../components/ui/Card.astro";
import StockMovementForm from "../../../../components/inventory/StockMovementForm.astro";
import EmptyState from "../../../../components/catalog/EmptyState.astro";
import AppShell from "../../../../components/layout/AppShell.astro";

const { productId } = Astro.params;

const { data: inventory } = await Astro.locals.supabase
  .from("inventory")
  .select("product_id, products(name, sku)")
  .eq("product_id", productId)
  .maybeSingle();

if (!inventory) {
  Astro.response.status = 404;
}

const { data: suppliers } = await Astro.locals.supabase
  .from("suppliers")
  .select("id, name")
  .eq("is_active", true)
  .order("name");

const supplierOptions = (suppliers ?? []).map((s) => ({ value: s.id, label: s.name }));
---

<BaseLayout title={inventory ? `Restock ${inventory.products.name} — Inventory` : "Not found — Inventory"}>
  <AppShell active="inventory" backHref={`/inventory/stock/${productId}`} backLabel="Back">
    {
      inventory ? (
        <Card class="max-w-lg">
          <h1 class="text-2xl font-bold text-ink">Restock {inventory.products.name}</h1>
          <p class="text-sm text-muted">{inventory.products.sku}</p>
          <div class="mt-lg">
            <StockMovementForm movementType="restock" productId={inventory.product_id} suppliers={supplierOptions} />
          </div>
        </Card>
      ) : (
        <EmptyState title="Product stock not found" />
      )
    }
  </AppShell>
</BaseLayout>
