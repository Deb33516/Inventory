---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Card from "../../../../components/ui/Card.astro";
import StockMovementForm from "../../../../components/inventory/StockMovementForm.astro";
import EmptyState from "../../../../components/catalog/EmptyState.astro";
import AppShell from "../../../../components/layout/AppShell.astro";

const { productId } = Astro.params;

const { data: inventory } = await Astro.locals.supabase
  .from("inventory")
  .select("product_id, products(name, sku)")
  .eq("product_id", productId)
  .maybeSingle();

if (!inventory) {
  Astro.response.status = 404;
}
---

<BaseLayout title={inventory ? `Adjust ${inventory.products.name} — Inventory` : "Not found — Inventory"}>
  <AppShell active="inventory" backHref={`/inventory/stock/${productId}`} backLabel="Back">
    {
      inventory ? (
        <Card class="max-w-lg">
          <h1 class="text-2xl font-bold text-ink">Adjust {inventory.products.name}</h1>
          <p class="text-sm text-muted">{inventory.products.sku}</p>
          <div class="mt-lg">
            <StockMovementForm movementType="adjustment" productId={inventory.product_id} />
          </div>
        </Card>
      ) : (
        <EmptyState title="Product stock not found" />
      )
    }
  </AppShell>
</BaseLayout>
