---
// Matches the Claude Design canvas's Checkout artboard
// (project/PageCheckout.dc.html, imported by CustCheckout.dc.html). The
// design's separate "Delivery date" picker and "Payment" method cards with
// icons are simplified to the existing real fields (a shipping-address
// text field, a payment-method select) — there's no delivery-slot data
// model to pick a real date/window from. No GST/tax line in the summary:
// place_order() computes `tax` server-side (defaulting to 0, no rate
// logic implemented anywhere in this schema/RPC) — showing a guessed
// percentage here would be a fabricated financial figure, so the summary
// only ever shows the real cart subtotal pre-checkout; the authoritative
// total (from the order row) is what's shown after the order is placed.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/ui/Card.astro";
import Input from "../../components/ui/Input.astro";
import Select from "../../components/ui/Select.astro";
import Textarea from "../../components/ui/Textarea.astro";
import Button from "../../components/ui/Button.astro";
import CartSummary from "../../components/cart/CartSummary.astro";
import PublicHeader from "../../components/layout/PublicHeader.astro";

// Middleware guarantees a customer is present for every /checkout/* route
// (staff/admin are redirected to their own dashboard before reaching here).
const { user } = Astro.locals;
const userId = user!.id;
---

<BaseLayout title="Checkout — Inventory">
  <PublicHeader backHref="/cart" backLabel="Cart" />

  <main id="main-content" class="max-w-[1100px] mx-auto px-lg py-xl">
    <h1 class="text-2xl font-bold text-ink">Checkout</h1>

    <div class="mt-lg grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-lg items-start">
      <div class="space-y-lg">
        <Card>
          <h2 class="text-sm font-bold text-ink">Delivery</h2>
          <p class="mt-xxs text-xs text-muted">Where should we deliver?</p>
          <form id="checkout-form" class="mt-md space-y-md" data-user-id={userId}>
            <Input label="Shipping address" name="shippingAddress" required />
            <Select
              label="Payment method"
              name="paymentMethod"
              options={[
                { value: "card", label: "Card" },
                { value: "upi", label: "UPI" },
                { value: "cash", label: "Cash" },
                { value: "bank_transfer", label: "Bank transfer" },
              ]}
              required
            />
            <Textarea label="Notes (optional)" name="notes" />
            <p id="form-message" class="text-sm" role="status" />
            <Button type="submit" variant="primary" class="w-full">
              Place order
            </Button>
          </form>
        </Card>
      </div>

      <Card>
        <h2 class="text-sm font-bold text-ink">Order summary</h2>
        <div class="mt-md">
          <CartSummary />
        </div>
      </Card>
    </div>
  </main>
</BaseLayout>

<script>
  // Not using `define:vars` here: it forces this script to be inlined as
  // a plain non-module tag, and a static `import` is a SyntaxError outside
  // a module context — confirmed against this project's own compiled
  // production output. Server-rendered values that used to be injected via
  // define:vars are instead read off the form's dataset, so this stays a
  // normal, properly bundled module script with both "astro:actions" and
  // the local cart module resolved correctly by Vite.
  import { actions } from "astro:actions";
  import { getCart, clearCart } from "../../lib/cart";

  const form = document.querySelector("#checkout-form");
  const messageEl = document.querySelector("#form-message");
  const userId = form.dataset.userId;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    messageEl.textContent = "";
    messageEl.classList.remove("text-error", "text-success");

    const cart = getCart();
    if (cart.length === 0) {
      messageEl.textContent = "Your cart is empty.";
      messageEl.classList.add("text-error");
      return;
    }

    const formData = new FormData(form);
    const button = form.querySelector("button[type=submit]");
    button.disabled = true;

    const { data, error } = await actions.placeOrder({
      customerId: userId,
      items: cart.map((i) => ({ productId: i.productId, quantity: i.quantity })),
      shippingAddress: formData.get("shippingAddress"),
      paymentMethod: formData.get("paymentMethod"),
      notes: formData.get("notes") || undefined,
    });

    if (error) {
      button.disabled = false;
      messageEl.textContent = error.message;
      messageEl.classList.add("text-error");
      return;
    }

    clearCart();
    window.location.href = `/account/orders/${data.order.id}?created=1`;
  });
</script>
