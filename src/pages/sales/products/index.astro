    display: grid;
    grid-template-columns: minmax(180px, 1.8fr) 130px 100px 90px 110px 110px;
    gap: 12px;
    align-items: center;
    padding: 0 16px;
    min-width: 780px;
  }
  .ps__grid-head {
    height: 40px;
    border-bottom: 1px solid var(--sd-border);
    font-size: 13px;
    font-weight: 500;
    color: var(--sd-muted-fg);
  }
  .ps__row {
    height: 58px;
    border-bottom: 1px solid var(--sd-border);
    font-size: 14px;
  }
  .ps__product-cell {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .ps__product-icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 8px;
    background: var(--sd-muted);
    color: var(--sd-muted-fg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ps__product-name-col {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .ps__product-name {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ps__product-sku {
    font-size: 12px;
    color: var(--sd-muted-fg);
  }
  .ps__col-right {
    text-align: right;
  }
  .ps__muted-cell {
    color: var(--sd-fg2);
  }
  .ps__total {
    font-weight: 500;
  }
  .ps__pill {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .ps__pill--in {
    background: var(--sd-success-bg);
    color: var(--sd-success-fg);
  }
  .ps__pill--low {
    background: var(--sd-warn-bg);
    color: var(--sd-warn-fg);
  }
  .ps__pill--out {
    background: var(--sd-danger-bg);
    color: var(--sd-danger-fg);
  }
  .ps__view-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--sd-accent);
    text-decoration: none;
    text-align: right;
    white-space: nowrap;
  }
  .ps__panel-footer {
    min-width: 780px;
    box-sizing: border-box;
    height: 52px;
    padding: 0 16px;
    display: flex;
    align-items: center;
    font-size: 13px;
    color: var(--sd-muted-fg);
  }

  .ps__empty {
    padding: 48px 24px;
    text-align: center;
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    background: var(--sd-card);
  }
  .ps__empty-title {
    margin: 0;
    font-size: 16px;
