  .ps__main {
    flex-grow: 1;
    box-sizing: border-box;
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .ps__main {
      padding: 16px;
    }
  }

  .ps__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .ps__heading-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ps__heading-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ps__heading-row h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .ps__readonly-badge {
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--sd-muted);
    font-size: 12px;
    font-weight: 500;
    color: var(--sd-fg2);
  }
  .ps__subtitle {
    font-size: 14px;
    color: var(--sd-muted-fg);
  }

