---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import OrderForm from "../../../components/orders/OrderForm.astro";

const { data: customers } = await Astro.locals.supabase
  .from("profiles")
  .select("id, full_name")
  .eq("role", "customer")
  .order("full_name");

const customerOptions = (customers ?? []).map((c) => ({ value: c.id, label: c.full_name ?? "Unnamed customer" }));

const { data: products } = await Astro.locals.supabase
  .from("products")
  .select("id, sku, name, price")
  .eq("is_active", true)
  .order("name");
---

<BaseLayout title="New order — Sales">
  <header class="h-16 flex items-center justify-between px-lg border-b border-hairline bg-canvas">
    <a href="/sales/orders" class="font-bold text-ink">
      ← Orders
    </a>
  </header>

  <main class="max-w-[1440px] mx-auto px-lg py-xl">
    <Card class="max-w-2xl">
      <h1 class="text-2xl font-bold text-ink">New order</h1>
      <div class="mt-lg">
        <OrderForm customers={customerOptions} products={products ?? []} />
      </div>
    </Card>
  </main>
</BaseLayout>
