  .no__empty-note {
    margin: 0;
    padding: 24px 0;
    text-align: center;
    font-size: 13px;
    color: var(--sd-muted-fg);
  }

  .no__summary-card {
    position: sticky;
    top: 0;
  }
  .no__dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
  }
  .no__dl-row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .no__dl-row dt {
    color: var(--sd-muted-fg);
  }
  .no__dl-row dd {
    margin: 0;
  }
  .no__divider {
    height: 1px;
    background: var(--sd-border);
    margin: 4px 0;
  }
  .no__dl-total {
    align-items: baseline;
  }
  .no__dl-total dt {
    font-weight: 600;
    color: var(--sd-fg);
  }
  .no__dl-total dd {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .no__field-col {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .no__field-label {
    font-size: 13px;
    font-weight: 500;
  }
  .no__input {
    height: 36px;
    box-sizing: border-box;
    padding: 0 10px;
    border: 1px solid var(--sd-input);
    border-radius: 8px;
    background: var(--sd-card);
    font: inherit;
    font-size: 14px;
    color: var(--sd-fg);
  }
  .no__textarea {
    height: 64px;
    box-sizing: border-box;
    resize: none;
    padding: 8px 12px;
    border: 1px solid var(--sd-input);
    border-radius: 8px;
    background: var(--sd-card);
    font: inherit;
    font-size: 14px;
    color: var(--sd-fg);
  }
  .no__status-message {
    margin: 0;
    font-size: 13px;
    color: var(--sd-danger-fg);
    min-height: 0;
  }
  .no__actions-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .no__btn {
    height: 38px;
    box-sizing: border-box;
    border-radius: 8px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    color: var(--sd-fg);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
  }
  .no__btn--primary {
    border: 0;
    background: var(--sd-primary);
    color: var(--sd-primary-fg);
  }
  .no__btn--primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .no__btn--ghost {
    border: 0;
    background: transparent;
    color: var(--sd-fg2);
  }
</style>

<script>
  import { actions } from "astro:actions";

  interface Customer {
    id: string;
    name: string;
  }
  interface Product {
    id: string;
    sku: string;
    name: string;
    price: number;
    qty: number | null;
    stockTone: "in" | "low" | "out" | null;
  }
  interface LineItem {
    productId: string;
    sku: string;
    name: string;
    price: number;
    quantity: number;
  }

  const dataEl = document.getElementById("no-data") as HTMLElement;
  const customers = JSON.parse(dataEl.dataset.customers!) as Customer[];
  const products = JSON.parse(dataEl.dataset.products!) as Product[];

  const lineItems: LineItem[] = [];
  let selectedCustomerId: string | null = null;

  const formatCurrency = (value: number) =>
    new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(value);

  const STOCK_LABEL: Record<string, string> = { in: "In stock", low: "Low stock", out: "Out of stock" };

  // --- Customer picker ---
  const customerTrigger = document.querySelector<HTMLButtonElement>("#customer-trigger")!;
  const customerPanel = document.querySelector<HTMLDivElement>("#customer-panel")!;
  const customerSearch = document.querySelector<HTMLInputElement>("#customer-search")!;
  const customerResults = document.querySelector<HTMLDivElement>("#customer-results")!;
  const customerIdInput = document.querySelector<HTMLInputElement>("#customer-id-input")!;
  const customerAvatar = document.querySelector<HTMLSpanElement>("#customer-avatar")!;
  const customerLabel = document.querySelector<HTMLSpanElement>("#customer-label")!;

  function initialsOf(name: string): string {
    return (
      name
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((p) => p[0]!.toUpperCase())
        .join("") || "?"
    );
  }

  function renderCustomerResults(filter: string) {
    const needle = filter.trim().toLowerCase();
    const matches = needle ? customers.filter((c) => c.name.toLowerCase().includes(needle)) : customers;
    customerResults.innerHTML = "";
    if (matches.length === 0) {
      const empty = document.createElement("p");
      empty.className = "no__picker-empty";
      empty.textContent = "No customers found.";
      customerResults.appendChild(empty);
      return;
    }
    matches.forEach((c) => {
      const row = document.createElement("button");
      row.type = "button";
      row.className = "no__picker-row";
      row.setAttribute("role", "option");
      row.textContent = c.name;
      row.addEventListener("click", () => {
        selectedCustomerId = c.id;
        customerIdInput.value = c.id;
        customerAvatar.textContent = initialsOf(c.name);
        customerLabel.textContent = c.name;
        closeCustomerPanel();
        updateSubmitState();
      });
      customerResults.appendChild(row);
    });
  }

  function openCustomerPanel() {
    customerPanel.hidden = false;
    customerTrigger.setAttribute("aria-expanded", "true");
    renderCustomerResults(customerSearch.value);
    customerSearch.focus();
  }
  function closeCustomerPanel() {
    customerPanel.hidden = true;
    customerTrigger.setAttribute("aria-expanded", "false");
  }
  customerTrigger.addEventListener("click", () => {
    customerPanel.hidden ? openCustomerPanel() : closeCustomerPanel();
  });
  customerSearch.addEventListener("input", () => renderCustomerResults(customerSearch.value));
  document.addEventListener("click", (e) => {
    if (!customerPanel.hidden && !customerPanel.contains(e.target as Node) && e.target !== customerTrigger && !customerTrigger.contains(e.target as Node)) {
      closeCustomerPanel();
    }
  });

  // --- Product search-to-add ---
  const productSearch = document.querySelector<HTMLInputElement>("#product-search")!;
  const productResults = document.querySelector<HTMLDivElement>("#product-results")!;
  const lineItemsEl = document.querySelector<HTMLDivElement>("#line-items")!;
  const noItemsEmpty = document.querySelector<HTMLParagraphElement>("#no-items-empty")!;

  function renderProductResults(filter: string) {
    const needle = filter.trim().toLowerCase();
    if (!needle) {
      productResults.hidden = true;
      productResults.innerHTML = "";
      return;
    }
    const matches = products.filter((p) => p.name.toLowerCase().includes(needle) || p.sku.toLowerCase().includes(needle)).slice(0, 20);
    productResults.innerHTML = "";
    if (matches.length === 0) {
      const empty = document.createElement("p");
      empty.className = "no__picker-empty";
      empty.textContent = "No products found.";
      productResults.appendChild(empty);
    } else {
      matches.forEach((p) => {
        const row = document.createElement("button");
        row.type = "button";
        row.className = "no__picker-row";
        row.setAttribute("role", "option");

        const sub = document.createElement("span");
        sub.className = "no__picker-row-sub";
        const nameEl = document.createElement("span");
        nameEl.className = "no__picker-row-name";
        nameEl.textContent = p.name;
        const metaEl = document.createElement("span");
        metaEl.className = "no__picker-row-meta";
        metaEl.append(`${p.sku} · ${formatCurrency(p.price)}`);
        if (p.stockTone) {
          const pill = document.createElement("span");
          pill.className = `no__stock-pill no__stock-pill--${p.stockTone}`;
          pill.textContent = p.stockTone === "out" ? STOCK_LABEL.out : `${STOCK_LABEL[p.stockTone]} ${p.qty}`;
          metaEl.appendChild(pill);
        }
        sub.appendChild(nameEl);
        sub.appendChild(metaEl);
        row.appendChild(sub);

        row.addEventListener("click", () => {
          addOrIncrementItem(p);
          productSearch.value = "";
          productResults.hidden = true;
          productSearch.focus();
        });
        productResults.appendChild(row);
      });
    }
    productResults.hidden = false;
  }
  productSearch.addEventListener("input", () => renderProductResults(productSearch.value));
  document.addEventListener("click", (e) => {
    if (!productResults.hidden && !productResults.contains(e.target as Node) && e.target !== productSearch) {
      productResults.hidden = true;
    }
  });

  function addOrIncrementItem(p: Product) {
    const existing = lineItems.find((i) => i.productId === p.id);
    if (existing) {
      existing.quantity += 1;
    } else {
      lineItems.push({ productId: p.id, sku: p.sku, name: p.name, price: p.price, quantity: 1 });
    }
    renderLineItems();
  }

  function renderLineItems() {
    lineItemsEl.innerHTML = "";
    noItemsEmpty.hidden = lineItems.length > 0;

    lineItems.forEach((item, index) => {
      const row = document.createElement("div");
      row.className = "no__row";

      const nameCell = document.createElement("span");
      nameCell.textContent = item.name;
      nameCell.style.fontWeight = "500";
      row.appendChild(nameCell);

      const stepper = document.createElement("div");
      stepper.className = "no__stepper";
      const decBtn = document.createElement("button");
      decBtn.type = "button";
      decBtn.textContent = "–";
      decBtn.setAttribute("aria-label", `Decrease quantity of ${item.name}`);
      const qtyInput = document.createElement("input");
      qtyInput.type = "text";
      qtyInput.inputMode = "numeric";
      qtyInput.value = String(item.quantity);
      qtyInput.setAttribute("aria-label", `Quantity of ${item.name}`);
      const incBtn = document.createElement("button");
      incBtn.type = "button";
      incBtn.textContent = "+";
      incBtn.setAttribute("aria-label", `Increase quantity of ${item.name}`);

      decBtn.addEventListener("click", () => {
        if (item.quantity > 1) {
          item.quantity -= 1;
          renderLineItems();
        }
      });
      incBtn.addEventListener("click", () => {
        item.quantity += 1;
        renderLineItems();
      });
      qtyInput.addEventListener("change", () => {
        const n = parseInt(qtyInput.value, 10);
        item.quantity = Number.isFinite(n) && n > 0 ? n : 1;
        renderLineItems();
      });

      stepper.append(decBtn, qtyInput, incBtn);
      row.appendChild(stepper);

      const priceCell = document.createElement("span");
      priceCell.className = "no__col-right";
      priceCell.textContent = formatCurrency(item.price);
      row.appendChild(priceCell);

      const totalCell = document.createElement("span");
      totalCell.className = "no__col-right";
      totalCell.style.fontWeight = "500";
      totalCell.textContent = formatCurrency(item.price * item.quantity);
      row.appendChild(totalCell);

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "no__remove-btn";
      removeBtn.setAttribute("aria-label", `Remove ${item.name}`);
      removeBtn.innerHTML =
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg>';
      removeBtn.addEventListener("click", () => {
        lineItems.splice(index, 1);
        renderLineItems();
      });
      row.appendChild(removeBtn);

      lineItemsEl.appendChild(row);
    });

    updateSummary();
    updateSubmitState();
  }

  const itemsSummaryEl = document.querySelector<HTMLSpanElement>("#items-summary")!;
  const summaryItemsEl = document.querySelector<HTMLElement>("#summary-items")!;
  const summarySubtotalEl = document.querySelector<HTMLElement>("#summary-subtotal")!;
  const summaryTotalEl = document.querySelector<HTMLElement>("#summary-total")!;
  const placeOrderLabel = document.querySelector<HTMLSpanElement>("#place-order-label")!;

  function updateSummary() {
    const lineCount = lineItems.length;
    const unitCount = lineItems.reduce((sum, i) => sum + i.quantity, 0);
    const subtotal = lineItems.reduce((sum, i) => sum + i.price * i.quantity, 0);
    const summaryText = `${lineCount} line${lineCount === 1 ? "" : "s"} · ${unitCount} unit${unitCount === 1 ? "" : "s"}`;

    itemsSummaryEl.textContent = summaryText;
    summaryItemsEl.textContent = summaryText;
    summarySubtotalEl.textContent = formatCurrency(subtotal);
    summaryTotalEl.textContent = formatCurrency(subtotal);
    placeOrderLabel.textContent = lineCount > 0 ? `Place order · ${formatCurrency(subtotal)}` : "Place order";
  }

  // --- Submit ---
  const form = document.querySelector<HTMLFormElement>("#new-order-form")!;
  const submitBtn = document.querySelector<HTMLButtonElement>("#place-order-btn")!;
  const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
  const shippingAddressInput = document.querySelector<HTMLInputElement>("#shipping-address")!;

  function updateSubmitState() {
    submitBtn.disabled = lineItems.length === 0 || !selectedCustomerId;
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    messageEl.textContent = "";

    if (!selectedCustomerId) {
      messageEl.textContent = "Select a customer.";
      return;
    }
    if (lineItems.length === 0) {
      messageEl.textContent = "Add at least one item.";
      return;
    }
    if (!shippingAddressInput.value.trim()) {
      messageEl.textContent = "Enter a shipping address.";
      return;
    }

    const paymentMethod = (document.querySelector<HTMLSelectElement>("#payment-method")!.value) as "card" | "upi" | "cash" | "bank_transfer";
    const notes = document.querySelector<HTMLTextAreaElement>("#order-notes")!.value;

    submitBtn.disabled = true;

    const { data, error } = await actions.placeOrder({
      customerId: selectedCustomerId,
      items: lineItems.map((i) => ({ productId: i.productId, quantity: i.quantity })),
      shippingAddress: shippingAddressInput.value.trim(),
      paymentMethod,
      notes: notes || undefined,
    });

    if (error) {
      submitBtn.disabled = false;
      messageEl.textContent = error.message;
      return;
    }

    window.location.href = `/sales/orders/${data!.order.id}?created=1`;
  });

  renderLineItems();

  // --- Theme + sidebar chrome (same pattern as every other Sales screen) ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is now wired up
  // centrally in NavSidebar.astro — see that file's header comment.
</script>
