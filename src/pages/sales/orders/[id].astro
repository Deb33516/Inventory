---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import EmptyState from "../../../components/catalog/EmptyState.astro";
import OrderStatusBadge from "../../../components/orders/OrderStatusBadge.astro";
import OrderLineItems from "../../../components/orders/OrderLineItems.astro";
import OrderStatusActions from "../../../components/orders/OrderStatusActions.astro";
import AppShell from "../../../components/layout/AppShell.astro";

const { id } = Astro.params;
const created = Astro.url.searchParams.get("created");

const viewerRole = Astro.locals.role;
const canDirectCancel = viewerRole === "super_admin";
const canRequestRefund = viewerRole === "sales_staff" || viewerRole === "admin";

const { data: order } = await Astro.locals.supabase
  .from("orders")
  .select("id, status, subtotal, tax, shipping_fee, total, shipping_address, notes, created_at, customer_id")
  .eq("id", id)
  .maybeSingle();

if (!order) {
  Astro.response.status = 404;
}

const { data: customer } = order
  ? await Astro.locals.supabase.from("profiles").select("full_name").eq("id", order.customer_id).maybeSingle()
  : { data: null };

const { data: items } = order
  ? await Astro.locals.supabase
      .from("order_items")
      .select("id, quantity, unit_price, subtotal, products(sku, name)")
      .eq("order_id", id)
  : { data: null };

const { data: payment } = order
  ? await Astro.locals.supabase
      .from("payments")
      .select("id, status, method, paid_at")
      .eq("order_id", id)
      .maybeSingle()
  : { data: null };

const canShowRefundControl = canRequestRefund && order?.status === "cancelled" && payment?.status === "paid";
---

<BaseLayout title={order ? `Order ${order.id.slice(0, 8)} — Sales` : "Order not found — Sales"}>
  <AppShell active="sales" backHref="/sales/orders" backLabel="Orders">
    {
      order ? (
        <>
          {created && (
            <p class="mb-md text-sm text-success" role="status">
              Order created.
            </p>
          )}
          <div class="flex items-center justify-between flex-wrap gap-md">
            <div>
              <h1 class="text-2xl font-bold text-ink">Order {order.id.slice(0, 8)}</h1>
              <p class="text-sm text-muted">
                {customer?.full_name ?? "Unknown customer"} · {new Date(order.created_at).toLocaleString()}
              </p>
              <a href={`/crm/customers/${order.customer_id}`} class="text-xs text-primary font-bold">
                View customer in CRM
              </a>
            </div>
            <OrderStatusBadge status={order.status} />
          </div>

          <Card class="mt-lg">
            <OrderLineItems
              items={items ?? []}
              subtotal={order.subtotal}
              tax={order.tax}
              shippingFee={order.shipping_fee}
              total={order.total}
            />
          </Card>

          <Card class="mt-lg">
            <p class="text-xs uppercase tracking-[0.5px] text-muted">Payment</p>
            <p class="mt-xs text-sm text-body capitalize">
              {payment?.method ?? "—"} — {payment?.status ?? "—"}
            </p>
            {
              canShowRefundControl && (
                <div class="mt-md" id="refund-control" data-payment-id={payment!.id}>
                  <button
                    type="button"
                    id="request-refund-btn"
                    class="h-12 px-lg bg-canvas text-error border border-error font-bold text-sm"
                  >
                    Request refund
                  </button>
                  <p id="refund-message" class="mt-xs text-sm" role="status" />
                </div>
              )
            }
          </Card>

          <div class="mt-lg">
            <OrderStatusActions
              orderId={order.id}
              status={order.status}
              viewerRole="staff"
              canDirectCancel={canDirectCancel}
            />
          </div>
        </>
      ) : (
        <EmptyState title="Order not found" />
      )
    }
  </AppShell>
</BaseLayout>

<script>
  import { actions } from "astro:actions";

  const control = document.querySelector<HTMLDivElement>("#refund-control");
  const button = document.querySelector<HTMLButtonElement>("#request-refund-btn");
  const messageEl = document.querySelector<HTMLParagraphElement>("#refund-message");

  if (control && button && messageEl) {
    const paymentId = control.dataset.paymentId!;

    button.addEventListener("click", async () => {
      const reason = window.prompt("Reason for requesting a refund:") ?? "";
      if (!reason.trim()) return;

      button.disabled = true;
      messageEl.textContent = "";
      messageEl.classList.remove("text-error", "text-success");

      const { error } = await actions.requestApproval({
        actionType: "refund_payment",
        targetTable: "payments",
        targetId: paymentId,
        reason,
      });

      if (error) {
        button.disabled = false;
        messageEl.textContent = error.message;
        messageEl.classList.add("text-error");
        return;
      }

      messageEl.textContent = "Refund request submitted.";
      messageEl.classList.add("text-success");
      button.remove();
    });
  }
</script>
