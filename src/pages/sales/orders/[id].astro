  /* Print: a clean order-only document. Screen layout above is completely
     unaffected — everything here is scoped to @media print. Hides the
     sidebar, top nav/breadcrumb/search, back link, status-action buttons,
     the visual status tracker (redundant with the header's own status
     pill, which stays), refund control, and the order-notes card (not
     part of the requested print field set) — leaving only real order
     data: number, date, customer name, status/payment pills, line items,
     totals, and shipping address. */
  @media print {
    :global(.navtop) {
      display: none !important;
    }
    .sd__sidebar,
    .sd__backdrop {
      display: none !important;
    }
    .sod__no-print {
      display: none !important;
    }
    .sd {
      display: block;
      background: #fff;
      color: #000;
      min-height: 0;
    }
    .sd__panel {
      margin: 0;
      border: none;
      box-shadow: none;
      border-radius: 0;
      overflow: visible;
    }
    .sod__main {
      padding: 0;
      gap: 12px;
    }
    .sod__topbar {
      gap: 6px;
    }
    .sod__body {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
