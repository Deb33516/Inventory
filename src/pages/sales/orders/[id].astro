      width: 100%;
    }
    .sod__panel-card,
    .sod__side-card {
      box-shadow: none;
      border: 1px solid #ccc;
      break-inside: avoid;
    }
    .sod__panel-card {
      overflow-x: visible;
    }
    .sod__panel-head,
    .sod__grid,
    .sod__totals {
      min-width: 0;
    }
