    box-sizing: border-box;
    padding: 14px 16px;
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    background: var(--sd-card);
    box-shadow: var(--sd-shadow);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .so__stat-label {
    font-size: 13px;
    color: var(--sd-muted-fg);
