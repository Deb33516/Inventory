---
// Literal recreation of the Claude Design canvas's Sales Orders screen
// (project/SalesOrders.dc.html -> NavSidebar + NavTop + PageOrders with
// role="sales") — the supplied design is the visual source of truth, not
// the app's existing DESIGN.md/AppShell component system. Reuses the same
// --sd-* token system + NavSidebar.astro/NavTop.astro already established
// by the approved Sales Dashboard/Contacts screens (neither touched this
// turn). FilterChip/EmptyState/OrderStatusBadge/AppShell are NOT reused
// here (their visual output doesn't match this artboard) — every value
// below comes from the same real, unchanged orders/order_items/payments/
// profiles tables and the same real status-filter + customer-name-search
// query params the existing /sales/orders route already supported before
// this pass (search extended to also match the order id prefix, matching
// the design's own placeholder text — not a new capability, the same
// ilike-style substring match just applied to a second real field).
//
// Real vs deferred/fabricated, per your explicit no-fabrication rules:
//  - Real: order id (truncated UUID, same display convention as every
//    other order screen), customer name (profiles, staff-authorized via
//    the existing two-query pattern — orders has two FKs to profiles so a
//    single embed would be ambiguous), real date, real item count
//    (order_items(count), same genuine embedded-aggregate pattern already
//    used on /account/orders), real total, real payment status (payments
//    table, embedded per-order — one payment row per order since
//    place_order() is the only insert path), real fulfilment status
//    across the FULL real 7-value order_status enum (not just the
//    design's 6 example rows — pending/confirmed/processing/shipped/
//    delivered/cancelled/refunded all have their own tab), real tab
//    counts (store-wide, unfiltered by search), real "New order" link to
//    the existing /sales/orders/new route, real "View" link to the
//    existing /sales/orders/[id] route (unmodified, out of scope this
//    turn).
//  - Title/subtitle: the design's sales-branch copy ("My orders" / "Orders
//    for your accounts · 14 this month") frames orders as personally
//    owned. orders.placed_by is an audit/process field, not sales-rep
//    attribution, and sales_staff sees the same store-wide order set as
//    admin (orders_select_staff has no per-rep scoping) — so this page
//    uses the design's own ADMIN-branch framing instead ("Orders" / "Every
//    customer order · {N} this month"), which is what the real access
//    model actually matches.
//  - Stat strip: the design's sales-branch cards ("My orders · September" /
//    "Pending" / "Unpaid" / "Delivered") are personal-framed and use
//    invented note text ("1 waiting on stock", "3 orders"). Kept the same
//    4-slot structure but every value/note is real and store-wide: Orders
//    this month (real count + real ₹ booked, excluding cancelled — same
//    exclusion convention as dashboard_revenue_trend), Pending (real
//    current count), Unpaid (real ₹ sum + real count of orders whose
//    payment status is pending/failed — "partly paid" is not a real
//    payment_status value and was dropped), Delivered this month (real
//    count — this slot needed no substitution).
//  - "Export" button: admin-only in the design's own isAdmin gate — sales
//    role never sees it there either, so omitting it matches the artboard
//    exactly, not a deviation.
//  - "Payment"/"Date" dashed facet buttons and the grid/list "View"
//    toggle: no filter-picker or view-mode capability exists anywhere in
//    this app — omitted rather than shown as dead buttons.
//  - "Delivery" column (due dates like "Due 2 Oct"/"After 3 Oct"): no
//    delivery-date/ETA field exists anywhere in the schema — omitted
//    entirely, per your explicit no-fabricated-ETA rule.
//  - Row select-all checkboxes + bulk "Mark as shipped": the bulk action
//    itself is admin-only in the design's own isAdmin gate (sales never
//    sees it), so the unconditional per-row checkboxes would be pure dead
//    UI for this role with nothing real bound to a selection — omitted
//    entirely rather than shown as non-functional chrome.
//  - Row "..." actions menu: no per-row action menu exists anywhere in
//    this app — replaced with the same plain "View" link convention
//    already used on /account/orders and /crm/customers.
//  - "Sales rep" column + rep initials/avatar: admin-only in the design's
//    own isAdmin gate (sales never sees it) — matches the artboard exactly,
//    and also would have been disallowed as personal-rep attribution
//    either way.
//  - Pagination footer ("Rows per page 9" / "Page 1 of 2" / prev/next): no
//    pagination exists on this list today — same as /account/orders,
//    replaced with a real "{N} orders" count only rather than fake page
//    controls.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NavSidebar from "../../../components/staff/NavSidebar.astro";
import NavTop from "../../../components/staff/NavTop.astro";
import type { OrderStatus } from "../../../lib/types";

const url = Astro.url;
const status = url.searchParams.get("status") ?? "";
const search = url.searchParams.get("search")?.trim() ?? "";

// --- Real, unfiltered-by-status order set (status/search applied in JS so
// the same fetch can also produce real store-wide tab counts) ---
const { data: orderRows } = await Astro.locals.supabase
  .from("orders")
  .select("id, customer_id, status, total, created_at, order_items(count), payments(status)")
  .order("created_at", { ascending: false });

const orders = orderRows ?? [];

const customerIds = [...new Set(orders.map((o) => o.customer_id))];
const { data: customers } =
  customerIds.length > 0
    ? await Astro.locals.supabase.from("profiles").select("id, full_name").in("id", customerIds)
    : { data: [] };
const nameById = new Map((customers ?? []).map((c) => [c.id, c.full_name ?? "Unnamed customer"]));

type PaymentEmbed = { status: string }[] | { status: string } | null;
function paymentStatusOf(row: { payments: PaymentEmbed }): string | null {
  const p = row.payments as unknown as { status: string }[] | null;
  return p?.[0]?.status ?? null;
}

const ALL_STATUSES: OrderStatus[] = ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled", "refunded"];
const statusCounts = new Map<string, number>(ALL_STATUSES.map((s) => [s, 0]));
for (const o of orders) statusCounts.set(o.status, (statusCounts.get(o.status) ?? 0) + 1);

const filtered = orders.filter((o) => {
  if (status && o.status !== status) return false;
  if (!search) return true;
  const needle = search.toLowerCase();
  return (nameById.get(o.customer_id) ?? "").toLowerCase().includes(needle) || o.id.toLowerCase().startsWith(needle);
});

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(value);
const formatCompact = (value: number) => {
  if (value >= 10000000) return `₹${(value / 10000000).toFixed(1)}Cr`;
  if (value >= 100000) return `₹${(value / 100000).toFixed(1)}L`;
  return formatCurrency(value);
};

function buildUrl(overrides: Record<string, string | undefined>) {
  const next = new URLSearchParams(url.search);
  for (const [key, value] of Object.entries(overrides)) {
    if (value) next.set(key, value);
    else next.delete(key);
  }
  const qs = next.toString();
  return qs ? `/sales/orders?${qs}` : "/sales/orders";
}

const TABS: { key: string; label: string }[] = [
  { key: "", label: "All" },
  { key: "pending", label: "Pending" },
  { key: "confirmed", label: "Confirmed" },
  { key: "processing", label: "Processing" },
  { key: "shipped", label: "Shipped" },
  { key: "delivered", label: "Delivered" },
  { key: "cancelled", label: "Cancelled" },
  { key: "refunded", label: "Refunded" },
];

const STATUS_TONE: Record<OrderStatus, "outline" | "warn" | "info" | "success" | "muted"> = {
  pending: "outline",
  confirmed: "warn",
  processing: "warn",
  shipped: "info",
  delivered: "success",
  cancelled: "muted",
  refunded: "muted",
};
const STATUS_LABEL: Record<OrderStatus, string> = {
  pending: "Pending",
  confirmed: "Confirmed",
  processing: "Processing",
  shipped: "Shipped",
  delivered: "Delivered",
  cancelled: "Cancelled",
  refunded: "Refunded",
};
const PAY_TONE: Record<string, "success" | "warn" | "danger" | "muted"> = {
  paid: "success",
  pending: "warn",
  failed: "danger",
  refunded: "muted",
};
const PAY_LABEL: Record<string, string> = {
  paid: "Paid",
  pending: "Unpaid",
  failed: "Failed",
  refunded: "Refunded",
};

// --- Real store-wide stat strip (independent of the current search/status filter) ---
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const nowIstShifted = new Date(Date.now() + IST_OFFSET_MS);
const istYear = nowIstShifted.getUTCFullYear();
const istMonth = nowIstShifted.getUTCMonth();
const thisMonthFromUtc = new Date(Date.UTC(istYear, istMonth, 1) - IST_OFFSET_MS);
const nextMonthFromUtc = new Date(Date.UTC(istYear, istMonth + 1, 1) - IST_OFFSET_MS);
const monthLabel = new Date(Date.UTC(istYear, istMonth, 1)).toLocaleDateString(undefined, { month: "long", timeZone: "UTC" });

const ordersThisMonth = orders.filter((o) => {
  const t = new Date(o.created_at);
  return t >= thisMonthFromUtc && t < nextMonthFromUtc;
});
const bookedThisMonth = ordersThisMonth.filter((o) => o.status !== "cancelled").reduce((sum, o) => sum + o.total, 0);
const pendingCount = statusCounts.get("pending") ?? 0;
const deliveredThisMonthCount = ordersThisMonth.filter((o) => o.status === "delivered").length;

const unpaidOrders = orders.filter((o) => {
  const ps = paymentStatusOf(o);
  return ps === "pending" || ps === "failed";
});
const unpaidTotal = unpaidOrders.reduce((sum, o) => sum + o.total, 0);

const stats = [
  { label: `Orders · ${monthLabel}`, value: String(ordersThisMonth.length), note: `${formatCompact(bookedThisMonth)} booked` },
  { label: "Pending", value: String(pendingCount), note: "awaiting confirmation" },
  { label: "Unpaid", value: formatCompact(unpaidTotal), note: `${unpaidOrders.length} order${unpaidOrders.length === 1 ? "" : "s"}` },
  { label: "Delivered", value: String(deliveredThisMonthCount), note: "this month" },
];
---

<BaseLayout title="Orders — Sales">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  </Fragment>

  <div class="sd" id="sd-root">
    <div id="sd-sidebar-backdrop" class="sd__backdrop"></div>

    <div id="sd-sidebar" class="sd__sidebar">
      <NavSidebar active="Orders" />
    </div>

    <div class="sd__panel">
      <NavTop section="Selling" page="Orders" searchAction="/sales/orders" searchName="search" searchValue={search} searchPlaceholder="Filter by order no. or customer…" />

      <main id="main-content" class="so__main">
        <div class="so__header">
          <div class="so__heading-col">
            <h1>Orders</h1>
            <span class="so__meta">Every customer order · {orders.length} total</span>
          </div>
          <a href="/sales/orders/new" class="so__new-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
            New order
          </a>
        </div>

        <div class="so__stats">
          {stats.map((s) => (
            <div class="so__stat-card">
              <span class="so__stat-label">{s.label}</span>
              <div class="so__stat-body">
                <span class="so__stat-value">{s.value}</span>
                <span class="so__stat-note">{s.note}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="so__toolbar">
          <div role="tablist" aria-label="Fulfilment status" class="so__tabs">
            {TABS.map((t) => (
              <a href={buildUrl({ status: t.key || undefined })} role="tab" aria-selected={status === t.key} class={status === t.key ? "is-active" : ""}>
                {t.label} <span class="so__tab-count">{t.key ? (statusCounts.get(t.key) ?? 0) : orders.length}</span>
              </a>
            ))}
          </div>
        </div>

        {
          filtered.length > 0 ? (
            <div class="so__panel">
              <div class="so__grid so__grid-head">
                <span>Order</span>
                <span>Customer</span>
                <span>Date</span>
                <span class="so__col-right">Items</span>
                <span class="so__col-right">Total</span>
                <span>Payment</span>
                <span>Fulfilment</span>
                <span></span>
              </div>
              {filtered.map((o) => (
                <div class="so__grid so__row">
                  <a href={`/sales/orders/${o.id}`} class="so__id-link">{o.id.slice(0, 8)}</a>
                  <span class="so__ellipsis">{nameById.get(o.customer_id) ?? "—"}</span>
                  <span class="so__muted-cell">{new Date(o.created_at).toLocaleDateString()}</span>
                  <span class="so__col-right so__muted-cell">{o.order_items?.[0]?.count ?? 0}</span>
                  <span class="so__col-right so__total">{formatCurrency(o.total)}</span>
                  <span>
                    {(() => {
                      const ps = paymentStatusOf(o) ?? "pending";
                      return <span class={`so__pill so__pill--${PAY_TONE[ps] ?? "muted"}`}>{PAY_LABEL[ps] ?? ps}</span>;
                    })()}
                  </span>
                  <span>
                    <span class={`so__pill so__pill--${STATUS_TONE[o.status as OrderStatus] ?? "muted"}`}>{STATUS_LABEL[o.status as OrderStatus] ?? o.status}</span>
                  </span>
                  <a href={`/sales/orders/${o.id}`} class="so__view-link">View</a>
                </div>
              ))}
              <div class="so__panel-footer">{filtered.length} order{filtered.length === 1 ? "" : "s"}</div>
            </div>
          ) : (
            <div class="so__empty">
              <p class="so__empty-title">No orders found</p>
              <p class="so__empty-body">Try a different search or status.</p>
            </div>
          )
        }
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .sd {
    --sd-shell: #fafafa;
    --sd-panel: #ffffff;
    --sd-card: #ffffff;
    --sd-fg: #0a0a0a;
    --sd-fg2: #404040;
    --sd-muted: #f5f5f5;
    --sd-muted-fg: #737373;
    --sd-border: #e5e5e5;
    --sd-input: #e5e5e5;
    --sd-primary: #171717;
    --sd-primary-fg: #fafafa;
    --sd-success-bg: #ecfdf3;
    --sd-success-fg: #15803d;
    --sd-warn-bg: #fef3e2;
    --sd-warn-fg: #9a3412;
    --sd-danger-bg: #feecec;
    --sd-danger-fg: #b91c1c;
    --sd-info-bg: #eef2ff;
    --sd-info-fg: #3538cd;
    --sd-accent: #2b50e0;
    --sd-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    color-scheme: light;

    min-height: 100vh;
    display: flex;
    background: var(--sd-shell);
    color: var(--sd-fg);
    font-family: "Geist", system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .sd[data-theme="dark"] {
    --sd-shell: #0a0a0a;
    --sd-panel: #0f0f0f;
    --sd-card: #171717;
    --sd-fg: #fafafa;
    --sd-fg2: #d4d4d4;
    --sd-muted: #262626;
    --sd-muted-fg: #a3a3a3;
    --sd-border: #262626;
    --sd-input: #363636;
    --sd-primary: #fafafa;
    --sd-primary-fg: #171717;
    --sd-success-bg: #0f2a1c;
    --sd-success-fg: #4ade80;
    --sd-warn-bg: #2e1f0e;
    --sd-warn-fg: #fdba74;
    --sd-danger-bg: #2d1414;
    --sd-danger-fg: #f87171;
    --sd-info-bg: #1e2240;
    --sd-info-fg: #a5b4fc;
    --sd-accent: #6b8afb;
    --sd-shadow: none;
    color-scheme: dark;
  }
  .sd__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 20;
  }
  .sd__sidebar {
    height: 100vh;
    position: sticky;
    top: 0;
  }
  @media (max-width: 1023px) {
    .sd__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 30;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .sd__sidebar.is-open {
      transform: translateX(0);
    }
    .sd__backdrop.is-open {
      display: block;
    }
  }
  .sd__panel {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin: 8px 8px 8px 0;
    background: var(--sd-panel);
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--sd-shadow);
  }
  @media (max-width: 1023px) {
    .sd__panel {
      margin: 8px;
    }
  }

  .so__main {
    flex-grow: 1;
    box-sizing: border-box;
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .so__main {
      padding: 16px;
    }
  }

  .so__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 12px;
  }
  .so__heading-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .so__heading-col h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .so__meta {
    font-size: 14px;
    color: var(--sd-muted-fg);
  }
  .so__new-btn {
    height: 36px;
    box-sizing: border-box;
    padding: 0 14px;
    border-radius: 8px;
    background: var(--sd-primary);
    color: var(--sd-primary-fg);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: flex;
    align-items: center;
