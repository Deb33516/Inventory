---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthSplitLayout from "../components/auth/AuthSplitLayout.astro";
import Input from "../components/ui/Input.astro";
import Button from "../components/ui/Button.astro";

if (Astro.locals.user) {
  return Astro.redirect("/account");
}

const redirectParam = Astro.url.searchParams.get("redirect");
// Only ever redirect back to a same-app path — never an absolute/external
// URL. Empty (not "/account") when absent: an explicit ?redirect= must win
// over the role-aware destination the signIn action computes, and the only
// way to express "no explicit redirect was requested" is to not default it
// here at all.
const explicitRedirect = redirectParam && redirectParam.startsWith("/") ? redirectParam : "";

const errorParam = Astro.url.searchParams.get("error");
const resetParam = Astro.url.searchParams.get("reset");

let notice = "";
let noticeTone: "error" | "success" | "" = "";

if (errorParam === "invalid_link") {
  notice = "That link is invalid or has expired. Please request a new one.";
  noticeTone = "error";
} else if (resetParam === "1") {
  notice = "Your password has been updated. Sign in with your new password.";
  noticeTone = "success";
}
---

<BaseLayout title="Sign in — Inventory">
  <AuthSplitLayout formTitle="Sign in">
    <p class="text-sm font-light text-body">Use your account email. We'll take you to the dashboard for your role.</p>

    {
      notice && (
        <p
          class={`mt-md text-sm ${noticeTone === "error" ? "text-error" : "text-success"}`}
          role="status"
        >
          {notice}
        </p>
      )
    }

    <form id="login-form" class="mt-lg space-y-md" data-redirect-to={explicitRedirect}>
      <Input label="Email" name="email" type="email" autocomplete="email" required />
      <Input
        label="Password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
      />
      <p id="form-message" class="text-sm" role="status"></p>
      <Button type="submit" variant="primary" class="w-full">Sign in</Button>
    </form>

    <div class="mt-lg flex items-center justify-between text-sm">
      <a href="/forgot-password" class="text-primary font-bold">Forgot password?</a>
      <a href="/register" class="text-body">Create an account</a>
    </div>
  </AuthSplitLayout>
</BaseLayout>

<script>
  // Not using `define:vars` here: it forces this script to be inlined as
  // a plain non-module tag, and a static `import` is a SyntaxError outside
  // a module context — confirmed against this project's own compiled
  // production output. Server-rendered values that used to be injected via
  // define:vars are instead read off the form's dataset, so this stays a
  // normal, properly bundled module script with "astro:actions" resolved
  // correctly by Vite.
  import { actions } from "astro:actions";

  const form = document.querySelector("#login-form");
  const messageEl = document.querySelector("#form-message");
  const button = form.querySelector("button[type=submit]");
  const explicitRedirect = form.dataset.redirectTo;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    button.disabled = true;
    messageEl.textContent = "";
    messageEl.classList.remove("text-error", "text-success");

    const { data, error } = await actions.signIn(new FormData(form));

    if (error) {
      button.disabled = false;
      messageEl.textContent = error.message;
      messageEl.classList.add("text-error");
      return;
    }

    // An explicit ?redirect= always wins; otherwise use the role-aware
    // destination the signIn action just computed server-side.
    window.location.href = explicitRedirect || data.redirectTo;
  });
</script>
