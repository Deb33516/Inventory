---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthSplitLayout from "../components/auth/AuthSplitLayout.astro";
import Input from "../components/ui/Input.astro";
import Button from "../components/ui/Button.astro";

if (Astro.locals.user) {
  return Astro.redirect("/account");
}
---

<BaseLayout title="Forgot password — Inventory">
  <AuthSplitLayout formTitle="Forgot your password?">
    <a href="/login" class="inline-flex items-center gap-xs text-sm font-bold text-muted hover:text-ink">← Back to sign in</a>
    <p class="mt-md text-sm font-light text-body">
      Enter the email you sign in with. We'll send you a link to set a new password.
    </p>

    <form id="forgot-form" class="mt-lg space-y-md">
      <Input label="Email" name="email" type="email" autocomplete="email" required />
      <p id="form-message" class="text-sm" role="status"></p>
      <Button type="submit" variant="primary" class="w-full">Send reset link</Button>
    </form>

    <p class="mt-lg text-xs text-muted leading-relaxed">
      If an account exists for this email, the link arrives within a few minutes and stays valid for a limited time.
      Check your spam folder if you don't see it.
    </p>
  </AuthSplitLayout>
</BaseLayout>

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#forgot-form")!;
  const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    button.disabled = true;
    messageEl.textContent = "";
    messageEl.classList.remove("text-error", "text-success");

    const { data, error } = await actions.requestPasswordReset(new FormData(form));

    button.disabled = false;

    if (error) {
      messageEl.textContent = error.message;
      messageEl.classList.add("text-error");
      return;
    }

    form.reset();
    messageEl.textContent = data.message;
    messageEl.classList.add("text-success");
  });
</script>
