---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/ui/Card.astro";
import Input from "../components/ui/Input.astro";
import Button from "../components/ui/Button.astro";

if (Astro.locals.user) {
  return Astro.redirect("/account");
}
---

<BaseLayout title="Reset your password — Inventory">
  <main id="main-content" class="min-h-screen flex items-center justify-center bg-surface-soft px-md py-xxl">
    <Card class="w-full max-w-md">
      <a href="/" class="text-sm font-bold text-ink hover:text-primary">← Inventory</a>
      <h1 class="mt-md text-2xl font-bold text-ink">Reset your password</h1>
      <p class="mt-xs text-sm font-light text-body">
        Enter your email and we'll send you a link to reset your password.
      </p>

      <form id="forgot-form" class="mt-lg space-y-md">
        <Input label="Email" name="email" type="email" autocomplete="email" required />
        <p id="form-message" class="text-sm" role="status"></p>
        <Button type="submit" variant="primary" class="w-full">Send reset link</Button>
      </form>

      <p class="mt-lg text-sm text-body">
        <a href="/login" class="text-primary font-bold">Back to sign in</a>
      </p>
    </Card>
  </main>
</BaseLayout>

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#forgot-form")!;
  const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    button.disabled = true;
    messageEl.textContent = "";
    messageEl.classList.remove("text-error", "text-success");

    const { data, error } = await actions.requestPasswordReset(new FormData(form));

    button.disabled = false;

    if (error) {
      messageEl.textContent = error.message;
      messageEl.classList.add("text-error");
      return;
    }

    form.reset();
    messageEl.textContent = data.message;
    messageEl.classList.add("text-success");
  });
</script>
