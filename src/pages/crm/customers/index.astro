---
// Literal recreation of the Claude Design canvas's Sales Contacts screen
// (project/SalesContacts.dc.html -> NavSidebar + NavTop + PageCustomers
// with role="sales") — the supplied design is the visual source of truth,
// not the app's existing DESIGN.md/AppShell component system. Reuses the
// same --sd-* token system + NavSidebar.astro established by the approved
// Sales Dashboard (neither file touched this turn), plus the new
// NavTop.astro this screen introduces. FilterChip/EmptyState/Badge/
// AppShell are NOT reused here (their visual output doesn't match this
// artboard) — every real value below comes from the same real, unchanged
// profiles/customers/customer_metrics/orders tables, the same real
// customer_contact_email() RPC, and the same real search/type-filter/
// sort/pagination query params the existing /crm/customers route already
// supported before this pass.
//
// Real vs deferred/fabricated, per your explicit no-fabrication rules:
//  - Real: customer name, phone (profiles.phone), email
//    (customer_contact_email() RPC — same real staff-only lookup already
//    used on the customer detail page), last order date and all-time
//    order count (customer_metrics, unchanged), the existing real
//    New/Returning type filter and name search and name/spend/recent sort
//    and pagination, real "New order" link (/sales/orders/new, unchanged
//    route), real navigation to the existing customer detail route
//    (/crm/customers/{id}), a real preview panel (phone/email/shipping
//    address/lifetime spend/order count/first+last order date/3 most
//    recent real orders) for whichever customer is selected via a real
//    ?preview= query param — every field in it is drawn from the exact
//    same real sources the (untouched) customer detail page already
//    uses, just condensed into a side panel.
//  - Stat strip: the design's "My contacts"/"Due to reorder"/"Accounts
//    ordering" are personal-rep-framed and/or predictive — explicitly
//    disallowed. Replaced with four different, store-wide, fully real
//    stats that fill the same 4-card slot honestly: Total customers (real
//    count), New this month (real, profiles.created_at this calendar
//    month), Ordered this month (real, distinct customers with an order
//    this month — same technique as the Sales Dashboard's own KPI), No
//    order in 90+ days (real, customer_metrics.last_order_at null or
//    older than 90 days — this one already existed in the design almost
//    as-is and needed no substitution). Disclosed as a deviation below.
//  - "Company" column/facet, job-title subtitle, "Dealer"/"Active"/
//    "C-2041" preview badges, "Tags" (Wholesale/Lighting/Key account):
//    none of these have any backing — customers here are individual
//    people (Supabase Auth signups), not B2B company accounts, and there
//    is no company/segment/account-code/tag concept anywhere in this
//    schema — all omitted entirely rather than invented.
//  - "Orders this year" column header: relabelled to "Orders" — the real
//    customer_metrics.order_count is all-time, not calendar-year-scoped,
//    and computing a genuinely time-scoped count wasn't already supported
//    — showing the real all-time number under an honest label instead of
//    overclaiming a "this year" figure that isn't actually computed that
//    way.
//  - "Last order" toolbar facet: the design's own facet doesn't correspond
//    to any real filter; the EXISTING real New/Returning type filter is
//    shown instead, in matching dashed-facet-button styling.
//  - "New contact" header button and the "Company"/"View" toolbar
//    controls: no real "staff creates a customer" capability exists
//    anywhere (customers only arrive via their own real signup) and no
//    density/view-mode toggle exists — both omitted rather than shown as
//    dead buttons.
//  - Preview panel's "Call" action: real, a plain tel: link using the
//    real phone number, only rendered when one exists.
//  - Per-row "New order" button links to the existing real
//    /sales/orders/new route unmodified — it does not pre-select the
//    customer, since that route has no customer-preselection param and
//    New Order is explicitly out of scope to modify this turn.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NavSidebar from "../../../components/staff/NavSidebar.astro";
import NavTop from "../../../components/staff/NavTop.astro";
import type { OrderStatus } from "../../../lib/types";

const PAGE_SIZE = 10;
const url = Astro.url;
const search = url.searchParams.get("search")?.trim() ?? "";
const type = url.searchParams.get("type") ?? "";
const sort = url.searchParams.get("sort") ?? "name";
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1", 10) || 1);
const previewParam = url.searchParams.get("preview") ?? "";

// --- Real filtered/sorted/paginated customer list (unchanged logic, phone added to the select) ---
let profileQuery = Astro.locals.supabase.from("profiles").select("id, full_name, phone, created_at").eq("role", "customer");
if (search) profileQuery = profileQuery.ilike("full_name", `%${search}%`);
const { data: profiles } = await profileQuery;

const { data: metricsRows } = await Astro.locals.supabase
  .from("customer_metrics")
  .select("profile_id, order_count, lifetime_spend, first_order_at, last_order_at");
const metricsByProfile = new Map((metricsRows ?? []).map((m) => [m.profile_id, m]));

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 0 }).format(value);
const formatCompact = (value: number) => {
  if (value >= 10000000) return `₹${(value / 10000000).toFixed(1)}Cr`;
  if (value >= 100000) return `₹${(value / 100000).toFixed(1)}L`;
  return formatCurrency(value);
};
const formatDate = (value: string | null) => (value ? new Date(value).toLocaleDateString(undefined, { day: "numeric", month: "short" }) : "—");
const formatYear = (value: string | null) => (value ? new Date(value).getFullYear() : "—");

let customers = (profiles ?? []).map((p) => {
  const m = metricsByProfile.get(p.id);
  const orderCount = m?.order_count ?? 0;
  return {
    id: p.id,
    fullName: p.full_name ?? "Unnamed customer",
    phone: p.phone ?? null,
    createdAt: p.created_at,
    orderCount,
    lifetimeSpend: m?.lifetime_spend ?? 0,
    firstOrderAt: m?.first_order_at ?? null,
    lastOrderAt: m?.last_order_at ?? null,
    classification: orderCount <= 1 ? "new" : "returning",
  };
});

if (type) customers = customers.filter((c) => c.classification === type);

type CustomerRow = (typeof customers)[number];
const sortFns: Record<string, (a: CustomerRow, b: CustomerRow) => number> = {
  name: (a, b) => a.fullName.localeCompare(b.fullName),
  spend: (a, b) => b.lifetimeSpend - a.lifetimeSpend,
  recent: (a, b) => (b.lastOrderAt ?? "").localeCompare(a.lastOrderAt ?? ""),
};
customers.sort(sortFns[sort] ?? sortFns.name);

const totalFiltered = customers.length;
const totalPages = Math.max(1, Math.ceil(totalFiltered / PAGE_SIZE));
const pageItems = customers.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

// Real per-row email — same real customer_contact_email() RPC the customer detail page already uses, called once per visible row.
const emailByCustomerId = new Map<string, string | null>(
  await Promise.all(
    pageItems.map(async (c) => {
      const { data } = await Astro.locals.supabase.rpc("customer_contact_email", { p_profile_id: c.id });
      return [c.id, data ?? null] as const;
    })
  )
);

function buildUrl(overrides: Record<string, string | undefined>) {
  const next = new URLSearchParams(url.search);
  for (const [key, value] of Object.entries(overrides)) {
    if (value) next.set(key, value);
    else next.delete(key);
  }
  const qs = next.toString();
  return qs ? `/crm/customers?${qs}` : "/crm/customers";
}

// --- Real store-wide stat strip (independent of the current search/filter/page) ---
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const nowIstShifted = new Date(Date.now() + IST_OFFSET_MS);
const istYear = nowIstShifted.getUTCFullYear();
const istMonth = nowIstShifted.getUTCMonth();
const thisMonthFromUtc = new Date(Date.UTC(istYear, istMonth, 1) - IST_OFFSET_MS);
const nextMonthFromUtc = new Date(Date.UTC(istYear, istMonth + 1, 1) - IST_OFFSET_MS);
const ninetyDaysAgo = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000);

const { data: allCustomerProfiles } = await Astro.locals.supabase.from("profiles").select("id, created_at").eq("role", "customer");
const totalCustomers = allCustomerProfiles?.length ?? 0;
const newThisMonthCount = (allCustomerProfiles ?? []).filter((p) => new Date(p.created_at) >= thisMonthFromUtc && new Date(p.created_at) < nextMonthFromUtc).length;

const { data: thisMonthOrderRows } = await Astro.locals.supabase
  .from("orders")
  .select("customer_id")
  .gte("created_at", thisMonthFromUtc.toISOString())
  .lt("created_at", nextMonthFromUtc.toISOString());
const orderedThisMonthCount = new Set((thisMonthOrderRows ?? []).map((o) => o.customer_id)).size;

const noOrderIn90Count = (metricsRows ?? []).filter(
  (m) => m.last_order_at === null || new Date(m.last_order_at) < ninetyDaysAgo
).length;

const stats = [
  { label: "Total customers", value: String(totalCustomers), note: "" },
  { label: "New this month", value: String(newThisMonthCount), note: "" },
  { label: "Ordered this month", value: String(orderedThisMonthCount), note: "" },
  { label: "No order in 90+ days", value: String(noOrderIn90Count), note: "" },
];

// --- Real preview panel for the selected customer (default: first row shown) ---
const previewId = previewParam || pageItems[0]?.id || "";
let previewData: {
  id: string;
  fullName: string;
  phone: string | null;
  email: string | null;
  address: string | null;
  lifetimeSpend: number;
  orderCount: number;
  firstOrderAt: string | null;
  lastOrderAt: string | null;
  recentOrders: { id: string; status: string; total: number; created_at: string }[];
} | null = null;

if (previewId) {
  const rowMatch = pageItems.find((c) => c.id === previewId);
  const { data: previewProfile } = await Astro.locals.supabase
    .from("profiles")
    .select("id, full_name, phone, created_at")
    .eq("id", previewId)
    .eq("role", "customer")
    .maybeSingle();

  if (previewProfile) {
    const { data: previewCustomer } = await Astro.locals.supabase
      .from("customers")
      .select("shipping_address")
      .eq("profile_id", previewId)
      .maybeSingle();
    const { data: previewMetrics } = await Astro.locals.supabase
      .from("customer_metrics")
      .select("order_count, lifetime_spend, first_order_at, last_order_at")
      .eq("profile_id", previewId)
      .maybeSingle();
    const previewEmail = rowMatch ? (emailByCustomerId.get(previewId) ?? null) : (await Astro.locals.supabase.rpc("customer_contact_email", { p_profile_id: previewId })).data;
    const { data: recentOrders } = await Astro.locals.supabase
      .from("orders")
      .select("id, status, total, created_at")
      .eq("customer_id", previewId)
      .order("created_at", { ascending: false })
      .limit(3);

    previewData = {
      id: previewProfile.id,
      fullName: previewProfile.full_name ?? "Unnamed customer",
      phone: previewProfile.phone ?? null,
      email: previewEmail ?? null,
      address: (previewCustomer?.shipping_address as { formatted?: string } | null)?.formatted ?? null,
      lifetimeSpend: previewMetrics?.lifetime_spend ?? 0,
      orderCount: previewMetrics?.order_count ?? 0,
      firstOrderAt: previewMetrics?.first_order_at ?? null,
      lastOrderAt: previewMetrics?.last_order_at ?? null,
      recentOrders: recentOrders ?? [],
    };
  }
}

const previewInitials = previewData
  ? previewData.fullName
      .split(" ")
      .filter(Boolean)
      .slice(0, 2)
      .map((p) => p[0]!.toUpperCase())
      .join("")
  : "";

const STATUS_TONE: Record<OrderStatus, "outline" | "warn" | "info" | "success" | "muted"> = {
  pending: "outline",
  confirmed: "warn",
  processing: "warn",
  shipped: "info",
  delivered: "success",
  cancelled: "muted",
  refunded: "muted",
};
const STATUS_LABEL: Record<OrderStatus, string> = {
  pending: "Pending",
  confirmed: "Confirmed",
  processing: "Processing",
  shipped: "Shipped",
  delivered: "Delivered",
  cancelled: "Cancelled",
  refunded: "Refunded",
};
---

<BaseLayout title="Contacts — Sales">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  </Fragment>

  <div class="sd" id="sd-root">
    <div id="sd-sidebar-backdrop" class="sd__backdrop"></div>

    <div id="sd-sidebar" class="sd__sidebar">
      <NavSidebar active="Contacts" />
    </div>

    <div class="sd__panel">
      <NavTop section="Sales" page="Contacts" searchAction="/crm/customers" searchName="search" searchValue={search} searchPlaceholder="Filter by name…" />

      <main id="main-content" class="cts__main">
        <div class="cts__header">
          <div class="cts__heading-col">
            <h1>Contacts</h1>
            <span class="cts__meta">People at your accounts · {totalFiltered} contact{totalFiltered === 1 ? "" : "s"}</span>
          </div>
        </div>

        <div class="cts__stats">
          {stats.map((s) => (
            <div class="cts__stat-card">
              <span class="cts__stat-label">{s.label}</span>
              <div class="cts__stat-body">
                <span class="cts__stat-value">{s.value}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="cts__toolbar">
          <form method="get" class="cts__filter-form">
            <input type="text" name="search" value={search} placeholder="Filter by name…" class="cts__filter-input" />
            <select name="sort" class="cts__sort-select">
              <option value="name" selected={sort === "name"}>Name</option>
              <option value="spend" selected={sort === "spend"}>Lifetime spend</option>
              <option value="recent" selected={sort === "recent"}>Most recent order</option>
            </select>
            {type && <input type="hidden" name="type" value={type} />}
            <button type="submit" class="cts__filter-apply">Apply</button>
          </form>
          <a href={buildUrl({ type: undefined, page: undefined })} class={`cts__facet ${!type ? "is-active" : ""}`}>All</a>
          <a href={buildUrl({ type: "new", page: undefined })} class={`cts__facet ${type === "new" ? "is-active" : ""}`}>New</a>
          <a href={buildUrl({ type: "returning", page: undefined })} class={`cts__facet ${type === "returning" ? "is-active" : ""}`}>Returning</a>
        </div>

        <div class="cts__body">
          <div class="cts__table-panel">
            {pageItems.length > 0 ? (
              <Fragment>
                <div class="cts__grid cts__grid-head">
                  <span>Name</span>
                  <span>Phone</span>
                  <span>Email</span>
                  <span>Last order</span>
                  <span class="cts__col-right">Orders</span>
                  <span></span>
                </div>
                {pageItems.map((c) => (
                  <div class={`cts__grid cts__row ${c.id === previewId ? "is-selected" : ""}`}>
                    <a href={buildUrl({ preview: c.id })} class="cts__name-cell">{c.fullName}</a>
                    <span class="cts__muted-cell">{c.phone ?? "—"}</span>
                    <span class="cts__muted-cell cts__ellipsis">{emailByCustomerId.get(c.id) ?? "—"}</span>
                    <span class="cts__muted-cell">{formatDate(c.lastOrderAt)}</span>
                    <span class="cts__col-right">{c.orderCount}</span>
                    <a href={`/crm/customers/${c.id}`} class="cts__view-link">View</a>
                  </div>
                ))}
                <div class="cts__panel-footer">
                  <span class="cts__panel-footer-count">Showing {(page - 1) * PAGE_SIZE + 1}–{Math.min(page * PAGE_SIZE, totalFiltered)} of {totalFiltered} contacts</span>
                  <span class="cts__panel-footer-page">Page {page} of {totalPages}</span>
                  <div class="cts__pager">
                    <a href={page > 1 ? buildUrl({ page: String(page - 1) }) : undefined} aria-disabled={page <= 1} class="cts__pager-btn">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
                    </a>
                    <a href={page < totalPages ? buildUrl({ page: String(page + 1) }) : undefined} aria-disabled={page >= totalPages} class="cts__pager-btn">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
                    </a>
                  </div>
                </div>
              </Fragment>
            ) : (
              <div class="cts__empty">
                <p class="cts__empty-title">No contacts found</p>
                <p class="cts__empty-body">Try a different search or filter.</p>
              </div>
            )}
          </div>

          {previewData && (
            <aside aria-label="Contact preview" class="cts__preview">
              <div class="cts__preview-head">
                <span class="cts__preview-avatar">{previewInitials}</span>
                <div class="cts__preview-identity">
                  <span class="cts__preview-name">{previewData.fullName}</span>
                  <span class="cts__preview-sub">Customer since {formatYear(previewData.firstOrderAt)}</span>
                </div>
              </div>

              <div class="cts__preview-section">
                <span class="cts__preview-label">Contact</span>
                <span class="cts__preview-row">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
                  {previewData.phone ?? "No phone on file"}
                </span>
                <span class="cts__preview-row">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 6 9-6"></path></svg>
                  {previewData.email ?? "No email on file"}
                </span>
                {previewData.address && (
                  <span class="cts__preview-row">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11zM10 10a2 2 0 1 0 4 0a2 2 0 1 0-4 0"></path></svg>
                    {previewData.address}
                  </span>
                )}
              </div>

              <div class="cts__preview-section">
                <div class="cts__preview-metric-head">
                  <span class="cts__preview-label">Lifetime spend</span>
                </div>
                <span class="cts__preview-metric-value">{formatCompact(previewData.lifetimeSpend)}</span>
                <span class="cts__preview-metric-sub">{previewData.orderCount} order{previewData.orderCount === 1 ? "" : "s"} · last order {formatDate(previewData.lastOrderAt)}</span>
              </div>

              {previewData.recentOrders.length > 0 && (
                <div class="cts__preview-section">
                  <span class="cts__preview-label">Recent orders</span>
                  {previewData.recentOrders.map((o) => (
                    <a href={`/sales/orders/${o.id}`} class="cts__preview-order">
                      <span class="cts__preview-order-id">{o.id.slice(0, 8)}</span>
                      <span class="cts__preview-order-date">{formatDate(o.created_at)}</span>
                      <span class="cts__preview-order-total">{formatCompact(o.total)}</span>
                      <span class={`cts__pill cts__pill--${STATUS_TONE[o.status as OrderStatus] ?? "muted"}`}>{STATUS_LABEL[o.status as OrderStatus] ?? o.status}</span>
                    </a>
                  ))}
                </div>
              )}

              <div class="cts__preview-actions">
                {previewData.phone && (
                  <a href={`tel:${previewData.phone}`} class="cts__preview-secondary-btn">Call</a>
                )}
                <a href="/sales/orders/new" class="cts__preview-primary-btn">New order</a>
              </div>
            </aside>
          )}
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .sd {
    --sd-shell: #fafafa;
    --sd-panel: #ffffff;
    --sd-card: #ffffff;
    --sd-fg: #0a0a0a;
    --sd-fg2: #404040;
    --sd-muted: #f5f5f5;
    --sd-muted-fg: #737373;
    --sd-border: #e5e5e5;
    --sd-input: #e5e5e5;
    --sd-primary: #171717;
    --sd-primary-fg: #fafafa;
    --sd-success-bg: #ecfdf3;
    --sd-success-fg: #15803d;
    --sd-warn-bg: #fef3e2;
    --sd-warn-fg: #9a3412;
    --sd-danger-bg: #feecec;
    --sd-danger-fg: #b91c1c;
    --sd-info-bg: #eef2ff;
    --sd-info-fg: #3538cd;
    --sd-accent: #2b50e0;
    --sd-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    color-scheme: light;

    min-height: 100vh;
    display: flex;
    background: var(--sd-shell);
    color: var(--sd-fg);
    font-family: "Geist", system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .sd[data-theme="dark"] {
    --sd-shell: #0a0a0a;
    --sd-panel: #0f0f0f;
    --sd-card: #171717;
    --sd-fg: #fafafa;
    --sd-fg2: #d4d4d4;
    --sd-muted: #262626;
    --sd-muted-fg: #a3a3a3;
    --sd-border: #262626;
    --sd-input: #363636;
    --sd-primary: #fafafa;
    --sd-primary-fg: #171717;
    --sd-success-bg: #0f2a1c;
    --sd-success-fg: #4ade80;
    --sd-warn-bg: #2e1f0e;
    --sd-warn-fg: #fdba74;
    --sd-danger-bg: #2d1414;
    --sd-danger-fg: #f87171;
    --sd-info-bg: #1e2240;
    --sd-info-fg: #a5b4fc;
    --sd-accent: #6b8afb;
    --sd-shadow: none;
    color-scheme: dark;
  }
  .sd__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 20;
  }
  .sd__sidebar {
    height: 100vh;
    position: sticky;
    top: 0;
  }
  @media (max-width: 1023px) {
    .sd__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 30;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .sd__sidebar.is-open {
      transform: translateX(0);
    }
    .sd__backdrop.is-open {
      display: block;
    }
  }
  .sd__panel {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin: 8px 8px 8px 0;
    background: var(--sd-panel);
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--sd-shadow);
  }
  @media (max-width: 1023px) {
    .sd__panel {
      margin: 8px;
    }
  }

  .cts__main {
    flex-grow: 1;
    box-sizing: border-box;
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (max-width: 640px) {
    .cts__main {
      padding: 16px;
    }
  }

  .cts__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .cts__heading-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cts__heading-col h1 {
    margin: 0;
