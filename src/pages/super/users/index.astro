---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NavSidebar from "../../../components/staff/NavSidebar.astro";
import NavTop from "../../../components/staff/NavTop.astro";

// AUTHORIZATION: Strictly super_admin only.
if (Astro.locals.role !== "super_admin") {
  return Astro.redirect("/");
}

const userId = Astro.locals.user!.id;
const url = Astro.url;
const search = url.searchParams.get("search")?.trim() ?? "";
const roleFilter = url.searchParams.get("role") ?? "";
const statusFilter = url.searchParams.get("status") ?? "";
const invited = url.searchParams.get("invited");

const [{ data: profileRows }, { data: pendingApprovals }] = await Promise.all([
  Astro.locals.supabase
    .from("profiles")
    .select("id, full_name, role, is_active, created_at")
    .order("role")
    .order("full_name"),
  Astro.locals.supabase
    .from("approval_requests")
    .select("id, target_id, action_type, payload, status, created_at")
    .eq("target_table", "profiles")
    .eq("status", "pending"),
]);

const pendingRoleChangeByProfileId = new Map<string, { id: string; newRole: string; createdAt: string }>();

for (const req of (pendingApprovals ?? []) as any[]) {
  if (req.action_type === "change_role" && req.payload?.new_role) {
    pendingRoleChangeByProfileId.set(req.target_id, {
      id: req.id,
      newRole: req.payload.new_role,
      createdAt: req.created_at,
    });
  }
}

const ROLE_LABEL: Record<string, string> = {
  super_admin: "Super admin",
  admin: "Admin",
  sales_staff: "Sales staff",
  inventory_staff: "Inventory staff",
  customer: "Customer",
};

const ROLE_TONE: Record<string, "solid" | "info" | "outline" | "muted"> = {
  super_admin: "solid",
  admin: "info",
  sales_staff: "outline",
  inventory_staff: "muted",
  customer: "muted",
};

const ALL_ROLES = ["super_admin", "admin", "sales_staff", "inventory_staff", "customer"] as const;
const STAFF_ROLE_OPTIONS = ["sales_staff", "inventory_staff", "admin"] as const;

const allRows = (profileRows ?? []).map((p) => ({
  id: p.id as string,
  name: (p.full_name as string | null) ?? "Unnamed",
  role: p.role as string,
  isActive: p.is_active as boolean,
  createdAt: p.created_at as string,
  isSelf: p.id === userId,
  isProtected: p.role === "super_admin",
  pendingRoleChange: pendingRoleChangeByProfileId.get(p.id),
}));

const staffRows = allRows.filter((r) => r.role !== "customer");
const customerCount = allRows.filter((r) => r.role === "customer").length;

const filtered = allRows.filter((r) => {
  if (roleFilter && r.role !== roleFilter) return false;
  if (statusFilter === "active" && !r.isActive) return false;
  if (statusFilter === "inactive" && r.isActive) return false;
  if (search && !r.name.toLowerCase().includes(search.toLowerCase())) return false;
  return true;
});

function buildUrl(overrides: Record<string, string | undefined>) {
  const next = new URLSearchParams(url.search);
  for (const [key, value] of Object.entries(overrides)) {
    if (value) next.set(key, value);
    else next.delete(key);
  }
  const qs = next.toString();
  return qs ? `/super/users?${qs}` : "/super/users";
}

function initials(name: string): string {
  const parts = name.split(" ").filter(Boolean).slice(0, 2).map((p) => p[0]!.toUpperCase());
  return parts.length > 0 ? parts.join("") : "—";
}

function fmtJoined(iso: string): string {
  return new Date(iso).toLocaleDateString(undefined, { month: "short", year: "numeric" });
}

const stats = [
  {
    label: "Super admins",
    value: allRows.filter((r) => r.role === "super_admin").length,
    note: "incl. you",
  },
  {
    label: "Admins",
    value: allRows.filter((r) => r.role === "admin").length,
    note: "full business access",
  },
  {
    label: "Sales staff",
    value: allRows.filter((r) => r.role === "sales_staff").length,
    note: "orders & CRM",
  },
  {
    label: "Inventory staff",
    value: allRows.filter((r) => r.role === "inventory_staff").length,
    note: "catalog & stock",
  },
  {
    label: "Customers",
    value: customerCount,
    note: "managed in Customers",
    href: "/super/users?role=customer",
  },
];
---

<BaseLayout title="Users — Super Admin">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  </Fragment>

  <div class="sd" id="sd-root">
    <div id="sd-sidebar-backdrop" class="sd__backdrop"></div>

    <div id="sd-sidebar" class="sd__sidebar">
      <NavSidebar active="Users" role="super" />
    </div>

    <div class="sd__panel">
      <NavTop section="Access" page="Users" />

      <main id="main-content" class="tm__main">
        <header class="tm__header">
          <div class="tm__heading-col">
            <h1>Users</h1>
            <p class="tm__subtitle">
              {staffRows.length} internal team member{staffRows.length === 1 ? "" : "s"} · 4 staff roles · {customerCount} customer{customerCount === 1 ? "" : "s"}
            </p>
            {invited && <p class="tm__banner" role="status">Invitation sent successfully.</p>}
          </div>

          <div class="tm__actions-header">
            <button type="button" id="tm-export-btn" class="tm__btn" title="Export users to CSV">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
              Export
            </button>
            <button type="button" id="tm-invite-toggle" class="tm__btn tm__btn--primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
              Invite user
            </button>
          </div>
        </header>

        <section id="tm-invite-panel" class="tm__invite-panel" hidden>
          <h2>Invite user</h2>
          <div class="tm__invite-hint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
            <span>You can invite Admins, Sales staff, and Inventory staff directly.</span>
          </div>
          <form id="tm-invite-form" class="tm__invite-form">
            <div class="tm__field">
              <label for="tm-invite-name">Full name</label>
              <input type="text" id="tm-invite-name" name="fullName" required placeholder="e.g. Priya Sharma" class="tm__input" />
            </div>
            <div class="tm__field">
              <label for="tm-invite-email">Email</label>
              <input type="email" id="tm-invite-email" name="email" required placeholder="user@company.com" class="tm__input" />
            </div>
            <div class="tm__field">
              <label for="tm-invite-role">Role</label>
              <select id="tm-invite-role" name="role" required class="tm__select">
                {STAFF_ROLE_OPTIONS.map((r) => (
                  <option value={r}>{ROLE_LABEL[r]}</option>
                ))}
              </select>
            </div>
            <p id="tm-invite-message" class="tm__form-message" role="status" />
            <div class="tm__invite-actions">
              <button type="button" id="tm-invite-cancel" class="tm__btn">Cancel</button>
              <button type="submit" class="tm__btn tm__btn--primary">Send invitation</button>
            </div>
          </form>
        </section>

        <div class="tm__stats">
          {stats.map((s) => (
            <div class="tm__stat-card">
              <span class="tm__stat-label">{s.label}</span>
              <div class="tm__stat-body">
                <span class="tm__stat-value">{s.value}</span>
                {s.href ? (
                  <a href={s.href} class="tm__stat-note tm__stat-link" title="View customer accounts">{s.note}</a>
                ) : (
                  s.note && <span class="tm__stat-note">{s.note}</span>
                )}
              </div>
            </div>
          ))}
        </div>

        <div class="tm__toolbar">
          <form method="get" action="/super/users" class="tm__search-form">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-4-4"></path></svg>
            <input type="search" name="search" value={search} aria-label="Filter by name" placeholder="Filter by name…" class="tm__search-input" />
            {roleFilter && <input type="hidden" name="role" value={roleFilter} />}
            {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
          </form>

          <select id="tm-role-filter" class="tm__facet-select" aria-label="Filter by role">
            <option value={buildUrl({ role: undefined })} selected={!roleFilter}>+ Role</option>
            {ALL_ROLES.map((r) => (
              <option value={buildUrl({ role: r })} selected={roleFilter === r}>{ROLE_LABEL[r]}</option>
            ))}
          </select>

          <select id="tm-status-filter" class="tm__facet-select" aria-label="Filter by status">
            <option value={buildUrl({ status: undefined })} selected={!statusFilter}>+ Status</option>
            <option value={buildUrl({ status: "active" })} selected={statusFilter === "active"}>Active</option>
            <option value={buildUrl({ status: "inactive" })} selected={statusFilter === "inactive"}>Inactive</option>
          </select>

          {(search || roleFilter || statusFilter) && (
            <a href="/super/users" class="tm__clear-btn" title="Clear all filters">Clear filters</a>
          )}
        </div>

        {
          filtered.length > 0 ? (
            <div class="tm__panel">
              <div class="tm__grid tm__grid-head">
                <span>User</span>
                <span>Role</span>
                <span>Joined</span>
                <span>Status</span>
                <span>Actions</span>
              </div>
              {filtered.map((r) => (
                <div class="tm__grid tm__row" data-profile-id={r.id} data-current-role={r.role}>
                  <span class="tm__user-cell">
                    <span class="tm__avatar">{initials(r.name)}</span>
                    <span class="tm__user-name">{r.name}</span>
                  </span>
                  <span class="tm__role-cell">
                    <span class={`tm__pill tm__pill--${ROLE_TONE[r.role] ?? "muted"}`}>{ROLE_LABEL[r.role] ?? r.role}</span>
                    {r.pendingRoleChange && (
                      <span class="tm__pill tm__pill--warn" title={`Pending approval: change to ${ROLE_LABEL[r.pendingRoleChange.newRole] ?? r.pendingRoleChange.newRole}`}>
                        Pending: {ROLE_LABEL[r.pendingRoleChange.newRole] ?? r.pendingRoleChange.newRole}
                      </span>
                    )}
                  </span>
                  <span class="tm__muted-cell">{fmtJoined(r.createdAt)}</span>
                  <span><span class={`tm__pill tm__pill--${r.isActive ? "active" : "inactive"}`}>{r.isActive ? "Active" : "Inactive"}</span></span>
                  <span class="tm__actions-cell">
                    {r.isProtected ? (
                      <span class="tm__muted-cell">Protected account</span>
                    ) : r.isSelf ? (
                      <span class="tm__muted-cell">This is you</span>
                    ) : r.pendingRoleChange ? (
                      <a href="/super/approvals" class="tm__pill tm__pill--warn" style="text-decoration:none;">Review pending approval</a>
                    ) : r.role === "customer" ? (
                      <div class="tm__row-controls">
                        <button type="button" class="tm-toggle-active tm__link-btn" data-next-active={(!r.isActive).toString()}>
                          {r.isActive ? "Deactivate" : "Reactivate"}
                        </button>
                        <select class="tm-role-select tm__mini-select" aria-label={`Assign staff role for ${r.name}`}>
                          <option value="customer" selected>Customer</option>
                          {STAFF_ROLE_OPTIONS.map((opt) => (
                            <option value={opt}>{ROLE_LABEL[opt]}</option>
                          ))}
                        </select>
                        <button type="button" class="tm-save-role tm__link-btn">Promote</button>
                      </div>
                    ) : (
                      <div class="tm__row-controls">
                        <button type="button" class="tm-toggle-active tm__link-btn" data-next-active={(!r.isActive).toString()}>
                          {r.isActive ? "Deactivate" : "Reactivate"}
                        </button>
                        <select class="tm-role-select tm__mini-select" aria-label={`Change role for ${r.name}`}>
                          {STAFF_ROLE_OPTIONS.map((opt) => (
                            <option value={opt} selected={opt === r.role}>{ROLE_LABEL[opt]}</option>
                          ))}
                        </select>
                        <button type="button" class="tm-save-role tm__link-btn">Save role</button>
                      </div>
                    )}
                    <p class="tm-row-message tm__row-message" role="status" />
                  </span>
                </div>
              ))}
              <div class="tm__panel-footer">{filtered.length} of {allRows.length} users</div>
            </div>
          ) : (
            <div class="tm__empty">
              <p class="tm__empty-title">No users found</p>
              <p class="tm__empty-body">Try a different search or filter criteria.</p>
            </div>
          )
        }
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .sd {
    --sd-shell: #fafafa;
    --sd-panel: #ffffff;
    --sd-card: #ffffff;
    --sd-fg: #0a0a0a;
    --sd-fg2: #404040;
    --sd-muted: #f5f5f5;
    --sd-muted-fg: #737373;
    --sd-border: #e5e5e5;
    --sd-input: #e5e5e5;
    --sd-primary: #171717;
    --sd-primary-fg: #fafafa;
    --sd-success-bg: #ecfdf3;
    --sd-success-fg: #15803d;
    --sd-warn-bg: #fef3e2;
    --sd-warn-fg: #9a3412;
    --sd-danger-bg: #feecec;
    --sd-danger-fg: #b91c1c;
    --sd-info-bg: #eef2ff;
    --sd-info-fg: #3538cd;
    --sd-accent: #2b50e0;
    --sd-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    color-scheme: light;

    min-height: 100vh;
    display: flex;
    background: var(--sd-shell);
    color: var(--sd-fg);
    font-family: "Geist", system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .sd[data-theme="dark"] {
    --sd-shell: #0a0a0a;
    --sd-panel: #0f0f0f;
    --sd-card: #171717;
    --sd-fg: #fafafa;
    --sd-fg2: #d4d4d4;
    --sd-muted: #262626;
    --sd-muted-fg: #a3a3a3;
    --sd-border: #262626;
    --sd-input: #363636;
    --sd-primary: #fafafa;
    --sd-primary-fg: #171717;
    --sd-success-bg: #0f2a1c;
    --sd-success-fg: #4ade80;
    --sd-warn-bg: #2e1f0e;
    --sd-warn-fg: #fdba74;
    --sd-danger-bg: #2d1414;
    --sd-danger-fg: #f87171;
    --sd-info-bg: #1e2240;
    --sd-info-fg: #a5b4fc;
    --sd-accent: #6b8afb;
    --sd-shadow: none;
    color-scheme: dark;
  }
  .sd__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 20;
  }
  .sd__sidebar {
    height: 100vh;
    position: sticky;
    top: 0;
  }
  @media (max-width: 1023px) {
    .sd__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 30;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .sd__sidebar.is-open {
      transform: translateX(0);
    }
    .sd__backdrop.is-open {
      display: block;
    }
  }
  .sd__panel {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin: 8px 8px 8px 0;
    background: var(--sd-panel);
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--sd-shadow);
  }
  @media (max-width: 1023px) {
    .sd__panel {
      margin: 8px;
    }
  }

  .tm__main {
    flex-grow: 1;
    box-sizing: border-box;
    padding: 24px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (max-width: 640px) {
    .tm__main {
      padding: 16px;
    }
  }

  .tm__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    flex-wrap: wrap;
  }
  .tm__heading-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tm__heading-col h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .tm__subtitle {
    font-size: 14px;
    color: var(--sd-muted-fg);
  }
  .tm__banner {
    margin: 0;
    font-size: 13px;
    color: var(--sd-success-fg);
  }
  .tm__actions-header {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tm__btn {
    height: 36px;
    box-sizing: border-box;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    color: var(--sd-fg);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
  }
  .tm__btn--primary {
    border: 0;
    background: var(--sd-primary);
    color: var(--sd-primary-fg);
  }

  .tm__invite-panel {
    box-sizing: border-box;
    padding: 16px;
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    background: var(--sd-card);
    box-shadow: var(--sd-shadow);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tm__invite-panel h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .tm__invite-hint {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--sd-info-fg);
  }
  .tm__invite-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tm__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tm__field label {
    font-size: 12px;
    font-weight: 500;
    color: var(--sd-muted-fg);
  }
  .tm__input,
  .tm__select {
    height: 34px;
    box-sizing: border-box;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid var(--sd-input);
    background: var(--sd-panel);
    color: var(--sd-fg);
    font: inherit;
    font-size: 13px;
  }
  .tm__invite-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 4px;
  }
  .tm__form-message {
    margin: 0;
    font-size: 12px;
    color: var(--sd-danger-fg);
    min-height: 0;
  }

  .tm__stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
  }
  @media (max-width: 900px) {
    .tm__stats {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }
  .tm__stat-card {
    box-sizing: border-box;
    padding: 14px 16px;
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    background: var(--sd-card);
    box-shadow: var(--sd-shadow);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .tm__stat-label {
    font-size: 13px;
    color: var(--sd-muted-fg);
  }
  .tm__stat-body {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .tm__stat-value {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sd-fg);
  }
  .tm__stat-note {
    font-size: 12px;
    color: var(--sd-muted-fg);
  }
  .tm__stat-link {
    text-decoration: underline;
    cursor: pointer;
  }
  .tm__stat-link:hover {
    color: var(--sd-accent);
  }

  .tm__toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tm__search-form {
    width: 260px;
    height: 34px;
    box-sizing: border-box;
    padding: 0 12px;
    border: 1px solid var(--sd-input);
    border-radius: 8px;
    background: var(--sd-card);
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--sd-muted-fg);
    flex-shrink: 0;
  }
  .tm__search-input {
    flex-grow: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 13px;
    color: var(--sd-fg);
  }
  .tm__facet-select {
    height: 34px;
    box-sizing: border-box;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px dashed var(--sd-input);
    background: transparent;
    color: var(--sd-fg);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }
  .tm__clear-btn {
    font-size: 13px;
    color: var(--sd-muted-fg);
    text-decoration: underline;
    cursor: pointer;
  }
  .tm__clear-btn:hover {
    color: var(--sd-fg);
  }

  .tm__panel {
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    background: var(--sd-card);
    box-shadow: var(--sd-shadow);
    overflow-x: auto;
  }
  .tm__grid {
    display: grid;
    grid-template-columns: minmax(180px, 1.4fr) 140px 110px 100px minmax(220px, 1.4fr);
    gap: 12px;
    align-items: center;
    padding: 0 16px;
    min-width: 820px;
  }
  .tm__grid-head {
    height: 40px;
    border-bottom: 1px solid var(--sd-border);
    font-size: 13px;
    font-weight: 500;
    color: var(--sd-muted-fg);
  }
  .tm__row {
    min-height: 56px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--sd-border);
    font-size: 14px;
  }
  .tm__user-cell {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .tm__avatar {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--sd-muted);
    font-size: 12px;
    font-weight: 600;
    color: var(--sd-fg2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tm__user-name {
    font-weight: 500;
    color: var(--sd-fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tm__role-cell {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tm__pill {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .tm__pill--solid {
    background: var(--sd-primary);
    color: var(--sd-primary-fg);
  }
  .tm__pill--info {
    background: var(--sd-info-bg);
    color: var(--sd-info-fg);
  }
  .tm__pill--outline {
    border: 1px solid var(--sd-input);
    color: var(--sd-fg);
  }
  .tm__pill--muted {
    background: var(--sd-muted);
    color: var(--sd-fg2);
  }
  .tm__pill--active {
    background: var(--sd-success-bg);
    color: var(--sd-success-fg);
  }
  .tm__pill--inactive {
    background: var(--sd-danger-bg);
    color: var(--sd-danger-fg);
  }
  .tm__pill--warn {
    background: var(--sd-warn-bg);
    color: var(--sd-warn-fg);
  }
  .tm__muted-cell {
    color: var(--sd-muted-fg);
  }
  .tm__actions-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .tm__row-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tm__link-btn {
    border: 0;
    background: transparent;
    color: var(--sd-accent);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
  }
  .tm__mini-select {
    height: 26px;
    box-sizing: border-box;
    padding: 0 6px;
    border-radius: 6px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    font: inherit;
    font-size: 12px;
    color: var(--sd-fg);
