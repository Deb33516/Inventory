  .rp__group-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sd-muted-fg);
  }
  .rp__item-row {
    display: grid;
    grid-template-columns: 1fr 96px 96px 96px 96px;
    gap: 8px;
    align-items: center;
    padding: 0 20px;
    height: 34px;
    border-bottom: 1px solid var(--sd-border);
    font-size: 14px;
  }
  .rp__item-label {
    padding-left: 12px;
    color: var(--sd-fg);
    white-space: nowrap;
