---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthSplitLayout from "../components/auth/AuthSplitLayout.astro";
import Input from "../components/ui/Input.astro";
import Button from "../components/ui/Button.astro";

// Reaching this page with a session means the recovery link in
// src/pages/auth/callback.astro was just verified successfully.
const hasRecoverySession = Boolean(Astro.locals.user);
---

<BaseLayout title="Set a new password — Inventory">
  <AuthSplitLayout formTitle="Set a new password">
    <a href="/login" class="inline-flex items-center gap-xs text-sm font-bold text-muted hover:text-ink">← Back to sign in</a>

    {
        hasRecoverySession ? (
          <>
            <form id="reset-form" class="mt-lg space-y-md">
              <Input
                label="New password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength={8}
                required
              />
              <Input
                label="Confirm new password"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                minlength={8}
                required
              />
              <p id="form-message" class="text-sm" role="status" />
              <Button type="submit" variant="primary" class="w-full">
                Update password
              </Button>
            </form>

            <script>
              import { actions } from "astro:actions";

              const form = document.querySelector<HTMLFormElement>("#reset-form")!;
              const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
              const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

              form.addEventListener("submit", async (event) => {
                event.preventDefault();
                button.disabled = true;
                messageEl.textContent = "";
                messageEl.classList.remove("text-error", "text-success");

                const { error } = await actions.updatePassword(new FormData(form));

                if (error) {
                  button.disabled = false;
                  messageEl.textContent = error.message;
                  messageEl.classList.add("text-error");
                  return;
                }

                // Force a fresh sign-in with the new password rather than
                // trusting the recovery session to behave like a normal one.
                await actions.signOut();
                window.location.href = "/login?reset=1";
              });
            </script>
          </>
        ) : (
          <p class="mt-md text-sm font-light text-body">
            This password reset link is invalid or has expired.{" "}
            <a href="/forgot-password" class="text-primary font-bold">
              Request a new one
            </a>
            .
          </p>
        )
      }
  </AuthSplitLayout>
</BaseLayout>
