---
// Literal recreation of the Claude Design canvas's Reset password artboard
// (project/ResetPassword.dc.html / ResetPasswordDark.dc.html) — the
// supplied design is the visual source of truth, not the app's existing
// DESIGN.md component system. All existing updatePassword logic below
// (recovery-session check, forced sign-out + redirect on success, error
// handling) is unchanged from before this pass.
//
// Real vs. the design's demo state:
//  - "For arjun@yourcompany.com" in the design is demo copy — this page
//    shows the real signed-in recovery session's own email instead.
//  - The three password-criteria checklist rows are always green/checked
//    in the static design (a filled-in demo screenshot). Reimplemented as
//    real, live client-side validation against the actual typed input
//    (length >= 8, contains a digit, passwords match) rather than
//    reproducing a permanently-"satisfied" decoration — same visual
//    language, honest state.
//  - The design has no "invalid or expired link" state (it only shows the
//    filled-in form) — that fallback still exists here since the real
//    flow needs it, built from the same tokens/typography as the rest of
//    this page rather than inventing an unrelated style.
//
// Same disclosed omission as the other auth screens: the dark panel's
// "Revenue +8.2% · ₹38.6L" card is a numbers-free decorative sparkline.
import BaseLayout from "../layouts/BaseLayout.astro";

// Reaching this page with a session means the recovery link in
// src/pages/auth/callback.astro was just verified successfully.
const user = Astro.locals.user;
const hasRecoverySession = Boolean(user);
---

<BaseLayout title="Set a new password — Inventory">
  <Fragment slot="head">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
  </Fragment>

  <div class="authpage" id="authpage-root">
    <button type="button" id="authpage-theme-toggle" class="authpage__theme-toggle" aria-label="Switch to dark mode">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
    </button>

    <div class="authpage__brand">
      <a href="/" class="authpage__logo">
        <span class="authpage__logo-mark"><span></span></span>
        <span>Inventory</span>
      </a>

      <div class="authpage__pitch">
        <h2>Customers, orders and stock — in one quiet place.</h2>
        <p>Every person signs in to the same app and lands on a dashboard built for their job.</p>

        <div class="authpage__card" aria-hidden="true">
          <svg width="100%" height="64" viewBox="0 0 360 64" preserveAspectRatio="none">
            <path d="M0 50 L30 46 L60 48 L90 38 L120 41 L150 30 L180 33 L210 24 L240 18 L270 21 L300 12 L330 10 L360 6 L360 64 L0 64 Z" class="authpage__card-fill" />
            <path d="M0 50 L30 46 L60 48 L90 38 L120 41 L150 30 L180 33 L210 24 L240 18 L270 21 L300 12 L330 10 L360 6" class="authpage__card-line" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          </svg>
        </div>
      </div>

      <div class="authpage__footer">
        <span>© 2026 Inventory</span>
        <span>Privacy</span>
        <span>Terms</span>
      </div>
    </div>

    <div class="authpage__panel">
      <div class="authpage__form-col">
        <a href="/login" class="authpage__back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
          Back to sign in
        </a>

        {
          hasRecoverySession ? (
            <>
              <div class="authpage__head">
                <h1>Set a new password</h1>
                <p class="authpage__sub">For {user!.email}. You'll be signed out on other devices.</p>
              </div>

              <form id="reset-form" class="authpage__form">
                <div class="authpage__field">
                  <label for="pw1">New password</label>
                  <input id="pw1" name="password" type="password" autocomplete="new-password" minlength={8} required />
                </div>
                <div class="authpage__field">
                  <label for="pw2">Confirm new password</label>
                  <input id="pw2" name="confirmPassword" type="password" autocomplete="new-password" minlength={8} required />
                </div>

                <ul class="authpage__criteria" aria-live="polite">
                  <li data-rule="length">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                    At least 8 characters
                  </li>
                  <li data-rule="number">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                    Includes a number
                  </li>
                  <li data-rule="match">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"></path></svg>
                    Passwords match
                  </li>
                </ul>

                <p id="form-message" class="authpage__notice" role="status"></p>

                <button type="submit" class="authpage__submit">Update password</button>
              </form>
            </>
          ) : (
            <div class="authpage__head">
              <h1>This link is invalid or has expired</h1>
              <p class="authpage__sub">
                Password reset links only work once and expire after a while. Request a new one to keep going.
              </p>
              <a href="/forgot-password" class="authpage__submit authpage__submit--link">Request a new link</a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .authpage {
    --shell: #fafafa;
    --card: #ffffff;
    --fg: #0a0a0a;
    --fg2: #404040;
    --muted-fg: #737373;
    --input: #e5e5e5;
    --primary: #171717;
    --primary-fg: #fafafa;
    --brand: #0a0a0a;
    --accent: #2b50e0;
    --accent-light: #8fa5ff;
    --error-fg: #b91c1c;
    --success-fg: #15803d;
    color-scheme: light;

    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--shell);
    color: var(--fg);
    font-family: "Geist", system-ui, sans-serif;
  }
  @media (min-width: 900px) {
    .authpage {
      flex-direction: row;
    }
  }

  /* Matches ResetPasswordDark.dc.html. Same explicit-toggle-only pattern
     as the other auth pages — defaults to light, switches via the button
     below, remembered in the shared localStorage key so a choice made on
     any auth page carries over to the others. */
  .authpage[data-theme="dark"] {
    --shell: #0a0a0a;
    --card: #171717;
    --fg: #fafafa;
    --fg2: #d4d4d4;
    --muted-fg: #a3a3a3;
    --input: #363636;
    --primary: #fafafa;
    --primary-fg: #171717;
    --brand: #171717;
    --accent: #6b8afb;
    --accent-light: #6b8afb;
    --error-fg: #f87171;
    --success-fg: #4ade80;
    color-scheme: dark;
  }

  .authpage__theme-toggle {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 20;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--input);
    background: var(--card);
    color: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .authpage[data-theme="dark"] .icon-sun,
  .authpage:not([data-theme="dark"]) .icon-moon {
    display: none;
  }

  /* ---------- dark brand panel ---------- */
  .authpage__brand {
    box-sizing: border-box;
    padding: 32px 24px;
    background: var(--brand);
    color: #fafaf9;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .authpage__brand {
      width: 600px;
      flex-shrink: 0;
      padding: 56px;
      min-height: 100vh;
    }
  }
  .authpage__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .authpage__logo-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .authpage__logo-mark span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid #ffffff;
  }
  .authpage__pitch {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .authpage__pitch h2 {
    margin: 0;
    font-weight: 600;
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .authpage__pitch p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #a1a1aa;
    max-width: 420px;
  }
  .authpage__card {
    margin-top: 12px;
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
    padding: 20px;
    border-radius: 14px;
    background: #232327;
    border: 1px solid #2e2e33;
  }
  .authpage__card-fill {
    fill: var(--accent);
    fill-opacity: 0.22;
  }
  .authpage__card-line {
    stroke: var(--accent-light);
  }
  .authpage__footer {
    display: flex;
    gap: 20px;
    font-size: 13px;
    color: #a1a1aa;
    flex-wrap: wrap;
  }

  /* ---------- form panel ---------- */
  .authpage__panel {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }
  .authpage__form-col {
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .authpage__back {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    text-decoration: none;
    color: var(--muted-fg);
  }
  .authpage__head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .authpage__head h1 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .authpage__sub {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted-fg);
  }
  .authpage__form {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .authpage__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .authpage__field label {
    font-size: 13px;
    font-weight: 500;
    color: var(--fg);
  }
  .authpage__field input {
    height: 44px;
    box-sizing: border-box;
    padding: 0 14px;
    border: 1px solid var(--input);
    border-radius: 8px;
    background: var(--card);
    font: inherit;
    font-size: 15px;
    color: var(--fg);
  }
  .authpage__field input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .authpage__criteria {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .authpage__criteria li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted-fg);
  }
  .authpage__criteria li svg {
    visibility: hidden;
  }
  .authpage__criteria li.is-met {
    color: var(--success-fg);
  }
  .authpage__criteria li.is-met svg {
    visibility: visible;
  }
  .authpage__notice {
    margin: 0;
    font-size: 14px;
  }
  .authpage__notice--error {
    color: var(--error-fg);
  }
  .authpage__notice--success {
    color: var(--success-fg);
  }
  .authpage__submit {
    height: 46px;
    border-radius: 8px;
    border: 0;
    background: var(--primary);
    color: var(--primary-fg);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .authpage__submit:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .authpage__submit--link {
    margin-top: 8px;
  }
</style>

<script>
  import { actions } from "astro:actions";

  const authRoot = document.getElementById("authpage-root");
  const THEME_KEY = "landing-theme";

  function applyAuthTheme(theme: "light" | "dark") {
    if (!authRoot) return;
    if (theme === "dark") {
      authRoot.setAttribute("data-theme", "dark");
    } else {
      authRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("authpage-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedAuthTheme: string | null = null;
  try {
    storedAuthTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedAuthTheme === "dark") applyAuthTheme("dark");

  document.getElementById("authpage-theme-toggle")?.addEventListener("click", () => {
    applyAuthTheme(authRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  const form = document.querySelector<HTMLFormElement>("#reset-form");

  if (form) {
    const pw1 = document.querySelector<HTMLInputElement>("#pw1")!;
    const pw2 = document.querySelector<HTMLInputElement>("#pw2")!;
    const lengthRule = document.querySelector<HTMLLIElement>('[data-rule="length"]')!;
    const numberRule = document.querySelector<HTMLLIElement>('[data-rule="number"]')!;
    const matchRule = document.querySelector<HTMLLIElement>('[data-rule="match"]')!;
    const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    function updateCriteria() {
      lengthRule.classList.toggle("is-met", pw1.value.length >= 8);
      numberRule.classList.toggle("is-met", /\d/.test(pw1.value));
      matchRule.classList.toggle("is-met", pw1.value.length > 0 && pw1.value === pw2.value);
    }

    pw1.addEventListener("input", updateCriteria);
    pw2.addEventListener("input", updateCriteria);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      button.disabled = true;
      messageEl.textContent = "";
      messageEl.classList.remove("authpage__notice--error");

      const { error } = await actions.updatePassword(new FormData(form));

      if (error) {
        button.disabled = false;
        messageEl.textContent = error.message;
        messageEl.classList.add("authpage__notice--error");
        return;
      }

      // Force a fresh sign-in with the new password rather than
      // trusting the recovery session to behave like a normal one.
      await actions.signOut();
      window.location.href = "/login?reset=1";
    });
  }
</script>
