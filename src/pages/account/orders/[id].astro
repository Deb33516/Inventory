<script>
  const cpRoot = document.getElementById("cp-root");
  const THEME_KEY = "landing-theme";

  function applyCpTheme(theme: "light" | "dark") {
    if (!cpRoot) return;
    if (theme === "dark") {
      cpRoot.setAttribute("data-theme", "dark");
    } else {
      cpRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("cp-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedCpTheme: string | null = null;
  try {
    storedCpTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedCpTheme === "dark") applyCpTheme("dark");

  document.getElementById("cp-theme-toggle")?.addEventListener("click", () => {
    applyCpTheme(cpRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  import { actions } from "astro:actions";

  const container = document.querySelector<HTMLDivElement>("#order-cancel-actions");
  if (container) {
    const orderId = container.dataset.orderId!;
    const cancelBtn = document.querySelector<HTMLButtonElement>("#od-cancel-btn")!;
    const messageEl = document.querySelector<HTMLParagraphElement>("#od-cancel-message")!;

    cancelBtn.addEventListener("click", async () => {
      const reason = window.prompt("Reason for cancellation:") ?? "";
      if (!reason.trim()) return;

      cancelBtn.disabled = true;
      messageEl.textContent = "";

      const { error } = await actions.updateOrderStatus({ orderId, newStatus: "cancelled", reason });

      if (error) {
        cancelBtn.disabled = false;
        messageEl.textContent = error.message;
        return;
      }

      window.location.reload();
    });
  }
</script>
