---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import EmptyState from "../../../components/catalog/EmptyState.astro";
import OrderStatusBadge from "../../../components/orders/OrderStatusBadge.astro";
import OrderLineItems from "../../../components/orders/OrderLineItems.astro";
import OrderStatusActions from "../../../components/orders/OrderStatusActions.astro";
import PublicHeader from "../../../components/layout/PublicHeader.astro";

const { id } = Astro.params;
const { user } = Astro.locals;
const created = Astro.url.searchParams.get("created");

const { data: order } = await Astro.locals.supabase
  .from("orders")
  .select("id, status, subtotal, tax, shipping_fee, total, shipping_address, notes, created_at, customer_id")
  .eq("id", id)
  .eq("customer_id", user!.id)
  .maybeSingle();

if (!order) {
  Astro.response.status = 404;
}

const { data: items } = order
  ? await Astro.locals.supabase
      .from("order_items")
      .select("id, quantity, unit_price, subtotal, products(sku, name)")
      .eq("order_id", id)
  : { data: null };

const { data: payment } = order
  ? await Astro.locals.supabase
      .from("payments")
      .select("status, method, paid_at")
      .eq("order_id", id)
      .maybeSingle()
  : { data: null };
---

<BaseLayout title={order ? `Order ${order.id.slice(0, 8)} — Inventory` : "Order not found — Inventory"}>
  <PublicHeader backHref="/account/orders" backLabel="Your orders" />

  <main id="main-content" class="max-w-[1440px] mx-auto px-lg py-xl">
    {
      order ? (
        <>
          {created && (
            <p class="mb-md text-sm text-success" role="status">
              Order placed successfully.
            </p>
          )}
          <div class="flex items-center justify-between flex-wrap gap-md">
            <div>
              <h1 class="text-2xl font-bold text-ink">Order {order.id.slice(0, 8)}</h1>
              <p class="text-sm text-muted">{new Date(order.created_at).toLocaleString()}</p>
            </div>
            <OrderStatusBadge status={order.status} />
          </div>

          <Card class="mt-lg">
            <OrderLineItems
              items={items ?? []}
              subtotal={order.subtotal}
              tax={order.tax}
              shippingFee={order.shipping_fee}
              total={order.total}
            />
          </Card>

          <Card class="mt-lg">
            <p class="text-xs uppercase tracking-[0.5px] text-muted">Payment</p>
            <p class="mt-xs text-sm text-body capitalize">
              {payment?.method ?? "—"} — {payment?.status ?? "—"}
            </p>
          </Card>

          <div class="mt-lg">
            <OrderStatusActions orderId={order.id} status={order.status} viewerRole="customer" />
          </div>

          <Card class="mt-lg">
            <h2 class="text-sm font-bold text-ink">Need help with this order?</h2>
            <p class="mt-xxs text-xs text-muted">Damaged, missing or wrong items — tell us and our support team will sort it out.</p>
            <a
              href={`/account/support?subject=${encodeURIComponent(`Issue with order ${order.id.slice(0, 8)}`)}`}
              class="mt-md inline-flex h-10 px-md items-center border border-hairline text-sm font-bold text-ink hover:border-hairline-strong"
            >
              Raise a support ticket
            </a>
          </Card>
        </>
      ) : (
        <EmptyState title="Order not found" />
      )
    }
  </main>
</BaseLayout>
