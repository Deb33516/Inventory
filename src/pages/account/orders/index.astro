---
// Matches the Claude Design canvas's Customer "My orders" artboard
// (project/PageCustOrders.dc.html, imported by CustOrders.dc.html), plus
// the detailed spend/status/top-products analytics block that used to live
// on /account itself (Phase 8) — relocated here since /account became a
// lean dashboard matching the design's Customer portal screen, and this
// order-history page is the closest thematic home for order analytics.
// The analytics block, its RPCs and its DateRangeFilter are otherwise
// completely unchanged from the original /account implementation.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import EmptyState from "../../../components/catalog/EmptyState.astro";
import OrderStatusBadge from "../../../components/orders/OrderStatusBadge.astro";
import ChartCanvas from "../../../components/dashboard/ChartCanvas.astro";
import DateRangeFilter from "../../../components/dashboard/DateRangeFilter.astro";
import PublicHeader from "../../../components/layout/PublicHeader.astro";
import { resolveDashboardRange } from "../../../lib/dashboardRange";
import { CHART_COLORS } from "../../../lib/chartTheme";

const { user } = Astro.locals;
const userId = user!.id;

const tab = Astro.url.searchParams.get("tab") ?? "all";

const { data: orderRows } = await Astro.locals.supabase
  .from("orders")
  .select("id, status, total, created_at")
  .eq("customer_id", userId)
  .order("created_at", { ascending: false });

const orders = orderRows ?? [];
const openCount = orders.filter((o) => !["delivered", "cancelled", "refunded"].includes(o.status)).length;
const deliveredCount = orders.filter((o) => o.status === "delivered").length;
const cancelledCount = orders.filter((o) => o.status === "cancelled" || o.status === "refunded").length;

const visibleOrders =
  tab === "open"
    ? orders.filter((o) => !["delivered", "cancelled", "refunded"].includes(o.status))
    : tab === "delivered"
      ? orders.filter((o) => o.status === "delivered")
      : tab === "cancelled"
        ? orders.filter((o) => o.status === "cancelled" || o.status === "refunded")
        : orders;

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(value);

const tabs: { key: string; label: string; count: number }[] = [
  { key: "all", label: "All", count: orders.length },
  { key: "open", label: "Open", count: openCount },
  { key: "delivered", label: "Delivered", count: deliveredCount },
  { key: "cancelled", label: "Cancelled", count: cancelledCount },
];

// --- Analytics block, unchanged from the original /account implementation ---
const url = Astro.url;
const range = resolveDashboardRange(url.searchParams.get("range"));

const [{ data: spendTrend }, { data: ordersByStatus }, { data: topProducts }] = await Promise.all([
  Astro.locals.supabase.rpc("dashboard_revenue_trend", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.rpc("dashboard_orders_by_status", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.rpc("dashboard_top_products", { p_from: range.from, p_to: range.to, p_limit: 5 }),
]);

const spendRows = spendTrend ?? [];
const statusRows = ordersByStatus ?? [];
const productRows = topProducts ?? [];

const statusColors: Record<string, string> = {
  pending: CHART_COLORS.warning,
  confirmed: CHART_COLORS.mute,
  processing: CHART_COLORS.mute,
  shipped: CHART_COLORS.success,
  delivered: CHART_COLORS.success,
  cancelled: CHART_COLORS.error,
  refunded: CHART_COLORS.error,
};
---

<BaseLayout title="Your orders — Inventory">
  <PublicHeader backHref="/account" backLabel="Account" />

  <main id="main-content" class="max-w-[1440px] mx-auto px-lg py-xl">
    <h1 class="text-2xl font-bold text-ink">My orders</h1>

    <div class="mt-md flex flex-wrap gap-xxs">
      {
        tabs.map((t) => (
          <a
            href={`/account/orders?tab=${t.key}`}
            class={`px-md py-xs text-sm rounded-md ${tab === t.key ? "bg-surface-soft font-bold text-ink" : "text-muted hover:text-ink"}`}
          >
            {t.label} <span class="text-muted">{t.count}</span>
          </a>
        ))
      }
    </div>

    {
      visibleOrders.length > 0 ? (
        <div class="mt-md overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-hairline text-left text-muted uppercase text-xs tracking-[0.5px]">
                <th class="py-xs pr-md">Order</th>
                <th class="py-xs pr-md">Date</th>
                <th class="py-xs pr-md">Total</th>
                <th class="py-xs pr-md">Status</th>
                <th class="py-xs" />
              </tr>
            </thead>
            <tbody>
              {visibleOrders.map((o) => (
                <tr class="border-b border-hairline">
                  <td class="py-sm pr-md text-ink font-bold">{o.id.slice(0, 8)}</td>
                  <td class="py-sm pr-md text-body">{new Date(o.created_at).toLocaleDateString()}</td>
                  <td class="py-sm pr-md text-body">{formatCurrency(o.total)}</td>
                  <td class="py-sm pr-md">
                    <OrderStatusBadge status={o.status} />
                  </td>
                  <td class="py-sm">
                    <a href={`/account/orders/${o.id}`} class="text-primary font-bold">
                      View
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <EmptyState class="mt-lg" title="No orders" message="Your orders will appear here once you check out." />
      )
    }

    <Card class="mt-lg flex items-center gap-md flex-wrap">
      <div class="flex-grow">
        <h2 class="text-sm font-bold text-ink">Problem with an order?</h2>
        <p class="mt-xxs text-xs text-muted">Damaged, missing or wrong items — raise a support ticket and our team will get back to you.</p>
      </div>
      <a href="/account/support" class="h-10 px-md inline-flex items-center border border-hairline text-sm font-bold text-ink hover:border-hairline-strong shrink-0">
        Raise a support ticket
      </a>
    </Card>

    <Card class="mt-lg">
      <div class="flex items-center justify-between flex-wrap gap-md">
        <h2 class="text-lg font-bold text-ink">My analytics</h2>
        <DateRangeFilter current={range.preset} url={url} pathname="/account/orders" />
      </div>
      <p class="mt-xs text-xs text-muted">{range.label}</p>

      <div class="mt-md grid grid-cols-1 gap-lg">
        <div>
          <h3 class="text-sm font-bold text-ink">Spend over time</h3>
          <div class="mt-sm">
            {
              spendRows.length > 0 ? (
                <ChartCanvas
                  id="orders-spend-trend"
                  type="line"
                  height={260}
                  data={{
                    labels: spendRows.map((r) => r.day),
                    datasets: [
                      {
                        label: "Spend",
                        data: spendRows.map((r) => Number(r.revenue)),
                        borderColor: CHART_COLORS.ink,
                        backgroundColor: "rgba(17,17,17,0.06)",
                        fill: true,
                      },
                    ],
                  }}
                  options={{ plugins: { legend: { display: false } } }}
                />
              ) : (
                <EmptyState title="No orders in this range" message="Try another date range." />
              )
            }
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold text-ink">My orders by status</h3>
          <div class="mt-sm">
            {
              statusRows.length > 0 ? (
                <ChartCanvas
                  id="orders-status"
                  type="bar"
                  height={260}
                  data={{
                    labels: statusRows.map((r) => r.status),
                    datasets: [
                      {
                        label: "Orders",
                        data: statusRows.map((r) => Number(r.order_count)),
                        backgroundColor: statusRows.map((r) => statusColors[r.status] ?? CHART_COLORS.mute),
                      },
                    ],
                  }}
                  options={{ plugins: { legend: { display: false } } }}
                />
              ) : (
                <EmptyState title="No orders in this range" message="Try another date range." />
              )
            }
          </div>
        </div>

        <div>
          <h3 class="text-sm font-bold text-ink">My top purchased products</h3>
          <div class="mt-sm">
            {
              productRows.length > 0 ? (
                <ChartCanvas
                  id="orders-top-products"
                  type="bar"
                  height={260}
                  data={{
                    labels: productRows.map((r) => r.name),
                    datasets: [
                      {
                        label: "Units",
                        data: productRows.map((r) => Number(r.units_sold)),
                        backgroundColor: CHART_COLORS.ink,
                      },
                    ],
                  }}
                  options={{ indexAxis: "y", plugins: { legend: { display: false } } }}
                />
              ) : (
                <EmptyState title="No purchases in this range" message="Try another date range." />
              )
            }
          </div>
        </div>
      </div>
    </Card>
  </main>
</BaseLayout>
