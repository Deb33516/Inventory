    display: flex;
    flex-direction: column;
  }
  .sup__ticket-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 0;
    border-top: 1px solid var(--cp-border);
    text-decoration: none;
    color: var(--cp-fg);
  }
  .sup__ticket-body {
    flex-grow: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sup__ticket-top {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sup__ticket-id {
    font-size: 12px;
    font-weight: 600;
    color: var(--cp-muted-fg);
  }
  .sup__ticket-title {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sup__ticket-meta {
    font-size: 12px;
    color: var(--cp-muted-fg);
  }
  .sup__ticket-chevron {
    flex-shrink: 0;
    color: var(--cp-muted-fg);
  }
  .sup__empty {
    margin: 0;
    padding: 24px 0;
    font-size: 13px;
    color: var(--cp-muted-fg);
    text-align: center;
  }

  .sup__pill {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sup__pill--outline {
    border: 1px solid var(--cp-input);
    color: var(--cp-fg);
  }
  .sup__pill--warn {
    background: var(--cp-warn-bg);
    color: var(--cp-warn-fg);
  }
  .sup__pill--info {
    background: var(--cp-info-bg);
    color: var(--cp-info-fg);
  }
  .sup__pill--success {
    background: var(--cp-success-bg);
    color: var(--cp-success-fg);
  }
  .sup__pill--muted {
    background: var(--cp-muted);
    color: var(--cp-muted-fg);
  }

  .sup__steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sup__step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .sup__step-num {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--cp-muted);
    font-size: 12px;
    font-weight: 600;
    color: var(--cp-fg2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sup__step-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sup__step-title {
    font-size: 14px;
    font-weight: 500;
  }
  .sup__step-text {
    font-size: 13px;
    color: var(--cp-muted-fg);
  }

  .sup__form {
    flex-grow: 1;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 24px;
    border: 1px solid var(--cp-border);
    border-radius: 12px;
    background: var(--cp-card);
    box-shadow: var(--cp-shadow);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .sup__form-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sup__form-head h2 {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .sup__form-head span {
    font-size: 13px;
    color: var(--cp-muted-fg);
  }
  .sup__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .sup__field span {
    font-size: 13px;
    font-weight: 500;
  }
  .sup__field input,
  .sup__field textarea {
    box-sizing: border-box;
    padding: 0 12px;
    border: 1px solid var(--cp-input);
    border-radius: 8px;
    background: var(--cp-card);
    font: inherit;
    font-size: 14px;
    color: var(--cp-fg);
  }
  .sup__field input {
    height: 36px;
  }
  .sup__field textarea {
    padding-top: 10px;
    padding-bottom: 10px;
    line-height: 1.5;
    resize: none;
  }
  .sup__form-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--cp-border);
    flex-wrap: wrap;
  }
  .sup__form-note {
    flex-grow: 1;
    font-size: 12px;
    color: var(--cp-muted-fg);
  }
  .sup__cancel-btn {
    height: 36px;
    padding: 0 14px;
    box-sizing: border-box;
    border-radius: 8px;
    border: 1px solid var(--cp-input);
    background: var(--cp-card);
    color: var(--cp-fg);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .sup__submit-btn {
    height: 36px;
    padding: 0 16px;
    box-sizing: border-box;
    border-radius: 8px;
    border: 0;
    background: var(--cp-primary);
    color: var(--cp-primary-fg);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }
  .sup__submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .sup__form-message {
    margin: 0;
    min-height: 16px;
    font-size: 13px;
    color: var(--cp-error-fg);
  }
</style>

<script>
  const cpRoot = document.getElementById("cp-root");
  const THEME_KEY = "landing-theme";

  function applyCpTheme(theme: "light" | "dark") {
    if (!cpRoot) return;
    if (theme === "dark") {
      cpRoot.setAttribute("data-theme", "dark");
    } else {
      cpRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("cp-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedCpTheme: string | null = null;
  try {
    storedCpTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedCpTheme === "dark") applyCpTheme("dark");

  document.getElementById("cp-theme-toggle")?.addEventListener("click", () => {
    applyCpTheme(cpRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#create-ticket-form")!;
  const messageEl = document.querySelector<HTMLParagraphElement>("#form-message")!;
  const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    button.disabled = true;
    messageEl.textContent = "";

    const { data, error } = await actions.createSupportTicket(new FormData(form));

    if (error) {
      button.disabled = false;
      messageEl.textContent = error.message;
      return;
    }

    window.location.href = `/account/support/${data.id}`;
  });
</script>
