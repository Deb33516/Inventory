<script>
  const cpRoot = document.getElementById("cp-root");
  const THEME_KEY = "landing-theme";

  function applyCpTheme(theme: "light" | "dark") {
    if (!cpRoot) return;
    if (theme === "dark") {
      cpRoot.setAttribute("data-theme", "dark");
    } else {
      cpRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("cp-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedCpTheme: string | null = null;
  try {
    storedCpTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedCpTheme === "dark") applyCpTheme("dark");

  document.getElementById("cp-theme-toggle")?.addEventListener("click", () => {
    applyCpTheme(cpRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  import { getCart } from "../../lib/cart";

  const cartCountEl = document.querySelector<HTMLSpanElement>("#cp-cart-count");
  if (cartCountEl) {
    const render = () => {
      cartCountEl.textContent = String(getCart().reduce((sum, i) => sum + i.quantity, 0));
    };
    render();
    window.addEventListener("cart-updated", render);
  }
</script>
