                  </div>
                  {customerGrowthChart ? (
                    <svg width="100%" height="200" viewBox={`0 0 ${CHART_W} ${CHART_H + 20}`} role="img" aria-label={`New customers, ${range.label}, total ${customerStats?.newInRange ?? 0}`}>
                      <path d={customerGrowthChart.areaPath} fill="var(--sd-accent)" fill-opacity="0.1" />
                      <polyline points={customerGrowthChart.points.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ")} fill="none" stroke="var(--sd-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                      {customerGrowthChart.labels.map((l) => (
                        <text x={l.x} y={CHART_H + 16} text-anchor="middle" font-size="11" fill="var(--sd-muted-fg)">{l.label}</text>
                      ))}
                    </svg>
                  ) : (
                    <p class="rp__empty">Not enough real data yet to show a trend for this period.</p>
                  )}
                </section>
              </Fragment>
            )}
          </div>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

