<script>
  import { actions } from "astro:actions";

  // --- Invite panel toggle + real inviteStaff submit ---
  const inviteToggle = document.querySelector<HTMLButtonElement>("#tm-invite-toggle");
  const invitePanel = document.querySelector<HTMLElement>("#tm-invite-panel");
  const inviteCancel = document.querySelector<HTMLButtonElement>("#tm-invite-cancel");
  const inviteForm = document.querySelector<HTMLFormElement>("#tm-invite-form");
  const inviteMessageEl = document.querySelector<HTMLParagraphElement>("#tm-invite-message");

  inviteToggle?.addEventListener("click", () => {
    if (invitePanel) invitePanel.hidden = !invitePanel.hidden;
  });
  inviteCancel?.addEventListener("click", () => {
    if (invitePanel) invitePanel.hidden = true;
    inviteForm?.reset();
  });

  inviteForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const button = inviteForm.querySelector<HTMLButtonElement>("button[type=submit]")!;
    button.disabled = true;
    if (inviteMessageEl) inviteMessageEl.textContent = "";

    const { error } = await actions.inviteStaff(new FormData(inviteForm));

    if (error) {
      button.disabled = false;
      if (inviteMessageEl) inviteMessageEl.textContent = error.message;
      return;
    }

    window.location.href = "/admin/staff?invited=1";
  });

  // --- Role/Status facet navigation ---
  document.getElementById("tm-role-filter")?.addEventListener("change", (e) => {
    const url = (e.currentTarget as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });
  document.getElementById("tm-status-filter")?.addEventListener("change", (e) => {
    const url = (e.currentTarget as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });

  // --- Per-row real staff-management controls ---
  document.querySelectorAll<HTMLDivElement>(".tm__row").forEach((row) => {
    const profileId = row.dataset.profileId!;
    const currentRole = row.dataset.currentRole;
    const messageEl = row.querySelector<HTMLParagraphElement>(".tm-row-message");
    const roleSelect = row.querySelector<HTMLSelectElement>(".tm-role-select");

    const setMessage = (text: string, isError: boolean) => {
      if (!messageEl) return;
      messageEl.textContent = text;
      messageEl.classList.toggle("is-error", isError);
      messageEl.classList.toggle("is-success", !isError);
    };

    row.querySelector<HTMLButtonElement>(".tm-toggle-active")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const nextActive = button.dataset.nextActive === "true";
      button.disabled = true;

      const { error } = await actions.updateStaffProfile({ profileId, isActive: nextActive });

      if (error) {
        button.disabled = false;
        setMessage(error.message, true);
        return;
      }
      window.location.reload();
    });

    row.querySelector<HTMLButtonElement>(".tm-save-role")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const newRole = roleSelect!.value as "sales_staff" | "inventory_staff" | "admin";
      button.disabled = true;

      const { error } = await actions.updateStaffProfile({ profileId, newRole });

      if (error) {
        button.disabled = false;
        setMessage(error.message, true);
        return;
      }
      window.location.reload();
    });

    row.querySelector<HTMLButtonElement>(".tm-request-deactivate")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const reason = window.prompt("Reason for requesting deactivation:") ?? "";
      if (!reason.trim()) return;
      button.disabled = true;

      const { error } = await actions.requestApproval({
        actionType: "deactivate_staff",
        targetTable: "profiles",
        targetId: profileId,
        reason,
      });

      if (error) {
        button.disabled = false;
        setMessage(error.message, true);
        return;
      }
      setMessage("Request submitted.", false);
      button.remove();
    });

    row.querySelector<HTMLButtonElement>(".tm-request-role")?.addEventListener("click", async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const newRole = roleSelect!.value;

      if (newRole === currentRole) {
        setMessage("Select a different role first.", true);
        return;
      }

      const reason = window.prompt("Reason for requesting this role change:") ?? "";
      if (!reason.trim()) return;
      button.disabled = true;

      const { error } = await actions.requestApproval({
        actionType: "change_role",
        targetTable: "profiles",
        targetId: profileId,
        reason,
        newRole,
      });

      if (error) {
        button.disabled = false;
        setMessage(error.message, true);
        return;
      }
      setMessage("Request submitted.", false);
      button.disabled = true;
    });
  });

  // --- Theme + sidebar chrome (same pattern as every other Admin screen) ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("sd-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is wired up
  // centrally in NavSidebar.astro — see that file's header comment.
</script>
