    align-items: center;
    justify-content: center;
  }
  .ap__product-name-col {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  .ap__product-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .ap__product-name {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ap__inactive-tag {
    flex-shrink: 0;
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--sd-muted);
    color: var(--sd-muted-fg);
    font-size: 11px;
    font-weight: 500;
  }
  .ap__product-sku {
    font-size: 12px;
    color: var(--sd-muted-fg);
  }
  .ap__col-right {
    text-align: right;
  }
  .ap__muted-cell {
    color: var(--sd-fg2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ap__price-cell {
    font-weight: 500;
  }
  .ap__on-hand {
    font-weight: 500;
  }
  .ap__pill {
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .ap__pill--in {
    background: var(--sd-success-bg);
    color: var(--sd-success-fg);
  }
  .ap__pill--low {
    background: var(--sd-warn-bg);
    color: var(--sd-warn-fg);
  }
  .ap__pill--out {
    background: var(--sd-danger-bg);
    color: var(--sd-danger-fg);
  }
  .ap__row-action {
    display: flex;
    justify-content: flex-end;
  }
  .ap__delete-btn {
    height: 30px;
    box-sizing: border-box;
    padding: 0 10px;
    border-radius: 8px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    color: var(--sd-danger-fg);
    cursor: pointer;
  }
  .ap__panel-footer {
    min-width: 980px;
    box-sizing: border-box;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    padding-top: 8px;
    padding-bottom: 8px;
    font-size: 13px;
    color: var(--sd-muted-fg);
  }
  .ap__panel-footer-count {
    line-height: 1.4;
  }
  .ap__row-message {
    margin: 0;
    font-size: 13px;
    min-height: 0;
  }

  .ap__empty {
    padding: 48px 24px;
    text-align: center;
    border: 1px solid var(--sd-border);
    border-radius: 12px;
    background: var(--sd-card);
  }
  .ap__empty-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
  }
  .ap__empty-body {
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--sd-muted-fg);
  }
</style>

<script>
  import { actions } from "astro:actions";

  // Status/Supplier filters — each <option>'s value is already the full
  // real, server-built target URL (see buildUrl() in the frontmatter),
  // same real pattern already established by /inventory/products.
  document.getElementById("ap-status-filter")?.addEventListener("change", (e) => {
    const url = (e.currentTarget as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });
  document.getElementById("ap-supplier-filter")?.addEventListener("change", (e) => {
    const url = (e.currentTarget as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });

  // --- Real per-row delete / request-deletion — see DELETE SCOPE in the
  // header comment. Exactly one of the two data-action variants is ever
  // rendered per row (server-decided by the real viewer role), so this
  // single listener handles both real, already-authorized paths.
  const messageEl = document.getElementById("ap-row-message");
  document.querySelectorAll<HTMLButtonElement>(".ap__delete-btn").forEach((button) => {
    button.addEventListener("click", async () => {
      const productId = button.dataset.productId!;
      const productName = button.dataset.productName ?? "this product";
      const action = button.dataset.action;
      if (messageEl) messageEl.textContent = "";

      if (action === "delete-direct") {
        if (!window.confirm(`Delete "${productName}"? This cannot be undone.`)) return;
        button.disabled = true;
        const { error } = await actions.deleteProduct({ productId });
        if (error) {
          button.disabled = false;
          if (messageEl) messageEl.textContent = error.message;
          return;
        }
        window.location.reload();
        return;
      }

      // delete-request (admin)
      const reason = window.prompt(`Reason for requesting deletion of "${productName}":`) ?? "";
      if (!reason.trim()) return;
      button.disabled = true;
      const { error } = await actions.requestApproval({
        actionType: "delete_product",
        targetTable: "products",
        targetId: productId,
        reason,
      });
      if (error) {
        button.disabled = false;
        if (messageEl) messageEl.textContent = error.message;
        return;
      }
      if (messageEl) messageEl.textContent = "Deletion request submitted.";
      button.textContent = "Requested";
      button.disabled = true;
    });
  });

  // --- Theme + sidebar chrome (same pattern as every other Admin screen) ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("sd-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is wired up
  // centrally in NavSidebar.astro — see that file's header comment.
</script>
