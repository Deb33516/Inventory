---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/catalog/EmptyState.astro";
import KpiCard from "../../components/dashboard/KpiCard.astro";
import ChartCanvas from "../../components/dashboard/ChartCanvas.astro";
import DateRangeFilter from "../../components/dashboard/DateRangeFilter.astro";
import { resolveDashboardRange } from "../../lib/dashboardRange";
import AppShell from "../../components/layout/AppShell.astro";
import Card from "../../components/ui/Card.astro";
import { CHART_COLORS } from "../../lib/chartTheme";

const url = Astro.url;
const range = resolveDashboardRange(url.searchParams.get("range"));

const isSuperAdmin = Astro.locals.role === "super_admin";

const [
  { data: revenueTrend },
  { data: ordersByStatus },
  { data: topProducts },
  { data: movementSummary },
  { data: customerGrowth },
  { data: inventoryValueRow },
  { data: customerMetricsRows },
  { count: activeProductCount },
  { data: inventoryRows },
] = await Promise.all([
  Astro.locals.supabase.rpc("dashboard_revenue_trend", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.rpc("dashboard_orders_by_status", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.rpc("dashboard_top_products", { p_from: range.from, p_to: range.to, p_limit: 5 }),
  Astro.locals.supabase.rpc("dashboard_inventory_movement_summary", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.rpc("dashboard_customer_growth", { p_from: range.from, p_to: range.to }),
  Astro.locals.supabase.from("inventory_value_summary").select("inventory_value").maybeSingle(),
  Astro.locals.supabase.from("customer_metrics").select("order_count"),
  Astro.locals.supabase.from("products").select("id", { count: "exact", head: true }).eq("is_active", true),
  Astro.locals.supabase
    .from("inventory")
    .select("quantity_on_hand, reorder_level, products!inner(is_active)")
    .eq("products.is_active", true),
]);

let pendingApprovalCount = 0;
let auditLogCount = 0;
if (isSuperAdmin) {
  const [{ count: approvals }, { count: audits }] = await Promise.all([
    Astro.locals.supabase.from("approval_requests").select("id", { count: "exact", head: true }),
    Astro.locals.supabase.from("audit_logs").select("id", { count: "exact", head: true }),
  ]);
  pendingApprovalCount = approvals ?? 0;
  auditLogCount = audits ?? 0;
}

const revenueRows = revenueTrend ?? [];
const statusRows = ordersByStatus ?? [];
const productRows = topProducts ?? [];
const movementRows = movementSummary ?? [];
const growthRows = customerGrowth ?? [];

const totalRevenue = revenueRows.reduce((sum, r) => sum + Number(r.revenue), 0);
const totalOrders = revenueRows.reduce((sum, r) => sum + Number(r.order_count), 0);
const aov = totalOrders > 0 ? totalRevenue / totalOrders : null;
const newCustomers = growthRows.reduce((sum, r) => sum + Number(r.new_customers), 0);

const inventoryValue = Number(inventoryValueRow?.inventory_value ?? 0);
const totalCustomers = (customerMetricsRows ?? []).length;
const lowStockCount = (inventoryRows ?? []).filter(
  (r) => r.quantity_on_hand > 0 && r.quantity_on_hand <= r.reorder_level
).length;

const formatCurrency = (value: number) =>
  new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(value);

const statusColors: Record<string, string> = {
  pending: CHART_COLORS.warning,
  confirmed: CHART_COLORS.mute,
  processing: CHART_COLORS.mute,
  shipped: CHART_COLORS.success,
  delivered: CHART_COLORS.success,
  cancelled: CHART_COLORS.error,
  refunded: CHART_COLORS.error,
};

const movementColors: Record<string, string> = {
  restock: CHART_COLORS.success,
  sale: CHART_COLORS.ink,
  adjustment: CHART_COLORS.mute,
  damaged: CHART_COLORS.error,
  return: CHART_COLORS.warning,
};
---

<BaseLayout title="Admin dashboard">
  <AppShell active="dashboard">
    <div class="flex items-center justify-between flex-wrap gap-md">
      <div class="flex items-center gap-lg flex-wrap">
        <h1 class="text-2xl font-bold text-ink">Dashboard</h1>
        <nav aria-label="Admin sections" class="flex items-center gap-md text-sm">
          <a href="/admin/staff" class="text-primary font-bold hover:underline">Staff</a>
          <a href="/admin/approvals" class="text-primary font-bold hover:underline">Approvals</a>
        </nav>
      </div>
      <DateRangeFilter current={range.preset} url={url} pathname="/admin" />
    </div>
    <p class="mt-xs text-xs text-muted">{range.label}</p>

    <div class="mt-lg grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg">
      <KpiCard label="Revenue" value={formatCurrency(totalRevenue)} />
      <KpiCard label="Orders" value={String(totalOrders)} />
      <KpiCard label="Average order value" value={aov !== null ? formatCurrency(aov) : "—"} />
      <KpiCard label="New customers" value={String(newCustomers)} />
      <KpiCard label="Inventory value" value={formatCurrency(inventoryValue)} sublabel="at retail price · current" />
      <KpiCard href="/inventory/stock?status=low" label="Low stock" value={String(lowStockCount)} tone="warning" />
    </div>

    <div class="mt-lg grid grid-cols-1 lg:grid-cols-2 gap-lg">
      <Card>
        <h2 class="text-sm font-bold text-ink">Revenue trend</h2>
        <div class="mt-sm">
          {
            revenueRows.length > 0 ? (
              <ChartCanvas
                id="admin-revenue-trend"
                type="line"
                data={{
                  labels: revenueRows.map((r) => r.day),
                  datasets: [
                    {
                      label: "Revenue",
                      data: revenueRows.map((r) => Number(r.revenue)),
                      borderColor: CHART_COLORS.ink,
                      backgroundColor: "rgba(17,17,17,0.06)",
                      fill: true,
                    },
                  ],
                }}
                options={{ plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No revenue in this range" message="Place an order to see it here." />
            )
          }
        </div>
      </Card>

      <Card>
        <h2 class="text-sm font-bold text-ink">Orders by status</h2>
        <div class="mt-sm">
          {
            statusRows.length > 0 ? (
              <ChartCanvas
                id="admin-orders-status"
                type="bar"
                data={{
                  labels: statusRows.map((r) => r.status),
                  datasets: [
                    {
                      label: "Orders",
                      data: statusRows.map((r) => Number(r.order_count)),
                      backgroundColor: statusRows.map((r) => statusColors[r.status] ?? CHART_COLORS.mute),
                    },
                  ],
                }}
                options={{ plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No orders in this range" message="Try another date range." />
            )
          }
        </div>
      </Card>

      <Card>
        <h2 class="text-sm font-bold text-ink">Top products by revenue</h2>
        <div class="mt-sm">
          {
            productRows.length > 0 ? (
              <ChartCanvas
                id="admin-top-products"
                type="bar"
                data={{
                  labels: productRows.map((r) => r.name),
                  datasets: [
                    {
                      label: "Revenue",
                      data: productRows.map((r) => Number(r.revenue)),
                      backgroundColor: CHART_COLORS.ink,
                    },
                  ],
                }}
                options={{ indexAxis: "y", plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No product sales in this range" message="Try another date range." />
            )
          }
        </div>
      </Card>

      <Card>
        <h2 class="text-sm font-bold text-ink">Inventory movements</h2>
        <div class="mt-sm">
          {
            movementRows.length > 0 ? (
              <ChartCanvas
                id="admin-movements"
                type="bar"
                data={{
                  labels: movementRows.map((r) => r.movement_type),
                  datasets: [
                    {
                      label: "Units",
                      data: movementRows.map((r) => Number(r.total_quantity)),
                      backgroundColor: movementRows.map((r) => movementColors[r.movement_type] ?? CHART_COLORS.mute),
                    },
                  ],
                }}
                options={{ plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No inventory movements in this range" message="Try another date range." />
            )
          }
        </div>
      </Card>

      <Card class="lg:col-span-2">
        <h2 class="text-sm font-bold text-ink">Customer growth</h2>
        <div class="mt-sm">
          {
            growthRows.length > 0 ? (
              <ChartCanvas
                id="admin-customer-growth"
                type="bar"
                data={{
                  labels: growthRows.map((r) => r.day),
                  datasets: [
                    {
                      label: "New customers",
                      data: growthRows.map((r) => Number(r.new_customers)),
                      backgroundColor: CHART_COLORS.ink,
                    },
                  ],
                }}
                options={{ plugins: { legend: { display: false } } }}
              />
            ) : (
              <EmptyState title="No new customers in this range" message="Try another date range." />
            )
          }
        </div>
      </Card>
    </div>

    {
      isSuperAdmin && (
        <div class="mt-xl">
          <h2 class="text-lg font-bold text-ink">System</h2>
          <p class="mt-xs text-xs text-muted">Visible only to super admin.</p>
          <div class="mt-sm grid grid-cols-1 sm:grid-cols-2 gap-lg">
            <KpiCard
              label="Pending approvals"
              value={String(pendingApprovalCount)}
              sublabel={
                pendingApprovalCount === 0
                  ? "Approval workflow not yet implemented — planned for a future phase."
                  : undefined
              }
            />
            <KpiCard
              label="Audit log entries"
              value={String(auditLogCount)}
              sublabel={auditLogCount === 0 ? "No audit activity recorded yet." : undefined}
            />
          </div>
        </div>
      )
    }
  </AppShell>
</BaseLayout>
