<script>
  import { actions } from "astro:actions";

  interface Product {
    id: string;
    sku: string;
    name: string;
    qty: number;
    stockTone: "in" | "low" | "out";
  }

  const dataEl = document.getElementById("st-adjust-data") as HTMLElement;
  const products = JSON.parse(dataEl.dataset.products!) as Product[];
  const STOCK_LABEL: Record<string, string> = { in: "In stock", low: "Low stock", out: "Out of stock" };

  let selectedProduct: Product | null = null;
  let selectedReason: string | null = null;

  const panel = document.getElementById("st-adjust-panel") as HTMLElement;
  const backdrop = document.getElementById("st-adjust-backdrop") as HTMLElement;
  const openBtn = document.getElementById("st-open-adjust")!;
  const closeBtn = document.getElementById("st-close-adjust")!;

  function openPanel(preselect?: Product) {
    panel.hidden = false;
    backdrop.hidden = false;
    if (preselect) selectProduct(preselect);
  }
  function closePanel() {
    panel.hidden = true;
    backdrop.hidden = true;
  }
  openBtn.addEventListener("click", () => openPanel());
  closeBtn.addEventListener("click", closePanel);
  backdrop.addEventListener("click", closePanel);

  document.querySelectorAll<HTMLButtonElement>(".st__adjust-icon-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const p = products.find((pr) => pr.id === btn.dataset.productId);
      if (p) openPanel(p);
    });
  });

  // --- Product search-to-select (identical pattern to /inventory/adjustments) ---
  const productSearch = document.querySelector<HTMLInputElement>("#st-adj-search")!;
  const productResults = document.querySelector<HTMLDivElement>("#st-adj-results")!;
  const selectedBox = document.querySelector<HTMLDivElement>("#st-adj-selected")!;
  const selectedNameEl = document.querySelector<HTMLSpanElement>("#st-adj-selected-name")!;
  const clearProductBtn = document.querySelector<HTMLButtonElement>("#st-adj-clear")!;
  const currentQtyEl = document.querySelector<HTMLDivElement>("#st-adj-current-qty")!;

  function renderProductResults(filter: string) {
    const needle = filter.trim().toLowerCase();
    if (!needle) {
      productResults.hidden = true;
      productResults.innerHTML = "";
      return;
    }
    const matches = products.filter((p) => p.name.toLowerCase().includes(needle) || p.sku.toLowerCase().includes(needle)).slice(0, 20);
    productResults.innerHTML = "";
    if (matches.length === 0) {
      const empty = document.createElement("p");
      empty.className = "st__picker-empty";
      empty.textContent = "No products found.";
      productResults.appendChild(empty);
    } else {
      matches.forEach((p) => {
        const row = document.createElement("button");
        row.type = "button";
        row.className = "st__picker-row";
        row.setAttribute("role", "option");

        const sub = document.createElement("span");
        sub.className = "st__picker-row-sub";
        const nameEl = document.createElement("span");
        nameEl.className = "st__picker-row-name";
        nameEl.textContent = p.name;
        const metaEl = document.createElement("span");
        metaEl.className = "st__picker-row-meta";
        metaEl.append(p.sku);
        const pill = document.createElement("span");
        pill.className = `st__stock-pill st__stock-pill--${p.stockTone}`;
        pill.textContent = p.stockTone === "out" ? STOCK_LABEL.out : `${STOCK_LABEL[p.stockTone]} ${p.qty}`;
        metaEl.appendChild(pill);
        sub.appendChild(nameEl);
        sub.appendChild(metaEl);
        row.appendChild(sub);

        row.addEventListener("click", () => {
          selectProduct(p);
          productSearch.value = "";
          productResults.hidden = true;
        });
        productResults.appendChild(row);
      });
    }
    productResults.hidden = false;
  }
  productSearch.addEventListener("input", () => renderProductResults(productSearch.value));
  document.addEventListener("click", (e) => {
    if (!productResults.hidden && !productResults.contains(e.target as Node) && e.target !== productSearch) {
      productResults.hidden = true;
    }
  });

  function selectProduct(p: Product) {
    selectedProduct = p;
    selectedNameEl.textContent = `${p.name} · ${p.sku}`;
    selectedBox.hidden = false;
    productSearch.hidden = true;
    currentQtyEl.textContent = String(p.qty);
    updatePreview();
    updateSubmitState();
  }
  clearProductBtn.addEventListener("click", () => {
    selectedProduct = null;
    selectedBox.hidden = true;
    productSearch.hidden = false;
    productSearch.value = "";
    currentQtyEl.textContent = "—";
    updatePreview();
    updateSubmitState();
  });

  // --- Reason chips ---
  const reasonButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".st__reason-chip"));
  const qtyInput = document.querySelector<HTMLInputElement>("#st-adj-qty")!;

  reasonButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const reason = btn.dataset.reason!;
      selectedReason = reason;
      reasonButtons.forEach((b) => b.setAttribute("aria-checked", String(b === btn)));

      const noteEl = document.querySelector<HTMLTextAreaElement>("#st-adj-note")!;
      if (!noteEl.value.trim()) noteEl.value = reason;

      if (reason === "Damaged") {
        const n = parseInt(qtyInput.value, 10);
        if (Number.isFinite(n) && n > 0) qtyInput.value = String(-n);
        if (!qtyInput.value || qtyInput.value === "0") qtyInput.value = "-1";
      }
      updateQtyStyle();
      updatePreview();
      updateSubmitState();
    });
  });

  function currentQtyValue(): number {
    const n = parseInt(qtyInput.value, 10);
    return Number.isFinite(n) ? n : 0;
  }
  function setQty(n: number) {
    qtyInput.value = n === 0 ? "" : String(n);
    updateQtyStyle();
    updatePreview();
    updateSubmitState();
  }
  document.querySelector<HTMLButtonElement>("#st-adj-dec")!.addEventListener("click", () => {
    let next = currentQtyValue() - 1;
    if (selectedReason === "Damaged" && next >= 0) next = -1;
    setQty(next);
  });
  document.querySelector<HTMLButtonElement>("#st-adj-inc")!.addEventListener("click", () => {
    let next = currentQtyValue() + 1;
    if (selectedReason === "Damaged" && next >= 0) next = -1;
    setQty(next);
  });
  qtyInput.addEventListener("input", () => {
    updateQtyStyle();
    updatePreview();
    updateSubmitState();
  });

  function updateQtyStyle() {
    const n = currentQtyValue();
    qtyInput.classList.toggle("is-negative", n < 0);
    qtyInput.classList.toggle("is-positive", n > 0);
  }

  const previewEl = document.querySelector<HTMLSpanElement>("#st-adj-preview")!;
  function updatePreview() {
    if (!selectedProduct) {
      previewEl.textContent = "Select a product";
      return;
    }
    const delta = currentQtyValue();
    const next = selectedProduct.qty + delta;
    previewEl.textContent = `${selectedProduct.qty} → ${next}`;
    previewEl.style.color = next < 0 ? "var(--sd-danger-fg)" : "";
  }

  const messageEl = document.querySelector<HTMLParagraphElement>("#st-adj-message")!;
  const noteInput = document.querySelector<HTMLTextAreaElement>("#st-adj-note")!;
  const submitBtn = document.querySelector<HTMLButtonElement>("#st-adj-submit")!;
  const cancelBtn = document.querySelector<HTMLButtonElement>("#st-adj-cancel")!;

  function updateSubmitState() {
    const delta = currentQtyValue();
    const newQty = selectedProduct ? selectedProduct.qty + delta : 0;
    submitBtn.disabled = !selectedProduct || !selectedReason || delta === 0 || newQty < 0;
  }

  function resetForm() {
    selectedProduct = null;
    selectedReason = null;
    selectedBox.hidden = true;
    productSearch.hidden = false;
    productSearch.value = "";
    currentQtyEl.textContent = "—";
    qtyInput.value = "";
    noteInput.value = "";
    reasonButtons.forEach((b) => b.setAttribute("aria-checked", "false"));
    messageEl.textContent = "";
    updateQtyStyle();
    updatePreview();
    updateSubmitState();
  }
  cancelBtn.addEventListener("click", () => {
    resetForm();
    closePanel();
  });

  submitBtn.addEventListener("click", async () => {
    messageEl.textContent = "";
    if (!selectedProduct || !selectedReason) return;

    const delta = currentQtyValue();
    if (delta === 0) {
      messageEl.textContent = "Enter a non-zero quantity change.";
      return;
    }
    const reasonText = noteInput.value.trim();
    if (!reasonText) {
      messageEl.textContent = "Enter a note describing the reason.";
      noteInput.focus();
      return;
    }
    if (selectedProduct.qty + delta < 0) {
      messageEl.textContent = "This would take stock below zero.";
      return;
    }

    const movementType = selectedReason === "Damaged" ? "damaged" : "adjustment";
    const quantity = movementType === "damaged" ? Math.abs(delta) : delta;

    submitBtn.disabled = true;
    const fd = new FormData();
    fd.set("productId", selectedProduct.id);
    fd.set("movementType", movementType);
    fd.set("quantity", String(quantity));
    fd.set("reason", reasonText);

    const { error } = await actions.recordInventoryMovement(fd);

    if (error) {
      messageEl.textContent = error.message;
      submitBtn.disabled = false;
      return;
    }

    window.location.href = "/admin/stock?updated=1";
  });

  updateQtyStyle();
  updatePreview();
  updateSubmitState();

  // --- Category/Supplier filters — each <option>'s value is already the
  // full real, server-built target URL, same pattern as Admin Products. ---
  document.getElementById("st-category-filter")?.addEventListener("change", (e) => {
    const url = (e.currentTarget as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });
  document.getElementById("st-supplier-filter")?.addEventListener("change", (e) => {
    const url = (e.currentTarget as HTMLSelectElement).value;
    if (url) window.location.href = url;
  });

  // --- Theme + sidebar chrome (same pattern as every other Admin screen) ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("sd-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is wired up
  // centrally in NavSidebar.astro — see that file's header comment.
</script>
