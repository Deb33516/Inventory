<script>
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is wired up
  // centrally in NavSidebar.astro — see that file's header comment.

  document.getElementById("aod-print-btn")?.addEventListener("click", () => window.print());

  import { actions } from "astro:actions";
  import type { OrderStatus } from "../../../lib/types";

  const container = document.querySelector<HTMLDivElement>("#order-status-actions");
  if (container) {
    const orderId = container.dataset.orderId!;
    const cancelMode = container.dataset.cancelMode;
    const messageEl = document.querySelector<HTMLParagraphElement>("#status-message")!;

    container.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.action;

        button.disabled = true;
        messageEl.textContent = "";

        if (action === "cancel" && cancelMode === "request") {
          const reason = window.prompt("Reason for requesting cancellation:") ?? "";
          if (!reason.trim()) {
            button.disabled = false;
            return;
          }

          const { error } = await actions.requestApproval({
            actionType: "cancel_paid_order",
            targetTable: "orders",
            targetId: orderId,
            reason,
          });

          if (error) {
            button.disabled = false;
            messageEl.textContent = error.message;
            return;
          }

          messageEl.textContent = "Cancellation request submitted.";
          button.remove();
          return;
        }

        let reason: string | undefined;
        if (action === "cancel") {
          reason = window.prompt("Reason for cancellation:") ?? undefined;
          if (!reason || !reason.trim()) {
            button.disabled = false;
            return;
          }
        }

        const newStatus = (action === "cancel" ? "cancelled" : button.dataset.nextStatus!) as OrderStatus;
        const { error } = await actions.updateOrderStatus({ orderId, newStatus, reason });

        if (error) {
          button.disabled = false;
          messageEl.textContent = error.message;
          return;
        }

        window.location.reload();
      });
    });
  }

  const refundControl = document.querySelector<HTMLDivElement>("#refund-control");
  const refundButton = document.querySelector<HTMLButtonElement>("#request-refund-btn");
  const refundMessageEl = document.querySelector<HTMLParagraphElement>("#refund-message");

  if (refundControl && refundButton && refundMessageEl) {
    const paymentId = refundControl.dataset.paymentId!;

    refundButton.addEventListener("click", async () => {
      const reason = window.prompt("Reason for requesting a refund:") ?? "";
      if (!reason.trim()) return;

      refundButton.disabled = true;
      refundMessageEl.textContent = "";

      const { error } = await actions.requestApproval({
        actionType: "refund_payment",
        targetTable: "payments",
        targetId: paymentId,
        reason,
      });

      if (error) {
        refundButton.disabled = false;
        refundMessageEl.textContent = error.message;
        return;
      }

      refundMessageEl.textContent = "Refund request submitted.";
      refundButton.remove();
    });
  }
</script>
