<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#tkd-update-form");
  const statusSelect = document.querySelector<HTMLSelectElement>("#tkd-status");
  const messageEl = document.querySelector<HTMLParagraphElement>("#tkd-form-message");

  async function submitUpdate() {
    if (!form || !messageEl) return;
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]");
    if (submitBtn) submitBtn.disabled = true;
    messageEl.textContent = "";
    const { error } = await actions.updateSupportTicket(new FormData(form));
    if (error) {
      if (submitBtn) submitBtn.disabled = false;
      messageEl.textContent = error.message;
      return;
    }
    const url = new URL(window.location.href);
    url.searchParams.set("updated", "1");
    window.location.href = url.toString();
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    submitUpdate();
  });

  document.getElementById("tkd-quick-resolve")?.addEventListener("click", () => {
    if (statusSelect) statusSelect.value = "resolved";
    submitUpdate();
  });
  document.getElementById("tkd-quick-close")?.addEventListener("click", () => {
    if (statusSelect) statusSelect.value = "closed";
    submitUpdate();
  });

  // --- Theme + sidebar chrome (same pattern as every other Admin screen) ---
  const sdRoot = document.getElementById("sd-root");
  const THEME_KEY = "landing-theme";

  function applySdTheme(theme: "light" | "dark") {
    if (!sdRoot) return;
    if (theme === "dark") {
      sdRoot.setAttribute("data-theme", "dark");
    } else {
      sdRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("sd-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedSdTheme: string | null = null;
  try {
    storedSdTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedSdTheme === "dark") applySdTheme("dark");

  document.getElementById("sd-theme-toggle")?.addEventListener("click", () => {
    applySdTheme(sdRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  // Sidebar toggle (desktop collapse + mobile drawer) is wired up
  // centrally in NavSidebar.astro — see that file's header comment.
</script>
