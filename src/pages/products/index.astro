  }
  .shop__empty-body {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--cp-muted-fg);
  }
</style>

<script>
  const cpRoot = document.getElementById("cp-root");
  const THEME_KEY = "landing-theme";

  function applyCpTheme(theme: "light" | "dark") {
    if (!cpRoot) return;
    if (theme === "dark") {
      cpRoot.setAttribute("data-theme", "dark");
    } else {
      cpRoot.removeAttribute("data-theme");
    }
    document
      .getElementById("cp-theme-toggle")
      ?.setAttribute("aria-label", theme === "dark" ? "Switch to light mode" : "Switch to dark mode");
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // ignore — private browsing / storage disabled
    }
  }

  let storedCpTheme: string | null = null;
  try {
    storedCpTheme = localStorage.getItem(THEME_KEY);
  } catch {
    // ignore
  }
  if (storedCpTheme === "dark") applyCpTheme("dark");

  document.getElementById("cp-theme-toggle")?.addEventListener("click", () => {
    applyCpTheme(cpRoot?.getAttribute("data-theme") === "dark" ? "light" : "dark");
  });

  import { addToCart } from "../../lib/cart";

  document.getElementById("shop-sort-select")?.addEventListener("change", (event) => {
    window.location.href = (event.target as HTMLSelectElement).value;
  });

  document.querySelectorAll<HTMLElement>("[data-stepper]").forEach((stepper) => {
    const valueEl = stepper.querySelector<HTMLSpanElement>("[data-qty]")!;
    stepper.querySelector("[data-dec]")?.addEventListener("click", () => {
      const next = Math.max(1, Number(valueEl.dataset.qty ?? "1") - 1);
      valueEl.dataset.qty = String(next);
      valueEl.textContent = String(next);
    });
    stepper.querySelector("[data-inc]")?.addEventListener("click", () => {
      const next = Number(valueEl.dataset.qty ?? "1") + 1;
      valueEl.dataset.qty = String(next);
      valueEl.textContent = String(next);
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-add-to-cart]").forEach((button) => {
    let hideTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", () => {
      const card = button.closest(".shop__card")!;
      const qtyEl = card.querySelector<HTMLSpanElement>("[data-qty]");
      const quantity = Number(qtyEl?.dataset.qty ?? "1");

      addToCart(
        {
          productId: button.dataset.productId!,
          sku: button.dataset.sku!,
          name: button.dataset.name!,
          price: Number(button.dataset.price),
        },
        quantity
      );

      const message = card.querySelector<HTMLParagraphElement>("[data-message]");
      if (message) {
        message.replaceChildren();
        const added = document.createElement("span");
        added.textContent = "Added";
        const viewCart = document.createElement("a");
        viewCart.href = "/cart";
        viewCart.textContent = "View cart";
        message.append(added, " ", viewCart);
      }
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => message?.replaceChildren(), 6000);

      window.dispatchEvent(new CustomEvent("cart-updated"));
    });
  });
</script>
