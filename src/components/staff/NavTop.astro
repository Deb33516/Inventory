---
// Literal recreation of the Claude Design canvas's staff top bar
// (project/NavTop.dc.html) — built for its first real consumer, the
// Contacts screen. Reuses the same --sd-* token system already
// established by NavSidebar.astro/the Sales Dashboard (not touched this
// turn). The hamburger button targets the same #sd-sidebar/#sd-sidebar-
// backdrop element ids each consuming page defines itself, matching the
// self-contained-per-page pattern already used throughout this project.
//
// Search is real only when the consuming page passes searchAction (a real
// GET form target) — otherwise it renders disabled, matching the honest-
// deferred pattern already established on the Sales Dashboard's own
// (unmodified) topbar search for pages with no real backing search.
//
// Theme toggle lives here (not as a separate fixed-position button in each
// consuming page) so every NavTop-using screen gets it in the same safe
// spot: in-flow, immediately left of search, same as the Sales Dashboard's
// own header — never `position: fixed`, which is what caused it to
// visually collide with that page's "New order" button. A page-level
// fixed toggle sits at a fixed viewport offset regardless of what else is
// in the header (e.g. this component's own real "Notifications" button at
// the far right), so any NavTop consumer that kept its own fixed button
// risked the same class of overlap. Each consuming page's own <script>
// still wires up #sd-theme-toggle exactly as before — only where the
// button lives moved, not its id or behavior.
interface Props {
  section: string;
  page: string;
  parent?: string;
  searchAction?: string;
  searchName?: string;
  searchValue?: string;
  searchPlaceholder?: string;
}

const { section, page, parent, searchAction, searchName = "search", searchValue = "", searchPlaceholder = "Search…" } = Astro.props;
---

<header class="navtop">
  <button type="button" id="sd-sidebar-toggle" class="navtop__sidebar-toggle" aria-label="Toggle sidebar" aria-expanded="false" aria-controls="sd-sidebar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM9 3v18"></path></svg>
  </button>
  <div class="navtop__divider"></div>
  <nav aria-label="Breadcrumb" class="navtop__breadcrumb">
    <span>{section}</span><span aria-hidden="true">/</span>
    {parent && <Fragment><span>{parent}</span><span aria-hidden="true">/</span></Fragment>}
    <span class="navtop__breadcrumb-current">{page}</span>
  </nav>
  <div class="navtop__spacer"></div>
  <button type="button" id="sd-theme-toggle" class="navtop__theme-toggle" aria-label="Switch to dark mode">
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
  </button>
  {
    searchAction ? (
      <form method="get" action={searchAction} class="navtop__search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-4-4"></path></svg>
        <input type="search" name={searchName} aria-label={searchPlaceholder} placeholder={searchPlaceholder} value={searchValue} />
      </form>
    ) : (
      <label class="navtop__search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-4-4"></path></svg>
        <input type="search" aria-label="Search" placeholder={searchPlaceholder} disabled />
      </label>
    )
  }
  <button type="button" aria-label="Notifications" class="navtop__notif-btn" disabled>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16v-5a6 6 0 1 1 12 0v5l2 2H4zM10 21h4"></path></svg>
  </button>
</header>

<style>
  .navtop {
    height: 64px;
    box-sizing: border-box;
    padding: 0 32px;
    border-bottom: 1px solid var(--sd-border);
    background: var(--sd-panel);
    color: var(--sd-fg);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 1023px) {
    .navtop {
      padding: 0 16px;
    }
  }
  .navtop__sidebar-toggle {
    width: 32px;
    height: 32px;
    margin-left: -8px;
    flex-shrink: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--sd-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .navtop__divider {
    width: 1px;
    height: 16px;
    background: var(--sd-border);
    flex-shrink: 0;
  }
  @media (max-width: 1023px) {
    .navtop__divider {
      display: none;
    }
  }
  .navtop__breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--sd-muted-fg);
    flex-shrink: 0;
  }
  .navtop__breadcrumb-current {
    color: var(--sd-fg);
    font-weight: 500;
  }
  .navtop__spacer {
    flex-grow: 1;
  }
  .navtop__theme-toggle {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    box-sizing: border-box;
    border-radius: 9px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    color: var(--sd-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  :global(.sd[data-theme="dark"]) .navtop .icon-sun,
  :global(.sd:not([data-theme="dark"])) .navtop .icon-moon {
    display: none;
  }
  .navtop__search {
    width: 260px;
    height: 36px;
    box-sizing: border-box;
    padding: 0 12px;
    border: 1px solid var(--sd-input);
    border-radius: 8px;
    background: var(--sd-shell);
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--sd-muted-fg);
    flex-shrink: 0;
  }
  .navtop__search input {
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    flex-grow: 1;
    color: var(--sd-fg);
  }
  .navtop__search input:disabled {
    cursor: not-allowed;
  }
  .navtop__notif-btn {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: 8px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    color: var(--sd-fg2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: not-allowed;
  }
</style>
