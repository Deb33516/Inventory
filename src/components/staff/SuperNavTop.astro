---
// Literal recreation of the Claude Design canvas's Super Admin top bar —
// like Admin.dc.html, the SuperAdmin artboard (project/SuperAdmin.dc.html)
// does NOT import the shared "NavTop" sub-component; its header markup is
// baked directly into the artboard itself, with its own search copy and
// button set. Extracted here as its own real component, same reasoning as
// AdminNavTop.astro (every future Super Admin screen needs this exact same
// header) — not a copy of AdminNavTop.astro, since the design's own search
// placeholder and button set genuinely differ.
//
// Real vs deferred, per the no-fabrication rules:
//  - Sidebar toggle + breadcrumb: real (same #sd-sidebar-toggle contract
//    every NavSidebar.astro consumer already relies on).
//  - Theme toggle: same real #sd-theme-toggle button every other screen in
//    this project adds (the design's own compiled markup has no toggle at
//    all — see AdminNavTop.astro's own comment for the full reasoning).
//  - Search ("Search users, roles, logs…", "⌘K" hint): no real cross-entity
//    search backend exists anywhere in this project — rendered disabled,
//    same precedent as AdminNavTop.astro/NavTop.astro. The "⌘K" hint is
//    dropped entirely, not just disabled.
//  - Notifications button: no real notification system exists anywhere in
//    this project (CLAUDE.md lists this as an explicitly out-of-scope
//    deferred item) — rendered disabled, unread dot dropped entirely.
//  - "All systems normal" status pill: dropped entirely, not even as a
//    disabled placeholder. No uptime/system-health monitoring exists
//    anywhere in this schema or project — this is exactly the kind of
//    fabricated "system metric" the no-fabrication rules explicitly forbid
//    inventing, and there is no honest partial version of it to show.
//  - "Invite user" button: omitted. A real `inviteStaff` action exists
//    (wired into /admin/staff this session), but its real UI lives there —
//    this turn only rebuilds the Super Admin Dashboard, not a Users screen,
//    so there is no real destination on this page for this button to
//    honestly trigger or link to (same reasoning AdminNavTop.astro already
//    used to omit its own header "+ New" button).
interface Props {
  section: string;
  page: string;
}

const { section, page } = Astro.props;
---

<header class="supertop">
  <button type="button" id="sd-sidebar-toggle" class="supertop__sidebar-toggle" aria-label="Toggle sidebar" aria-expanded="false" aria-controls="sd-sidebar">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM9 3v18"></path></svg>
  </button>
  <div class="supertop__divider"></div>
  <nav aria-label="Breadcrumb" class="supertop__breadcrumb">
    <span>{section}</span><span aria-hidden="true">/</span>
    <span class="supertop__breadcrumb-current">{page}</span>
  </nav>
  <div class="supertop__spacer"></div>
  <button type="button" id="sd-theme-toggle" class="supertop__theme-toggle" aria-label="Switch to dark mode">
    <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0-8 0M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
  </button>
  <label class="supertop__search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-4-4"></path></svg>
    <input type="search" aria-label="Search" placeholder="Search users, roles, logs…" disabled />
  </label>
  <button type="button" aria-label="Notifications" class="supertop__notif-btn" disabled>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16v-5a6 6 0 1 1 12 0v5l2 2H4zM10 21h4"></path></svg>
  </button>
</header>

<style>
  .supertop {
    height: 64px;
    box-sizing: border-box;
    padding: 0 32px;
    border-bottom: 1px solid var(--sd-border);
    background: var(--sd-panel);
    color: var(--sd-fg);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  @media (max-width: 1023px) {
    .supertop {
      padding: 0 16px;
    }
  }
  .supertop__sidebar-toggle {
    width: 32px;
    height: 32px;
    margin-left: -8px;
    flex-shrink: 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--sd-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .supertop__divider {
    width: 1px;
    height: 16px;
    background: var(--sd-border);
    flex-shrink: 0;
  }
  @media (max-width: 1023px) {
    .supertop__divider {
      display: none;
    }
  }
  .supertop__breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--sd-muted-fg);
    flex-shrink: 0;
  }
  .supertop__breadcrumb-current {
    color: var(--sd-fg);
    font-weight: 500;
  }
  .supertop__spacer {
    flex-grow: 1;
  }
  .supertop__theme-toggle {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    box-sizing: border-box;
    border-radius: 9px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    color: var(--sd-fg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  :global(.sd[data-theme="dark"]) .supertop .icon-sun,
  :global(.sd:not([data-theme="dark"])) .supertop .icon-moon {
    display: none;
  }
  .supertop__search {
    width: 300px;
    height: 38px;
    box-sizing: border-box;
    padding: 0 12px;
    border: 1px solid var(--sd-input);
    border-radius: 8px;
    background: var(--sd-shell);
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--sd-muted-fg);
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .supertop__search {
      width: 160px;
    }
  }
  .supertop__search input {
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    flex-grow: 1;
    color: var(--sd-fg);
  }
  .supertop__search input:disabled {
    cursor: not-allowed;
  }
  .supertop__notif-btn {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 8px;
    border: 1px solid var(--sd-input);
    background: var(--sd-card);
    color: var(--sd-fg2);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: not-allowed;
  }
</style>
