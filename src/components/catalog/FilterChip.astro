---
// Implements DESIGN.md's `filter-chip` / `filter-chip-active` components.
interface Props {
  href: string;
  active?: boolean;
  class?: string;
}

const { href, active = false, class: className = "" } = Astro.props;

const base =
  "inline-flex items-center whitespace-nowrap px-md py-xs text-xs font-bold uppercase tracking-[0.5px] rounded-full border transition-colors active:scale-[0.97]";
const variant = active
  ? "bg-ink text-on-dark border-ink"
  : "bg-canvas text-ink border-hairline hover:border-hairline-strong";
---

<a href={href} class={`${base} ${variant} ${className}`}>
  <slot />
</a>
