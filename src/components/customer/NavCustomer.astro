---
// Literal recreation of the Claude Design canvas's customer top nav
// (project/NavCustomer.dc.html). Real cart count (client-rendered,
// localStorage) and real avatar initials (from the session), same logic
// PublicHeader already uses — no new data source.
interface Props {
  // "Profile" intentionally matches none of the tabs below — Profile is
  // reached via the avatar link, not a NavCustomer tab (same as the
  // design's own NavCustomer.dc.html, which highlights no tab on the
  // Profile screen) — added for the Profile page's own redo turn.
  active: "Home" | "Shop" | "My orders" | "Support" | "Profile";
}

const { active } = Astro.props;

const user = Astro.locals.user;
const fullName = (user?.user_metadata?.full_name as string | undefined) ?? "";
const avatarInitials = fullName
  ? fullName
      .split(" ")
      .filter(Boolean)
      .slice(0, 2)
      .map((p) => p[0]!.toUpperCase())
      .join("")
  : (user?.email?.[0]?.toUpperCase() ?? "?");

const tabs = [
  { label: "Home", href: "/account" },
  { label: "Shop", href: "/products" },
  { label: "My orders", href: "/account/orders" },
  { label: "Support", href: "/account/support" },
];
---

<header class="navcustomer">
  <a href="/" class="navcustomer__brand">
    <span class="navcustomer__logo"><span></span></span>
    <span>Inventory</span>
  </a>

  <nav aria-label="Portal" class="navcustomer__tabs">
    {tabs.map((t) => <a href={t.href} class={t.label === active ? "is-active" : ""}>{t.label}</a>)}
  </nav>

  <div class="navcustomer__spacer"></div>

  <form action="/products" method="get" class="navcustomer__search">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0M20 20l-4-4"></path></svg>
    <input type="search" name="search" aria-label="Search products" placeholder="Search products…" />
  </form>

  <a href="/cart" aria-label="Cart" class="navcustomer__cart">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11h11l2-8H6.2M9 20a1 1 0 1 0 2 0a1 1 0 1 0-2 0M17 20a1 1 0 1 0 2 0a1 1 0 1 0-2 0"></path></svg>
    <span id="cart-count-badge" class="navcustomer__cart-badge hidden">0</span>
  </a>

  <a href="/account/profile" aria-label="My profile" class="navcustomer__avatar">{avatarInitials}</a>
</header>

<style>
  .navcustomer {
    height: 64px;
    box-sizing: border-box;
    padding: 0 24px;
    border-bottom: 1px solid var(--cp-border);
    background: var(--cp-panel);
    color: var(--cp-fg);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  @media (min-width: 1200px) {
    .navcustomer {
      padding: 0 120px;
    }
  }
  .navcustomer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    font-size: 16px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .navcustomer__logo {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--cp-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .navcustomer__logo span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid #ffffff;
  }
  .navcustomer__tabs {
    display: none;
    gap: 4px;
  }
  @media (min-width: 800px) {
    .navcustomer__tabs {
      display: flex;
    }
  }
  .navcustomer__tabs a {
    height: 34px;
    padding: 0 12px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 14px;
    color: var(--cp-muted-fg);
  }
  .navcustomer__tabs a.is-active {
    background: var(--cp-muted);
    color: var(--cp-fg);
    font-weight: 500;
  }
  .navcustomer__spacer {
    flex-grow: 1;
  }
  .navcustomer__search {
    display: none;
    width: 260px;
    height: 36px;
    box-sizing: border-box;
    padding: 0 12px;
    border: 1px solid var(--cp-input);
    border-radius: 8px;
    background: var(--cp-shell);
    align-items: center;
    gap: 8px;
    color: var(--cp-muted-fg);
  }
  @media (min-width: 1000px) {
    .navcustomer__search {
      display: flex;
    }
  }
  .navcustomer__search input {
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 14px;
    flex-grow: 1;
    color: var(--cp-fg);
  }
  .navcustomer__cart {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid var(--cp-input);
    background: var(--cp-card);
    color: var(--cp-fg2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
  }
  .navcustomer__cart-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--cp-primary);
    color: var(--cp-primary-fg);
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .navcustomer__cart-badge.hidden {
    display: none;
  }
  .navcustomer__avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cp-info-bg);
    color: var(--cp-info-fg);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>

<script>
  import { getCart } from "../../lib/cart";

  const badge = document.querySelector<HTMLSpanElement>("#cart-count-badge");
  if (badge) {
    const render = () => {
      const count = getCart().reduce((sum, i) => sum + i.quantity, 0);
      badge.textContent = String(count);
      badge.classList.toggle("hidden", count === 0);
    };
    render();
    window.addEventListener("cart-updated", render);
  }
</script>
