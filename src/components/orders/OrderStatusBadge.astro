---
import Badge from "../ui/Badge.astro";

interface Props {
  status: string;
  class?: string;
}

const { status, class: className = "" } = Astro.props;

const tones: Record<string, "success" | "warning" | "error" | "neutral"> = {
  pending: "warning",
  confirmed: "neutral",
  processing: "neutral",
  shipped: "success",
  delivered: "success",
  cancelled: "error",
  refunded: "error",
};
---

<Badge tone={tones[status] ?? "neutral"} class={`capitalize ${className}`}>{status}</Badge>
