---
interface Props {
  orderId: string;
  status: string;
  viewerRole: "staff" | "customer";
}

const { orderId, status, viewerRole } = Astro.props;

const nextStatus: Record<string, string> = {
  pending: "confirmed",
  confirmed: "processing",
  processing: "shipped",
  shipped: "delivered",
};

const canAdvance = viewerRole === "staff" && status in nextStatus;
const canCancel =
  (viewerRole === "staff" && ["pending", "confirmed", "processing"].includes(status)) ||
  (viewerRole === "customer" && status === "pending");
---

{
  (canAdvance || canCancel) && (
    <div id="order-status-actions" data-order-id={orderId} class="flex flex-wrap items-center gap-sm">
      {canAdvance && (
        <button
          type="button"
          data-action="advance"
          data-next-status={nextStatus[status]}
          class="h-12 px-lg bg-primary text-on-primary font-bold text-sm capitalize"
        >
          Mark as {nextStatus[status]}
        </button>
      )}
      {canCancel && (
        <button
          type="button"
          data-action="cancel"
          class="h-12 px-lg bg-canvas text-error border border-error font-bold text-sm"
        >
          Cancel order
        </button>
      )}
      <p id="status-message" class="text-sm w-full" role="status" />
    </div>
  )
}

<script>
  import { actions } from "astro:actions";

  const container = document.querySelector<HTMLDivElement>("#order-status-actions");

  if (container) {
    const orderId = container.dataset.orderId!;
    const messageEl = document.querySelector<HTMLParagraphElement>("#status-message")!;

    container.querySelectorAll<HTMLButtonElement>("button[data-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        const action = button.dataset.action;
        let reason: string | undefined;

        if (action === "cancel") {
          reason = window.prompt("Reason for cancellation:") ?? undefined;
          if (!reason || !reason.trim()) return;
        }

        button.disabled = true;
        messageEl.textContent = "";
        messageEl.classList.remove("text-error", "text-success");

        const newStatus = action === "cancel" ? "cancelled" : button.dataset.nextStatus!;

        const { error } = await actions.updateOrderStatus({ orderId, newStatus, reason });

        if (error) {
          button.disabled = false;
          messageEl.textContent = error.message;
          messageEl.classList.add("text-error");
          return;
        }

        window.location.reload();
      });
    });
  }
</script>
