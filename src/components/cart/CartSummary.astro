---
// Renders the localStorage cart as a product/qty/total table, matching the
// Claude Design canvas's Cart artboard proportions (project/PageCart.dc.html)
// as closely as a client-rendered, no-server-data component can — no stock
// pill here (cart items are plain localStorage records with no live DB
// link back to current inventory), no GST line (place_order() computes tax
// server-side today with no rate exposed to the client — see checkout.astro
// for the fuller note). Subtotal is the only real number shown pre-checkout.
---

<div id="cart-summary">
  <div id="cart-items" class="divide-y divide-hairline"></div>
  <p id="cart-empty" class="hidden text-sm text-muted py-xl text-center">Your cart is empty.</p>
  <div class="mt-md pt-md border-t border-hairline flex justify-between items-baseline">
    <span class="text-sm text-muted">Subtotal (prices before any tax computed at checkout)</span>
    <p class="text-2xl font-bold text-ink">Subtotal: <span id="cart-total">—</span></p>
  </div>
</div>

<script>
  import { getCart, updateCartQuantity, removeFromCart } from "../../lib/cart";

  const itemsEl = document.querySelector<HTMLDivElement>("#cart-items")!;
  const emptyEl = document.querySelector<HTMLParagraphElement>("#cart-empty")!;
  const totalEl = document.querySelector<HTMLSpanElement>("#cart-total")!;

  const formatCurrency = (value: number) =>
    new Intl.NumberFormat("en-IN", { style: "currency", currency: "INR", maximumFractionDigits: 2 }).format(value);

  function render() {
    const items = getCart();
    itemsEl.innerHTML = "";
    emptyEl.classList.toggle("hidden", items.length > 0);

    let total = 0;

    for (const item of items) {
      total += item.price * item.quantity;

      const row = document.createElement("div");
      row.className = "py-sm flex items-center gap-md";

      const info = document.createElement("div");
      info.className = "flex-grow min-w-0";
      const title = document.createElement("p");
      title.className = "font-bold text-ink text-sm truncate";
      title.textContent = item.name;
      const meta = document.createElement("p");
      meta.className = "text-xs text-muted";
      meta.textContent = `${item.sku} · ${formatCurrency(item.price)} each`;
      info.appendChild(title);
      info.appendChild(meta);

      const controls = document.createElement("div");
      controls.className = "flex items-center gap-md shrink-0";

      const stepper = document.createElement("div");
      stepper.className = "flex items-center h-9 border border-hairline-strong";

      const decrementBtn = document.createElement("button");
      decrementBtn.type = "button";
      decrementBtn.textContent = "−";
      decrementBtn.setAttribute("aria-label", `Decrease quantity of ${item.name}`);
      decrementBtn.className = "w-8 h-full text-ink font-bold hover:bg-surface-soft";
      decrementBtn.addEventListener("click", () => {
        updateCartQuantity(item.productId, item.quantity - 1);
        render();
        window.dispatchEvent(new CustomEvent("cart-updated"));
      });

      const qtyLabel = document.createElement("span");
      qtyLabel.textContent = String(item.quantity);
      qtyLabel.setAttribute("aria-live", "polite");
      qtyLabel.setAttribute("aria-label", `Quantity: ${item.quantity}`);
      qtyLabel.className = "w-8 text-center text-sm font-bold text-ink";

      const incrementBtn = document.createElement("button");
      incrementBtn.type = "button";
      incrementBtn.textContent = "+";
      incrementBtn.setAttribute("aria-label", `Increase quantity of ${item.name}`);
      incrementBtn.className = "w-8 h-full text-ink font-bold hover:bg-surface-soft";
      incrementBtn.addEventListener("click", () => {
        updateCartQuantity(item.productId, item.quantity + 1);
        render();
        window.dispatchEvent(new CustomEvent("cart-updated"));
      });

      stepper.appendChild(decrementBtn);
      stepper.appendChild(qtyLabel);
      stepper.appendChild(incrementBtn);

      const lineTotal = document.createElement("span");
      lineTotal.className = "w-24 text-right text-sm font-bold text-ink";
      lineTotal.textContent = formatCurrency(item.price * item.quantity);

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.textContent = "Remove";
      removeBtn.setAttribute("aria-label", `Remove ${item.name} from cart`);
      removeBtn.className = "text-error text-xs font-bold hover:underline active:opacity-70";
      removeBtn.addEventListener("click", () => {
        removeFromCart(item.productId);
        render();
        window.dispatchEvent(new CustomEvent("cart-updated"));
      });

      controls.appendChild(stepper);
      controls.appendChild(lineTotal);
      controls.appendChild(removeBtn);
      row.appendChild(info);
      row.appendChild(controls);
      itemsEl.appendChild(row);
    }

    totalEl.textContent = formatCurrency(total);
  }

  render();
  window.addEventListener("cart-updated", render);
</script>
