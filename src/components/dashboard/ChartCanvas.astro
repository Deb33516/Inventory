---
// A thin Chart.js wrapper — vanilla canvas + a scoped module script, no
// framework involved (Chart.js is a DOM/canvas library, not a UI
// framework, so this doesn't violate the no-React/Vue/Svelte rule).
//
// Deliberately NOT using the script define:vars directive here: it forces
// Astro to inline the script as a plain (non-module) tag wrapped in an
// IIFE, and a static `import` statement is a SyntaxError outside a
// module context — verified directly against this project's own
// production build output, where every other `define:vars` script that
// also does `import { actions } from "astro:actions"` (login.astro,
// ProductForm.astro, SupplierForm.astro, checkout/index.astro) compiles
// to exactly that broken shape. Instead, chart config is serialized onto
// the canvas element's `data-chart-config` attribute, and a normal, plain
// script tag (no define:vars) — which Astro/Vite DOES extract, bundle,
// and resolve "chart.js/auto" for correctly — reads it back. Astro dedupes
// this script to run once per page even though the component can appear
// many times, so it queries every matching canvas rather than assuming
// a single instance — and applies the shared chart theme (chartTheme.ts)
// exactly once per page for the same reason.
//
// The wrapper's bg-surface-soft is the "loading" treatment: it shows as a
// soft grey block until the script paints the chart a few ms after the
// page renders — no spinner/skeleton state machine needed since Astro SSR
// already resolves all the data before the page ships.
interface Props {
  id: string;
  type: "line" | "bar" | "doughnut";
  data: object;
  options?: object;
  height?: number;
  class?: string;
}

const { id, type, data, options = {}, height = 280, class: className = "" } = Astro.props;
const config = JSON.stringify({ type, data, options });
---

<div
  class={`chart-wrap relative w-full bg-surface-soft ${className}`}
  style={`--chart-height:${height}px`}
>
  <canvas id={id} data-chart-config={config}></canvas>
</div>

<style>
  /* Shorter on mobile so a chart never dominates a narrow viewport — full
     height from the sm breakpoint up. Chart.js's responsive+
     maintainAspectRatio:false (set below) redraws to fit whatever height
     this container ends up at. */
  .chart-wrap {
    height: 200px;
  }
  @media (min-width: 640px) {
    .chart-wrap {
      height: var(--chart-height);
    }
  }
</style>

<script>
  import { Chart } from "chart.js/auto";
  import { applyChartDefaults } from "../../lib/chartTheme";

  // Chart.js's real Defaults type (e.g. plugins.tooltip's concrete
  // TooltipOptions interface) doesn't structurally overlap enough with
  // ChartDefaultsLike's simplified Record<string, unknown> shape for a
  // direct cast — going through `unknown` first is TS's own suggested
  // pattern for an intentional assertion here; chartTheme.ts only ever
  // reads/Object.assigns known property names, so this is safe.
  applyChartDefaults(Chart.defaults as unknown as Parameters<typeof applyChartDefaults>[0]);

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-chart-config]").forEach((canvas) => {
    if (canvas.dataset.chartInitialized) return;
    canvas.dataset.chartInitialized = "true";

    const config = JSON.parse(canvas.dataset.chartConfig!);

    new Chart(canvas, {
      type: config.type,
      data: config.data,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        ...config.options,
      },
    });
  });
</script>
